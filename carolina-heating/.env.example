# ---- Supabase (shared across all NearU brand sites) ----
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role secret — NEVER expose to the browser, server-side only

# ---- This site's identity within the shared Supabase project ----
# Every brand's Vercel project sets its own value. Must match a row in the
# `sites` table (slug column). Also used as the folder prefix in Storage.
SITE_SLUG=carolina-heating

# Used for canonical URLs / schema.org / OpenGraph if you want to override
# what's stored in the `sites.domain` column locally (optional).
# SITE_DOMAIN=carolinaheating.com

# ---- On-demand revalidation ----
# Shared secret required by POST /api/revalidate?secret=...&path=/about-us
# Generate a random string per site (or share across all 23 — your call).
REVALIDATE_SECRET=change-me

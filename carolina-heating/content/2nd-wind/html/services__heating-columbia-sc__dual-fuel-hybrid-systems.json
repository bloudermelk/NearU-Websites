: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"63\" src=\"/images/2024/03/Daikin-logo-300x63.png\" class=\"logogrid-image\" alt=\"Daikin logo\" srcset=\"/images/2024/03/Daikin-logo-300x63.png 300w, /images/2024/03/Daikin-logo-768x162.png 768w, /images/2024/03/Daikin-logo.png 1018w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"167\" src=\"/images/2024/02/york-install-confidence-vector-logo-300x167.png\" class=\"logogrid-image\" alt=\"York logo\" srcset=\"/images/2024/02/york-install-confidence-vector-logo-300x167.png 300w, /images/2024/02/york-install-confidence-vector-logo-768x427.png 768w, /images/2024/02/york-install-confidence-vector-logo.png 900w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"53\" src=\"/images/2024/03/Honeywell-logo-300x53.png\" class=\"logogrid-image\" alt=\"Honeywell logo\" srcset=\"/images/2024/03/Honeywell-logo-300x53.png 300w, /images/2024/03/Honeywell-logo-1024x181.png 1024w, /images/2024/03/Honeywell-logo-768x136.png 768w, /images/2024/03/Honeywell-logo.png 1413w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"225\" height=\"225\" src=\"/images/2024/02/rheem.png\" class=\"logogrid-image\" alt=\"Rheem logo\" srcset=\"/images/2024/02/rheem.png 225w, /images/2024/02/rheem-150x150.png 150w\" sizes=\"(max-width: 225px) 100vw, 225px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"76\" src=\"/images/2024/06/Tempstar-logo-300x76.jpg\" class=\"logogrid-image\" alt=\"Tempstar Heating and Cooling Products logo\" srcset=\"/images/2024/06/Tempstar-logo-300x76.jpg 300w, /images/2024/06/Tempstar-logo.jpg 568w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"88\" src=\"/images/2024/03/Mitsubishi-Electric-logo-300x88.png\" class=\"logogrid-image\" alt=\"Mitsubishi Electric logo\" srcset=\"/images/2024/03/Mitsubishi-Electric-logo-300x88.png 300w, /images/2024/03/Mitsubishi-Electric-logo-768x226.png 768w, /images/2024/03/Mitsubishi-Electric-logo.png 851w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n        </ul>\n</div>\n\n            <h6 class=\"wp-block-heading has-text-align-center\" style=\"text-transform:uppercase\">\n                And Dozens More\n            </h6></div>\n\n    </div>\n</div>\n\n<div  class=\"splitter-column splitter-column--right splitter-column--center py-3 has-custom-acf-color has-background has-secondary-background-color has-text-color has-secondary-inverse-color wp-elements-5\">\n    <div class=\"splitter-column-inner splitter-column-inner--contained splitter-column-inner--padded\">\n\n    <h2 class=\"wp-block-heading mb-3\">Qualified for All Major Makes and Models</h2>\n\n    <div class=\"wp-block-group flow mb-2 has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n    <p>Our team of expert technicians is trained to handle all makes and models of major brands with precision and care. From routine maintenance to complex repairs, we ensure top-notch service for all.</p>\n\n    </div>\n\n<div  class=\"iconlist\" data-orientation=\"vertical\" data-iconsize=\"md\">\n    <ul role=\"list\">\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-check\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p>Ensure optimal efficiency of all your systems</p>\n</p>\n            </div>\n        </li>\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-check\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p>Lower your utility costs with energy efficiency</p>\n</p>\n            </div>\n        </li>\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-check\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p>Extend your system’s lifespan through regular maintenance</p>\n</p>\n            </div>\n        </li>\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-check\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p>Keep you and your family comfortable and safe during all seasons</p>\n</p>\n            </div>\n        </li>\n            </ul>\n</div>\n    </div>\n</div>\n\n</div>\n<div id=\"FAQs\" class=\"wp-block-group py-5 flow has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading has-text-align-center\">FAQs</h2>\n\n<div  class=\"accordion\" style=\"--_accordion-separator-color: \">\n            <details class=\"accordion-item\" data-custom-open=\"true\" open>\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">How does a dual fuel system decide which fuel to use?</p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p class=\"FirstParagraph\">By outdoor temperature. Above the balance point, the heat pump runs because it delivers heat at lower cost. Below it, the furnace takes over because heat pump efficiency has fallen past the crossover. The balance point is set during installation and adjusted as rates change.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Is dual fuel worth it in a climate as mild as Columbia's?</p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p class=\"FirstParagraph\">It is the climate the design suits best. The heat pump covers the majority of mild heating hours cheaply, and the furnace covers the handful of hard freezes where gas wins. Homes that already have gas service capture the benefit with one added piece of equipment at replacement time.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Can my existing furnace be paired with a new heat pump?</p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p class=\"FirstParagraph\">Often yes, if the furnace is in sound condition and the blower and controls are compatible. We evaluate the existing equipment first and tell you on video what supports the pairing and what does not.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Why is my dual fuel system running gas heat on a mild day?</p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p class=\"FirstParagraph\">Usually a balance point set too high, a thermostat misconfiguration, or a heat pump fault forcing the furnace to cover. Each is diagnosable, and running gas through mild weather quietly overspends every month it continues.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Does a dual fuel system still cool in the summer?</p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p class=\"FirstParagraph\">Yes. The heat pump half is the air conditioner, working exactly like standard cooling equipment from April through October. The furnace simply sits out the season.</p>\n                </div>\n            </div>\n        </details>    </div>\n</div>\n\n<div id=\"maintenance-financing\" class=\"container splitter splitter--uniform-height-stick-last\" style=\"--CTX-container-split-size: 0.5\">\n\n<div  class=\"splitter-column splitter-column--left splitter-column--start wp-elements-6 has-background has-primary-background-color has-text-color has-primary-inverse-color\">\n    <div class=\"splitter-column-inner splitter-column-inner--contained splitter-column-inner--padded\">\n\n<div class=\"wp-block-group flow w100 has-global-padding is-layout-constrained wp-container-core-group-is-layout-2468f3b8 wp-block-group-is-layout-constrained\"><div class=\"elevated content-fullbleed-mobile w100 border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\n<figure class=\"wp-block-image size-full has-custom-border w100\"><img decoding=\"async\" width=\"1916\" height=\"1280\" src=\"/images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-technician-retreiving-an-item-from-a-service-truck.jpg\" alt=\"A 2nd Wind Heating and Air Conditioning technician retreiving an item from a service truck\" class=\"wp-image-5698\" style=\"border-radius:0px;object-fit:cover\" srcset=\"/images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-technician-retreiving-an-item-from-a-service-truck.jpg 1916w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-technician-retreiving-an-item-from-a-service-truck-300x200.jpg 300w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-technician-retreiving-an-item-from-a-service-truck-1024x684.jpg 1024w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-technician-retreiving-an-item-from-a-service-truck-768x513.jpg 768w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-technician-retreiving-an-item-from-a-service-truck-1536x1026.jpg 1536w\" sizes=\"(max-width: 1916px) 100vw, 1916px\" /></figure>\n\n</div>\n</div>\n\n<h2 class=\"wp-block-heading mt-3 has-primary-inverse-color has-text-color has-link-color wp-elements-7\">Need a Maintenance Plan?</h2>\n\n<ul class=\"wp-block-list\">\n<li>Prevent costly repairs with regular maintenance checks</li>\n\n<li>Ensure your systems are running efficiently year-round</li>\n\n<li>Extend the lifespan of your heating and cooling units</li>\n\n<li>Minimize the risk of unexpected breakdowns and emergencies</li>\n\n<li>Improve energy efficiency and lower utility bills</li>\n\n<li>Ensure the safety and reliability of your home's systems</li>\n</ul>\n\n<a href=\"/maintenance\" data-cta-gap=\"md\" data-cta-type=\"outline\" data-cta-content=\"mixed\" data-cta-minwidth=\"true\" class=\"cta full-width-mobile\">\n    <span >Learn More</span>\n        <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronright\" /></svg>\n</a></div>\n\n</div>\n</div>\n\n<div  class=\"splitter-column splitter-column--right splitter-column--start has-background has-primary-inverse-background-color\">\n    <div class=\"splitter-column-inner splitter-column-inner--contained splitter-column-inner--padded\">\n\n<div class=\"wp-block-group flow has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\"><div class=\"elevated content-fullbleed-mobile border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\n<figure class=\"wp-block-image size-full has-custom-border\"><img decoding=\"async\" width=\"1916\" height=\"1280\" src=\"/images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-employee-working-on-a-computer-while-on-the-telephone.jpg\" alt=\"A 2nd Wind Heating and Air Conditioning employee working on a computer while on the telephone\" class=\"wp-image-5693\" style=\"border-radius:0px\" srcset=\"/images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-employee-working-on-a-computer-while-on-the-telephone.jpg 1916w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-employee-working-on-a-computer-while-on-the-telephone-300x200.jpg 300w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-employee-working-on-a-computer-while-on-the-telephone-1024x684.jpg 1024w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-employee-working-on-a-computer-while-on-the-telephone-768x513.jpg 768w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-employee-working-on-a-computer-while-on-the-telephone-1536x1026.jpg 1536w\" sizes=\"(max-width: 1916px) 100vw, 1916px\" /></figure>\n\n</div>\n</div>\n\n<h2 class=\"wp-block-heading mt-3\">Ask Us About Financing!</h2>\n\n<p class=\"mb-3 wp-block-paragraph\">Financing plans bring value and benefits to homeowners. By opting for a financing option, you can tackle necessary repairs or upgrades without draining your savings or delaying important projects. Here are some key advantages:</p>\n\n<ul class=\"mb-3 wp-block-list\">\n<li>Budget-Friendly</li>\n\n<li>Access to Quality Services</li>\n\n<li>Timely Repairs</li>\n\n<li>Flexibility</li>\n\n<li>Increase Home Value</li>\n\n<li>Emergency Protection</li>\n</ul>\n\n<p class=\"mb-3 mt-0 wp-block-paragraph\">Keep your home safe and comfortable with a finance plan. Always assess terms and interest rates to find the best one for your needs. A professional can help you make an informed decision.</p>\n\n<a href=\"/financing\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta full-width-mobile\">\n    <span >Learn More</span>\n        <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronright\" /></svg>\n</a></div>\n\n</div>\n</div>\n\n</div>        <div  class=\"google-reviews-featured container py-5 container has-background has-gray-light-background-color\">\n    <div class=\"google-reviews-featured__head\">\n        <div class=\"google-reviews-featured__head__logo\">            <svg version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\" viewBox=\"0 0 107.3 35.2\" style=\"enable-background:new 0 0 107.3 35.2;\" xml:space=\"preserve\"><title>Google</title><path fill=\"#4885ED\" d=\"M26.4,12.4H13.9v3.7h8.9c-0.4,5.2-4.8,7.4-8.9,7.4c-5.4,0-9.8-4.3-9.8-9.7c0-0.1,0-0.1,0-0.2 c0-5.6,4.4-10,9.8-10c4.2,0,6.7,2.7,6.7,2.7l2.6-2.7c0,0-3.3-3.7-9.4-3.7C6,0,0,6.5,0,13.6c0,6.9,5.6,13.7,14,13.7 c7.3,0,12.7-5,12.7-12.4C26.6,13.3,26.4,12.4,26.4,12.4L26.4,12.4z\"/><g><path id=\"A\" fill=\"#DB3236\" d=\"M36.6,9.7c-5.1,0-8.8,4-8.8,8.7c0,4.8,3.6,8.8,8.9,8.8c4.8,0,8.7-3.7,8.7-8.7 C45.4,12.7,40.9,9.7,36.6,9.7L36.6,9.7z M36.7,13.2c2.5,0,4.9,2,4.9,5.3c0,3.2-2.4,5.3-4.9,5.3c-2.8,0-5-2.2-5-5.3 C31.7,15.4,33.9,13.2,36.7,13.2L36.7,13.2z\"/></g><g><path id=\"A_00000019641008515513977120000006682861592563020936_\" fill=\"#F4C20D\" d=\"M55.8,9.7c-5.1,0-8.8,4-8.8,8.7 c0,4.8,3.6,8.8,8.9,8.8c4.8,0,8.7-3.7,8.7-8.7C64.6,12.7,60,9.7,55.8,9.7L55.8,9.7z M55.9,13.2c
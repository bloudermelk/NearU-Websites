  "html": "<article id=\"post-6559\" class=\"container post-6559 page type-page status-publish has-post-thumbnail hentry\">\n\n\t<div class=\"entry-content | container\">\n\t\t<section  class=\"container section--services-hero pt-5 services-hero\">\n\t<div class=\"section--services-hero__main\">\n\t\t<div class=\"section--services-hero__main__row\">\n\t\t\t<div class=\"section--services-hero__main__row__left\">\n                <div class=\"acf-innerblocks-container\">\n\n<div class=\"wp-block-group full-width-mobile is-vertical is-layout-flex wp-container-core-group-is-layout-2c90304e wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group h-align is-nowrap is-layout-flex wp-container-core-group-is-layout-7387b849 wp-block-group-is-layout-flex\">    <div class=\"iconblock wp-elements-1 has-background has-secondary-background-color has-text-color has-primary-inverse-color\" data-size=\"md\" data-padding=\"2\" data-display=\"inline\">\n        <svg class=\"icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-money\" /></svg>    </div>\n\n<h1 class=\"wp-block-heading has-secondary-active-color has-text-color has-link-color has-x-large-font-size wp-elements-2\">Plumbing Services Financing Options with 2nd Wind</h1>\n</div>\n\n<div class=\"wp-block-group my-3 is-layout-flex wp-block-group-is-layout-flex\">\n<p class=\"wp-block-paragraph\">At 2nd Wind Heating &amp; Air Conditioning, we know that plumbing repairs or upgrades can be unexpected expenses. That’s why we’ve partnered with <strong>Greensky</strong> and <strong>Upgrade </strong>to offer flexible financing options. Whether you’re repairing a burst pipe, replacing a water heater, or upgrading your fixtures, our financing plans help you get the service you need without financial stress. Contact us today to learn more about our financing options for plumbing services.</p>\n</div>\n\n<div class=\"wp-block-group mb-3 is-content-justification-left is-nowrap is-layout-flex wp-container-core-group-is-layout-a1b15d37 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group full-width-mobile is-vertical is-content-justification-stretch is-layout-flex wp-container-core-group-is-layout-41171c72 wp-block-group-is-layout-flex\">\n<p class=\"horizon-text full-width-mobile has-secondary-font-family wp-block-paragraph\" style=\"text-transform:uppercase\">Speak with an expert</p>\n\n<a href=\"tel:+18033921513\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"icon\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta full-width-mobile\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-phone\" /></svg><span>(803) 392-1513</span>\n</a>\n\n<p class=\"text-center has-primary-color has-text-color has-link-color has-secondary-font-family has-small-font-size wp-elements-3 wp-block-paragraph\" style=\"text-transform:uppercase\"><strong>Same day appointments available by phone</strong></p>\n</div>\n</div>\n</div>\n\n</div>\n\t\t\t</div><!-- ./left -->\n\t\t\t<div class=\"section--services-hero__main__row__right\">\n\t\t\t<div class=\"elevated content-fullbleed-mobile box-shadow-lg border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\t\t\t<figure class=\"wp-block-post-featured-image\"><img decoding=\"async\" width=\"2013\" height=\"1280\" src=\"/images/2024/03/A-woman-filling-a-glass-with-water-from-a-sinks-faucet.jpg\" class=\"attachment-post-thumbnail size-post-thumbnail wp-post-image\" alt=\"A woman filling a glass with water from a sink’s faucet\" style=\"object-fit:cover;\" srcset=\"/images/2024/03/A-woman-filling-a-glass-with-water-from-a-sinks-faucet.jpg 2013w, /images/2024/03/A-woman-filling-a-glass-with-water-from-a-sinks-faucet-300x191.jpg 300w, /images/2024/03/A-woman-filling-a-glass-with-water-from-a-sinks-faucet-1024x651.jpg 1024w, /images/2024/03/A-woman-filling-a-glass-with-water-from-a-sinks-faucet-768x488.jpg 768w, /images/2024/03/A-woman-filling-a-glass-with-water-from-a-sinks-faucet-1536x977.jpg 1536w\" sizes=\"(max-width: 1010px) 100vw, (max-width: 1440px) 50vw, 768px\" /></figure>\n\t\t\t</div>\n</div>\t\t\t</div><!-- ./right -->\n\t\t</div><!-- ./row -->\n\n</div>\n\t<div class=\"section--services-hero__main section--services-hero__main--empty has-background has-secondary-background-color\">\n\t</div><!-- ./row -->\n\n</section>\n\n<div class=\"wp-block-group container pb-5 flow has-primary-inverse-color has-secondary-background-color has-text-color has-background has-link-color wp-elements-4\">\n<div style=\"height:1rem\" aria-hidden=\"true\" class=\"wp-block-spacer d-block d-md-none\"></div>\n\n<h2 class=\"wp-block-heading has-secondary-inverse-color has-text-color has-link-color wp-elements-5\">Affordable Financing for Plumbing Solutions</h2>\n\n<p class=\"has-secondary-inverse-color has-text-color has-link-color wp-elements-6 wp-block-paragraph\">Plumbing repairs and installations are critical to keeping your home safe and functional. Costs vary depending on the service, with plumbing solutions in Columbia, SC, typically ranging from <strong>$200 to $5,000</strong>. From simple repairs to full-system upgrades, our team ensures you get quality service at competitive prices. Contact 2nd Wind Heating &amp; Air Conditioning today for a free estimate.</p>\n\n<div class=\"wp-block-group multi-component-container multi-component-container--2-up multi-component-container--uniform-height has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\"><div  class=\"card flow  wp-elements-7 has-white-background-color has-text-color has-black-color\" style=\"padding-top:1.33rem;padding-bottom:1.33rem;padding-left:1.33rem;padding-right:1.33rem;\">\n            <div class=\"acf-innerblocks-container\">\n\n<figure class=\"wp-block-image aligncenter size-full is-resized\"><img decoding=\"async\" width=\"396\" height=\"162\" src=\"/images/2024/02/Financing-Greensky-logo.jpg\" alt=\"Greensky logo\" class=\"wp-image-17\" style=\"width:222px;height:auto\" srcset=\"/images/2024/02/Financing-Greensky-logo.jpg 396w, /images/2024/02/Financing-Greensky-logo-300x123.jpg 300w\" sizes=\"(max-width: 396px) 100vw, 396px\" /></figure>\n\n<h3 class=\"wp-block-heading has-text-align-center\"><strong>Fixed Rate 12.99% for 120 Months</strong></h3>\n\n<p class=\"has-text-align-center wp-block-paragraph\">Loan term is 120 months at a fixed rate of 12.99% APR. Payments starting as low as $15 per month depending on your loan approval. </p>\n\n<a href=\"https://projects.greensky.com/MerchantLoanApplication?apptype=short&#038;merchant=81086361&#038;dealerplan=2832&#038;channel=External-Button-03\" target=\"_blank\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"false\" class=\"cta align-self-right\">\n    <span >Go to Greensky</span>\n        <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronright\" /></svg>\n</a>\n</div>\n    </div>\n\n<div  class=\"card flow  wp-elements-8 has-white-background-color has-text-color has-black-color\" style=\"padding-top:1.33rem;padding-bottom:1.33rem;padding-left:1.33rem;padding-right:1.33rem;\">\n            <div class=\"acf-innerblocks-container\">\n\n<figure class=\"wp-block-image aligncenter size-full is-resized\"><img decoding=\"async\" width=\"396\" height=\"162\" src=\"/images/2024/02/Financing-Greensky-logo.jpg\" alt=\"Greensky logo\" class=\"wp-image-17\" style=\"width:222px;height:auto\" srcset=\"/images/2024/02/Financing-Greensky-logo.jpg 396w, /images/2024/02/Financing-Greensky-logo-300x123.jpg 300w\" sizes=\"(max-width: 396px) 100vw, 396px\" /></figure>\n\n<h3 class=\"wp-block-heading has-text-align-center\"><strong>Fixed Rate APR for 120 Months</strong></h3>\n\n<p class=\"has-text-align-center wp-block-paragraph\">Loan term is 120 months and rates range from 9.99% &#8211; 22.99% APR. Loan amount and rate will vary based on your income and creditworthiness. </p>\n\n<a href=\"https://projects.greensky.com/MerchantLoanApplication?apptype=short&#038;merchant=81086361&#038;dealerplan=9991&#038;channel=External-Button-03\" target=\"_blank\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"false\" class=\"cta align-self-right\">\n    <span >Go to Greensky</span>\n        <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronright\" /></svg>\n</a>\n</div>\n    </div></div>\n\n<div class=\"wp-block-group multi-component-container multi-component-container--2-up multi-component-container--uniform-height has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\"><div  class=\"card flow  wp-elements-9 has-white-background-color has-text-color has-black-color\" style=\"padding-top:1.33rem;padding-bottom:1.33rem;padding-left:1.33rem;padding-right:1.33rem;\">\n            <div class=\"acf-innerblocks-container\">\n\n<figure class=\"wp-block-image aligncenter size-full is-resized\"><img decoding=\"async\" width=\"396\" height=\"162\" src=\"/images/2024/02/Financing-Greensky-logo.jpg\" alt=\"Greensky logo\" class=\"wp-image-17\" style=\"width:222px;height:auto\" srcset=\"/images/2024/02/Financing-Greensky-logo.jpg 396w, /images/2024/02/Financing-Greensky-logo-300x123.jpg 300w\" sizes=\"(max-width: 396px) 100vw, 396px\" /></figure>\n\n<h3 class=\"wp-block-heading has-text-align-center\"><strong>No Interest if Paid in Full in 12 Months</strong></h3>\n\n<p class=\"has-text-align-center wp-block-paragraph\">Subject to credit approval. Minimum monthly payments required. Interest is billed during the promotional period, but all interest is waived if the purchase amount is paid in full within 12 months. </p>\n\n<a href=\"https://projects.greensky.com/MerchantLoanApplication?apptype=short&#038;merchant=81086361&#038;dealerplan=2613&#038;channel=External-Button-03\" target=\"_blank\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"false\" class=\"cta align-self-right\">\n    <span >Go to Greensky</span>\n        <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronright\" /></svg>\n</a>\n</div>\n    </div>\n\n<div  class=\"card flow  wp-elements-10 has-white-background-color has-text-color has-black-color\" style=\"padding-top:1.33rem;padding-bottom:1.33rem;padding-left:1.33rem;padding-right:1.33rem;\">\n            <div class=\"acf-innerblocks-container\">\n\n<figure class=\"wp-block-image aligncenter size-full is-resized\"><img decoding=\"async\" width=\"396\" height=\"162\" src=\"/images/2024/02/Financing-Greensky-logo.jpg\" alt=\"Greensky logo\" class=\"wp-image-17\" style=\"width:222px;height:auto\" srcset=\"/images/2024/02/Financing-Greensky-logo.jpg 396w, /images/2024/02/Financing-Greensky-logo-300x123.jpg 300w\" sizes=\"(max-width: 396px) 100vw, 396px\" /></figure>\n\n<h3 class=\"wp-block-heading has-text-align-center\"><strong>No Interest if Paid in Full in 18 Months</strong></h3>\n\n<p class=\"has-text-align-center wp-block-paragraph\">Subject to credit approval. Minimum monthly payments required. Interest is billed during the promotional period, but all interest is waived if the purchase amount is paid in full within 12 months. </p>\n\n<a href=\"https://projects.greensky.com/MerchantLoanApplication?apptype=short&#038;merchant=81086361&#038;dealerplan=2631&#038;channel=External-Button-03\" target=\"_blank\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"false\" class=\"cta align-self-right\">\n    <span >Go to Greensky</span>\n        <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronright\" /></svg>\n</a>\n</div>\n    </div></div>\n\n<div class=\"wp-block-group multi-component-container multi-component-container--2-up multi-component-container--uniform-height has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\"><div  class=\"card flow  wp-elements-11 has-white-background-color has-text-color has-black-color\" style=\"padding-top:1.33rem;padding-bottom:1.33rem;padding-left:1.33rem;padding-right:1.33rem;\">\n            <div class=\"acf-innerblocks-container\">\n\n<figure class=\"wp-block-image aligncenter size-full is-resized\"><img decoding=\"async\" width=\"728\" height=\"165\" src=\"/images/2024/03/Upgrade-logo.png\" alt=\"Upgrade logo\" class=\"wp-image-4793\" style=\"width:222px;height:auto\" srcset=\"/images/2024/03/Upgrade-logo.png 728w, /images/2024/03/Upgrade-logo-300x68.png 300w\" sizes=\"(max-width: 728px) 100vw, 728px\" /></figure>\n\n<h3 class=\"wp-block-heading has-text-align-center\">Monthly Payments to Fit your Budget!</h3>\n\n<p class=\"has-text-align-center wp-block-paragraph\">Special terms and promotions available. Online account management and bill payment options. View details on the Upgrade site.</p>\n\n<a href=\"https://upgrade.com/h/szSnj944J8\" target=\"_blank\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"false\" class=\"cta align-self-right\">\n    <span >Go to Upgrade</span>\n        <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronright\" /></svg>\n</a>\n</div>\n    </div></div>\n</div>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<h2 class=\"wp-block-heading\">Flexible Financing With our Partners at Greensky and Upgrade</h2>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<p class=\"wp-block-paragraph\">2nd Wind Heating &amp; Air Conditioning partners with trusted financing providers to make your plumbing upgrades accessible and affordable. Here’s what you can expect:</p>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<ul class=\"wp-block-list\">\n<li><strong>Monthly Payment Plans:</strong>&nbsp;Customizable plans to fit your budget.</li>\n\n<li><strong>Promotional Rates:</strong>&nbsp;Special terms and reduced interest rates during promotional periods.</li>\n\n<li><strong>Online Account Management:</strong>&nbsp;Track your payments and manage your account conveniently online.</li>\n</ul>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<h2 class=\"wp-block-heading\"><strong>Why Choose 2nd Wind Heating &amp; Air Conditioning?</strong></h2>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<p class=\"wp-block-paragraph\">2nd Wind Heating &amp; Air Conditioning is proud to serve Columbia and the surrounding areas with reliable plumbing solutions. Our experienced technicians, combined with flexible financing options through trusted partners, ensure you receive high-quality service at a price you can manage. Let us help you address your plumbing needs today.</p>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\t</div>\n\t</article><!-- #post-6559 -->"

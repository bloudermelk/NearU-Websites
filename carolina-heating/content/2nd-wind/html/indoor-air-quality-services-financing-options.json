  "html": "<article id=\"post-6551\" class=\"container post-6551 page type-page status-publish has-post-thumbnail hentry\">\n\n\t<div class=\"entry-content | container\">\n\t\t<section  class=\"container section--services-hero pt-5 services-hero\">\n\t<div class=\"section--services-hero__main\">\n\t\t<div class=\"section--services-hero__main__row\">\n\t\t\t<div class=\"section--services-hero__main__row__left\">\n                <div class=\"acf-innerblocks-container\">\n\n<div class=\"wp-block-group full-width-mobile is-vertical is-layout-flex wp-container-core-group-is-layout-2c90304e wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group h-align is-nowrap is-layout-flex wp-container-core-group-is-layout-7387b849 wp-block-group-is-layout-flex\">    <div class=\"iconblock wp-elements-1 has-background has-secondary-background-color has-text-color has-primary-inverse-color\" data-size=\"md\" data-padding=\"2\" data-display=\"inline\">\n        <svg class=\"icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-money\" /></svg>    </div>\n\n<h1 class=\"wp-block-heading has-secondary-active-color has-text-color has-link-color has-x-large-font-size wp-elements-2\">Indoor Air Quality Services Financing Options with 2nd Wind</h1>\n</div>\n\n<div class=\"wp-block-group my-3 is-layout-flex wp-block-group-is-layout-flex\">\n<p class=\"wp-block-paragraph\">At 2nd Wind Heating &amp; Air Conditioning, we believe that clean, healthy air should be accessible to every homeowner. That’s why we offer&nbsp;<strong>flexible financing options</strong>&nbsp;for indoor air quality systems, making it easier to improve the air in your home without financial stress. Whether you’re installing a whole-home air purifier, upgrading your filtration system, or adding a humidifier, we’re here to help you breathe easier. Contact us today to learn more about financing your indoor air quality improvements.</p>\n</div>\n\n<div class=\"wp-block-group mb-3 is-content-justification-left is-nowrap is-layout-flex wp-container-core-group-is-layout-a1b15d37 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group full-width-mobile is-vertical is-content-justification-stretch is-layout-flex wp-container-core-group-is-layout-41171c72 wp-block-group-is-layout-flex\">\n<p class=\"horizon-text full-width-mobile has-secondary-font-family wp-block-paragraph\" style=\"text-transform:uppercase\">Speak with an expert</p>\n\n<a href=\"tel:+18033921513\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"icon\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta full-width-mobile\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-phone\" /></svg><span>(803) 392-1513</span>\n</a>\n\n<p class=\"text-center has-primary-color has-text-color has-link-color has-secondary-font-family has-small-font-size wp-elements-3 wp-block-paragraph\" style=\"text-transform:uppercase\"><strong>Same day appointments available by phone</strong></p>\n</div>\n</div>\n</div>\n\n</div>\n\t\t\t</div><!-- ./left -->\n\t\t\t<div class=\"section--services-hero__main__row__right\">\n\t\t\t<div class=\"elevated content-fullbleed-mobile box-shadow-lg border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\t\t\t<figure class=\"wp-block-post-featured-image\"><img decoding=\"async\" width=\"2560\" height=\"1707\" src=\"/images/2024/04/cooling-service-category-page-scaled.jpeg\" class=\"attachment-post-thumbnail size-post-thumbnail wp-post-image\" alt=\"Happy family under air conditioner, mom holding remote control switch on conditioning in living room adjust comfort temperature for daughter, climate system at modern home\" style=\"object-fit:cover;\" srcset=\"/images/2024/04/cooling-service-category-page-scaled.jpeg 2560w, /images/2024/04/cooling-service-category-page-300x200.jpeg 300w, /images/2024/04/cooling-service-category-page-1024x683.jpeg 1024w, /images/2024/04/cooling-service-ca
ages/2024/03/LG-logo-300x135.png\" class=\"logogrid-image\" alt=\"LG logo\" srcset=\"/images/2024/03/LG-logo-300x135.png 300w, /images/2024/03/LG-logo.png 556w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"167\" src=\"/images/2024/02/trane_logo-300x167.png\" class=\"logogrid-image\" alt=\"Trane Logo\" srcset=\"/images/2024/02/trane_logo-300x167.png 300w, /images/2024/02/trane_logo-768x427.png 768w, /images/2024/02/trane_logo.png 900w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"169\" src=\"/images/2024/02/Lennox-logo-300x169.png\" class=\"logogrid-image\" alt=\"Lennox logo\" srcset=\"/images/2024/02/Lennox-logo-300x169.png 300w, /images/2024/02/Lennox-logo-1024x576.png 1024w, /images/2024/02/Lennox-logo-768x432.png 768w, /images/2024/02/Lennox-logo-1536x864.png 1536w, /images/2024/02/Lennox-logo-2048x1152.png 2048w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"63\" src=\"/images/2024/03/Daikin-logo-300x63.png\" class=\"logogrid-image\" alt=\"Daikin logo\" srcset=\"/images/2024/03/Daikin-logo-300x63.png 300w, /images/2024/03/Daikin-logo-768x162.png 768w, /images/2024/03/Daikin-logo.png 1018w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"167\" src=\"/images/2024/02/york-install-confidence-vector-logo-300x167.png\" class=\"logogrid-image\" alt=\"York logo\" srcset=\"/images/2024/02/york-install-confidence-vector-logo-300x167.png 300w, /images/2024/02/york-install-confidence-vector-logo-768x427.png 768w, /images/2024/02/york-install-confidence-vector-logo.png 900w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"53\" src=\"/images/2024/03/Honeywell-logo-300x53.png\" class=\"logogrid-image\" alt=\"Honeywell logo\" srcset=\"/images/2024/03/Honeywell-logo-300x53.png 300w, /images/2024/03/Honeywell-logo-1024x181.png 1024w, /images/2024/03/Honeywell-logo-768x136.png 768w, /images/2024/03/Honeywell-logo.png 1413w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"225\" height=\"225\" src=\"/images/2024/02/rheem.png\" class=\"logogrid-image\" alt=\"Rheem logo\" srcset=\"/images/2024/02/rheem.png 225w, /images/2024/02/rheem-150x150.png 150w\" sizes=\"(max-width: 225px) 100vw, 225px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"76\" src=\"/images/2024/06/Tempstar-logo-300x76.jpg\" class=\"logogrid-image\" alt=\"Tempstar Heating and Cooling Products logo\" srcset=\"/images/2024/06/Tempstar-logo-300x76.jpg 300w, /images/2024/06/Tempstar-logo.jpg 568w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"88\" src=\"/images/2024/03/Mitsubishi-Electric-logo-300x88.png\" class=\"logogrid-image\" alt=\"Mitsubishi Electric logo\" srcset=\"/images/2024/03/Mitsubishi-Electric-logo-300x88.png 300w, /images/2024/03/Mitsubishi-Electric-logo-768x226.png 768w, /images/2024/03/Mitsubishi-Electric-logo.png 851w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n        </ul>\n</div>\n\n            <h6 class=\"wp-block-heading has-text-align-center\" style=\"text-transform:uppercase\">\n                And Dozens More\n            </h6></div>\n\n    </div>\n</div>\n\n<div  class=\"splitter-column splitter-column--right splitter-column--center py-3 has-custom-acf-color has-background has-secondary-background-color has-text-color has-secondary-inverse-color wp-elements-5\">\n    <div class=\"splitter-column-inner splitter-column-inner--contained splitter-column-inner--padded\">\n\n    <h2 class=\"wp-block-heading mb-3\">Qualified for All Major Makes and Models</h2>\n\n    <div class=\"wp-block-group flow mb-2 has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n    <p>Our team of expert technicians is trained to handle all makes and models of major brands with precision and care. From routine maintenance to complex repairs, we ensure top-notch service for all.</p>\n\n    </div>\n\n<div  class=\"iconlist\" data-orientation=\"vertical\" data-iconsize=\"md\">\n    <ul role=\"list\">\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-check\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p>Ensure optimal efficiency of all your systems</p>\n</p>\n            </div>\n        </li>\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-check\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p>Lower your utility costs with energy efficiency</p>\n</p>\n            </div>\n        </li>\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-check\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p>Extend your system’s lifespan through regular maintenance</p>\n</p>\n            </div>\n        </li>\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-check\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p>Keep you and your family comfortable and safe during all seasons</p>\n</p>\n            </div>\n        </li>\n            </ul>\n</div>\n    </div>\n</div>\n\n</div>\n<div id=\"FAQs\" class=\"wp-block-group py-5 flow has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading has-text-align-center\">FAQs</h2>\n\n<div  class=\"accordion\" style=\"--_accordion-separator-color: \">\n            <details class=\"accordion-item\" data-custom-open=\"true\" open>\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">How do I know if my ducts are leaking?</p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p class=\"FirstParagraph\">The symptoms are rooms that never match the thermostat, high summer bills, excess dust, and a system that runs constantly. An inspection confirms it directly, and we show you the findings on video rather than asking you to take our word.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">How much conditioned air does a typical duct system lose?</p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p class=\"FirstParagraph\">Leaky residential systems commonly lose a meaningful share of their airflow to unconditioned space, often in the range of 20 to 30 percent in unsealed older systems. Sealing recovers that delivery, which is why the fix shows up on the power bill.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Is duct cleaning worth it, or is it a gimmick?</p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p class=\"FirstParagraph\">It is worth it when there is something to remove: visible dust discharge, post-renovation debris, or contamination from long-standing return leaks. It is not a substitute for sealing. We inspect first and tell you which condition your ducts are actually in.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Why do my ducts sweat in the crawl space?</p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p class=\"FirstParagraph\">Cold supply air inside a duct meets humid crawl space air outside it, and condensation forms on the surface, soaking insulation and dripping. Better duct insulation and crawl space moisture control together stop it.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Can bad ductwork make a new HVAC system underperform?</p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p class=\"FirstParagraph\">Yes, and it is one of the most common reasons a new system disappoints. Undersized or leaking ducts throttle equipment regardless of its rating, which is why we evaluate ductwork as part of any replacement quote.</p>\n                </div>\n            </div>\n        </details>    </div>\n</div>\n\n<div id=\"maintenance-financing\" class=\"container splitter splitter--uniform-height-stick-last\" style=\"--CTX-container-split-size: 0.5\">\n\n<div  class=\"splitter-column splitter-column--left splitter-column--start wp-elements-6 has-background has-primary-background-color has-text-color has-primary-inverse-color\">\n    <div class=\"splitter-column-inner splitter-column-inner--contained splitter-column-inner--padded\">\n\n<div class=\"wp-block-group flow w100 has-global-padding is-layout-constrained wp-container-core-group-is-layout-2468f3b8 wp-block-group-is-layout-constrained\"><div class=\"elevated content-fullbleed-mobile w100 border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\n<figure class=\"wp-block-image size-full has-custom-border w100\"><img decoding=\"async\" width=\"1916\" height=\"1280\" src=\"/images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-technician-retreiving-an-item-from-a-service-truck.jpg\" alt=\"A 2nd Wind Heating and Air Conditioning technician retreiving an item from a service truck\" class=\"wp-image-5698\" style=\"border-radius:0px;object-fit:cover\" srcset=\"/images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-technician-retreiving-an-item-from-a-service-truck.jpg 1916w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-technician-retreiving-an-item-from-a-service-truck-300x200.jpg 300w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-technician-retreiving-an-item-from-a-service-truck-1024x684.jpg 1024w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-technician-retreiving-an-item-from-a-service-truck-768x513.jpg 768w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-technician-retreiving-an-item-from-a-service-truck-1536x1026.jpg 1536w\" sizes=\"(max-width: 1916px) 100vw, 1916px\" /></figure>\n\n</div>\n</div>\n\n<h2 class=\"wp-block-heading mt-3 has-primary-inverse-color has-text-color has-link-color wp-elements-7\">Need a Maintenance Plan?</h2>\n\n<ul class=\"wp-block-list\">\n<li>Prevent costly repairs with regular maintenance checks</li>\n\n<li>Ensure your systems are running efficiently year-round</li>\n\n<li>Extend the lifespan of your heating and cooling units</li>\n\n<li>Minimize the risk of unexpected breakdowns and emergencies</li>\n\n<li>Improve energy efficiency and lower utility bills</li>\n\n<li>Ensure the safety and reliability of your home's systems</li>\n</ul>\n\n<a href=\"/maintenance\" data-cta-gap=\"md\" data-cta-type=\"outline\" data-cta-content=\"mixed\" data-cta-minwidth=\"true\" class=\"cta full-width-mobile\">\n    <span >Learn More</span>\n        <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronright\" /></svg>\n</a></div>\n\n</div>\n</div>\n\n<div  class=\"splitter-column splitter-column--right splitter-column--start has-background has-primary-inverse-background-color\">\n    <div class=\"splitter-column-inner splitter-column-inner--contained splitter-column-inner--padded\">\n\n<div class=\"wp-block-group flow has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\"><div class=\"elevated content-fullbleed-mobile border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\n<figure class=\"wp-block-image size-full has-custom-border\"><img decoding=\"async\" width=\"1916\" height=\"1280\" src=\"/images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-employee-working-on-a-computer-while-on-the-telephone.jpg\" alt=\"A 2nd Wind Heating and Air Conditioning employee working on a computer while on the telephone\" class=\"wp-image-5693\" style=\"border-radius:0px\" srcset=\"/images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-employee-working-on-a-computer-while-on-the-telephone.jpg 1916w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-employee-working-on-a-computer-while-on-the-telephone-300x200.jpg 300w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-employee-working-on-a-computer-while-on-the-telephone-1024x684.jpg 1024w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-employee-working-on-a-computer-while-on-the-telephone-768x513.jpg 768w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-employee-working-on-a-computer-while-on-the-telephone-1536x1026.jpg 1536w\" sizes=\"(max-width: 1916px) 100vw, 1916px\" /></figure>\n\n</div>\n</div>\n\n<h2 class=\"wp-block-heading mt-3\">Ask Us About Financing!</h2>\n\n<p class=\"mb-3 wp-block-paragraph\">Financing plans bring value and benefits to homeowners. By opting for a financing option, you can tackle necessary repairs or upgrades without draining your savings or delaying important projects. Here are some key advantages:</p>\n\n<ul class=\"mb-3 wp-block-list\">\n<li>Budget-Friendly</li>\n\n<li>Access to Quality Services</li>\n\n<li>Timely Repairs</li>\n\n<li>Flexibility</li>\n\n<li>Increase Home Value</li>\n\n<li>Emergency Protection</li>\n</ul>\n\n<p class=\"mb-3 mt-0 wp-block-paragraph\">Keep your home safe and comfortable with a finance plan. Always assess terms and interest rates to find the best one for your needs. A professional can help you make an informed decision.</p>\n\n<a href=\"/financing\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta full-width-mobile\">\n    <span >Learn More</span>\n        <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronright\" /></svg>\n</a></div>\n\n</div>\n</div>\n\n</div>        <div  class=\"google-reviews-featured container py-5 container has-background has-gray-light-background-color\">\n    <div class=\"google-reviews-featured__head\">\n        <div class=\"google-reviews-featured__head__logo\">            <svg version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\" viewBox=\"0 0 107.3 35.2\" style=\"enable-background:new 0 0 107.3 35.2;\" xml:space=\"preserve\"><title>Google</title><path fill=\"#4885ED\" d=\"M26.4,12.4H13.9v3.7h8.9c-0.4,5.2-4.8,7.4-8.9,7.4c-5.4,0-9.8-4.3-9.8-9.7c0-0.1,0-0.1,0-0.2 c0-5.6,4.4-10,9.8-10c4.2,0,6.7,2.7,6.7,2.7l2.6-2.7c0,0-3.3-3.7-9.4-3.7C6,0,0,6.5,0,13.6c0,6.9,5.6,13.7,14,13.7 c7.3,0,12.7-5,12.7-12.4C26.6,13.3,26.4,12.4,26.4,12.4L26.4,12.4z\"/><g><path id=\"A\" fill=\"#DB3236\" d=\"M36.6,9.7c-5.1,0-8.8,4-8.8,8.7c0,4.8,3.6,8.8,8.9,8.8c4.8,0,8.7-3.7,8.7-8.7 C45.4,12.7,40.9,9.7,36.6,9.7L36.6,9.7z M36.7,13.2c2.5,0,4.9,2,4.9,5.3c0,3.2-2.4,5.3-4.9,5.3c-2.8,0-5-2.2-5-5.3 C31.7,15.4,33.9,13.2,36.7,13.2L36.7,13.2z\"/></g><g><path id=\"A_00000019641008515513977120000006682861592563020936_\" fill=\"#F4C20D\" d=\"M55.8,9.7c-5.1,0-8.8,4-8.8,8.7 c0,4.8,3.6,8.8,8.9,8.8c4.8,0,8.7-3.7,8.7-8.7C64.6,12.7,60,9.7,55.8,9.7L55.8,9.7z M55.9,13.2c2.5,0,4.9,2,4.9,5.3 c0,3.2-2.4,5.3-4.9,5.3c-2.8,0-5-2.2-5-5.3C50.9,15.4,53,13.2,55.9,13.2L55.9,13.2z\"/></g><path fill=\"#4885ED\" d=\"M74.6,9.7c-4.7,0-8.4,4.1-8.4,8.8c0,5.3,4.3,8.8,8.3,8.8c2.5,0,3.8-1,4.8-2.1v1.7c0,3-1.8,4.8-4.6,4.8 c-2.7,0-4-2-4.5-3.1L66.9,30c1.2,2.5,3.6,5.2,7.9,5.2c4.7,0,8.3-3,8.3-9.1V10.3h-3.7v1.5C78.2,10.5,76.7,9.7,74.6,9.7L74.6,9.7z M75,13.2c2.3,0,4.7,2,4.7,5.3c0,3.4-2.4,5.3-4.7,5.3c-2.5,0-4.9-2-4.9-5.3C70.1,15.2,72.5,13.2,75,13.2L75,13.2z\"/><path fill=\"#DB3236\" d=\"M99.4,9.7c-4.4,0-8.2,3.5-8.2,8.8c0,5.5,4.2,8.8,8.6,8.8c3.7,0,6-2,7.4-3.8l-3-2c-0.8,1.2-2.1,2.4-4.3,2.4 c-2.5,0-3.6-1.3-4.3-2.7l11.8-4.9l-0.6-1.4C105.6,12.1,102.9,9.7,99.4,9.7L99.4,9.7z M99.6,13.1c1.6,0,2.8,0.9,3.2,1.9l-7.9,3.3 C94.6,15.7,97,13.1,99.6,13.1L99.6,13.1z\"/><path fill=\"#3CBA54\" d=\"M85.6,26.8h3.9V0.9h-3.9V26.8z\"/></svg>\n            <div class=\"google-reviews-featured__head__logo__text\">\n                Reviews <span class=\"google-reviews-featured__head__logo__text__stars\">★★★★★</span>\n            </div>\n        </div>\n        <div class=\"google-reviews-featured__head__rating\"><div class=\"google-reviews-featured__head__rating__stars\">\n                <div class=\"google-reviews-featured__head__rating__stars__black\">★★★★★</div>\n                <div class=\"google-reviews-featured__head__rating__stars__white\">☆☆☆☆☆</div>\n            </div>\n            <div class=\"google-reviews-featured__head__rating__score\">\n                5/5\n            </div>\n            <div class=\"google-reviews-featured__head__rating__number-of-reviews\">\n                <span>18 Reviews</span>\n            </div>\n        </div>\n    </div>\n        <!-- reviews body -->\n    <div class=\"google-reviews-featured__body\">\n                                                <!-- review carousel -->\n                <div class=\"nearu-carousel multi-component-container multi-component-container--uniform-height\">                    <div  class=\"card card--google-review has-white-background-color has-black-color\">\n        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Sydney Conley\" aria-label=\"Sydney Conley\">Sydney Conley</p>\n            <div class=\"card__content__title__stars\">★★★★★</div>\n                    <div class=\"card__content__description card__description\">\n<p>We have used 2nd Wind for years and I could not be happier with them. Every single technician we’ve had has been so kind and friendly. They have come out in the middle of the night for us and been just as nice. We just had a lot of work done (ductwork and new water heater) and when they left there was not a speck of debris/trash left anywhere; you would never have known they were here. They made sure we understood how everything worked and that we had all our questions answered. I love this company!</p>\n</div>\n\n                </div></div>\n                            <div  class=\"card card--google-review has-white-background-color has-black-color\">\n        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Marie Sanders\" aria-label=\"Marie Sanders\">Marie Sanders</p>\n            <div class=\"card__content__title__stars\">★★★★★</div>\n                    <div class=\"card__content__description card__description\">\n<p>We had a great experience. All the technicians were great and good workers. The follow up gentleman made a slight change in how to change the filter that made it better for me. Would recommend them to anyone.</p>\n</div>\n\n                </div></div>\n                            <div  class=\"card card--google-review has-white-background-color has-black-color\">\n        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Alana B.\" aria-label=\"Alana B.\">Alana B.</p>\n            <div class=\"card__content__title__stars\">★★★★★</div>\n                    <div class=\"card__content__description card__description\">\n<p>10/10 would recommend. My air ducts desperately needed replacement. 2nd Wind was the only company to return my call once I began the search. They had me on the schedule the next day for an estimate and began the job the following Monday, a three day job. The installers were very professional, friendly, and responsible. I was even loaned a window unit during the job. </p>\n</div>\n\n                </div></div>\n            </div>\n    <!-- ./ review carousel -->\n    <div class=\"nearu-carousel-controls\">\n\t<div class=\"nearu-carousel-button button-prev\">    <div class=\"iconblock\" data-size=\"lg\" data-padding=\"2\" data-display=\"block\">\n        <svg class=\"icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronleft\" /></svg>    </div>\n    </div>\n
  "html": "<article id=\"post-5670\" class=\"container post-5670 page type-page status-publish has-post-thumbnail hentry type-of-service-financing\">\n\n\t<div class=\"entry-content | container\">\n\t\t<section  class=\"container section--services-hero pt-5 services-hero\">\n\t<div class=\"section--services-hero__main\">\n\t\t<div class=\"section--services-hero__main__row\">\n\t\t\t<div class=\"section--services-hero__main__row__left\">\n                <div class=\"acf-innerblocks-container\">\n\n<div class=\"wp-block-group full-width-mobile is-vertical is-layout-flex wp-container-core-group-is-layout-2c90304e wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group h-align is-nowrap is-layout-flex wp-container-core-group-is-layout-7387b849 wp-block-group-is-layout-flex\">    <div class=\"iconblock wp-elements-1 has-background has-secondary-background-color has-text-color has-primary-inverse-color\" data-size=\"md\" data-padding=\"2\" data-display=\"inline\">\n        <svg class=\"icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-money\" /></svg>    </div>\n\n<h1 class=\"wp-block-heading has-x-large-font-size\">Flexible Financing Options in Columbia and the Surrounding Areas</h1>\n</div>\n\n<div class=\"wp-block-group my-3 is-layout-flex wp-block-group-is-layout-flex\">\n<p class=\"wp-block-paragraph\">We understand that everyone’s financial situation is unique. That’s why 2nd Wind offers flexible financing options to ensure your home stays comfortable starting today.</p>\n</div>\n\n<div class=\"wp-block-group mb-3 is-content-justification-left is-nowrap is-layout-flex wp-container-core-group-is-layout-a1b15d37 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group full-width-mobile is-vertical is-content-justification-stretch is-layout-flex wp-container-core-group-is-layout-41171c72 wp-block-group-is-layout-flex\">\n<p class=\"horizon-text full-width-mobile has-secondary-font-family wp-block-paragraph\" style=\"text-transform:uppercase\">Speak with an expert</p>\n\n<a href=\"tel:+18033921513\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"icon\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta full-width-mobile\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-phone\" /></svg><span>(803) 392-1513</span>\n</a>\n\n<p class=\"text-center has-primary-color has-text-color has-link-color has-secondary-font-family has-small-font-size wp-elements-2 wp-block-paragraph\" style=\"text-transform:uppercase\"><strong>Same-day appointments available by phone</strong></p>\n</div>\n</div>\n</div>\n\n</div>\n\t\t\t</div><!-- ./left -->\n\t\t\t<div class=\"section--services-hero__main__row__right\">\n\t\t\t<div class=\"elevated content-fullbleed-mobile box-shadow-lg border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\t\t\t<figure class=\"wp-block-post-featured-image\"><img decoding=\"async\" width=\"1916\" height=\"1280\" src=\"/images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-employee-working-on-a-computer.jpg\" class=\"attachment-post-thumbnail size-post-thumbnail wp-post-image\" alt=\"A 2nd Wind Heating and Air Conditioning employee working on a computer\" style=\"object-fit:cover;\" srcset=\"/images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-employee-working-on-a-computer.jpg 1916w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-employee-working-on-a-computer-300x200.jpg 300w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-employee-working-on-a-computer-1024x684.jpg 1024w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-employee-working-on-a-computer-768x513.jpg 768w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-employee-working-on-a-computer-1536x1026.jpg 1536w\" sizes=\"(max-width: 1010px) 100vw, (max-width: 1440px) 50vw, 768px\" /></figure>\n\t\t\t</div>\n</div>\t\t\t</div><!-- ./right -->\n\t\t</div><!-- ./row -->\n\n</div>\n\t<div class=\"section--services-hero__main section--services-hero__main--empty has-background has-secondary-background-color\">\n\t</div><!-- ./row -->\n\n</section>\n\n<div class=\"wp-block-group container pb-5 flow has-primary-inverse-color has-secondary-background-color has-text-color has-background has-link-color wp-elements-3\">\n<div style=\"height:1rem\" aria-hidden=\"true\" class=\"wp-block-spacer d-block d-md-none\"></div>\n\n<h2 class=\"wp-block-heading\">Available Plans for Heating, Cooling, and Indoor Air Quality Services</h2>\n\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-7387b849 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\"><div  class=\"card card--page has-white-background-color has-black-color\">\n<a href=\"/heating-services-financing-options\" target=\"_blank\" aria-label=\"\" class=\"link stretch-link\"></a>        <figure class=\"card__featured-image\">\n        <img decoding=\"async\" width=\"640\" height=\"418\" src=\"/images/2024/11/trane-outdoor-ac-unit-1024x668.webp\" class=\"attachment-large size-large\" alt=\"Trane outdoor unit installed at a customer&#039;s home in Columbia, SC\" srcset=\"/images/2024/11/trane-outdoor-ac-unit-1024x668.webp 1024w, /images/2024/11/trane-outdoor-ac-unit-300x196.webp 300w, /images/2024/11/trane-outdoor-ac-unit-768x501.webp 768w, /images/2024/11/trane-outdoor-ac-unit.webp 1180w\" sizes=\"(max-width: 640px) 100vw, 640px\" />    </figure>\n        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Heating Finance Options\" aria-label=\"Heating Finance Options\">Heating Finance Options</p>\n\n                    <div class=\"card__content__description card__description\"><p>At 2nd Wind, we know that investing in a new heating system is a big decision. That’s why we offer <strong>flexible financing options</strong> for heating installations and replacements. Whether you’re upgrading to an energy-efficient system or replacing an outdated unit, our plans are designed to make the process seamless and affordable. Stay warm and comfortable today with a system tailored to your needs. Contact us to learn more about our financing options.</p>\n</div>\n\n            <div class=\"card__content__cta\">\n<a href=\"/heating-services-financing-options\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-heating\" /></svg><span >Heating Finance Options</span>\n\n</a></div>    </div></div>\n</div>\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\"><div  class=\"card card--page has-white-background-color has-black-color\">\n<a href=\"/flexible-financing-plans-for-cooling-services\" target=\"_blank\" aria-label=\"\" class=\"link stretch-link\"></a>        <figure class=\"card__featured-image\">\n        <img decoding=\"async\" width=\"640\" height=\"359\" src=\"/images/2024/03/An-exterior-of-a-building-with-multiple-AC-units-and-flowers-1024x574.jpg\" class=\"attachment-large size-large\" alt=\"An exterior of a building with multiple AC units and flowers\" srcset=\"/images/2024/03/An-exterior-of-a-building-with-multiple-AC-units-and-flowers-1024x574.jpg 1024w, /images/2024/03/An-exterior-of-a-building-with-multiple-AC-units-and-flowers-300x168.jpg 300w, /images/2024/03/An-exterior-of-a-building-with-multiple-AC-units-and-flowers-768x430.jpg 768w, /images/2024/03/An-exterior-of-a-building-with-multiple-AC-units-and-flowers-1536x861.jpg 1536w, /images/2024/03/An-exterior-of-a-building-with-multiple-AC-units-and-flowers-2048x1148.jpg 2048w\" sizes=\"(max-width: 640px) 100vw, 640px\" />    </figure>\n        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Cooling Finance Options\" aria-label=\"Cooling Finance Options\">Cooling Finance Options</p>\n\n                    <div class=\"card__content__description card__description\"><div class=\"flex max-w-full flex-col flex-grow\">\n<div class=\"min-h-8 text-message flex w-full flex-col items-end gap-2 whitespace-normal break-words [.text-message+&amp;]:mt-5\" dir=\"auto\" data-message-author-role=\"assistant\" data-message-id=\"b5979a3a-c1b1-47e3-9411-c35cc94e09e7\" data-message-model-slug=\"gpt-4o\">\n<div class=\"flex w-full flex-col gap-1 empty:hidden first:pt-[3px]\">\n<div class=\"markdown prose w-full break-words dark:prose-invert dark\">\n<p>At 2nd Wind, we know that upgrading your cooling system is a big decision. That’s why we offer <strong>flexible financing options</strong> for cooling installations and replacements. Whether you’re investing in an energy-efficient air conditioner or replacing an older unit, our plans are designed to make the process seamless and affordable. Stay cool and comfortable today with a system tailored to your needs. Contact us to learn more about our financing options.</p>\n</div>\n</div>\n</div>\n</div>\n</div>\n\n            <div class=\"card__content__cta\">\n<a href=\"/flexible-financing-plans-for-cooling-services\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-cooling\" /></svg><span >Cooling Finance Options</span>\n\n</a></div>    </div></div>\n</div>\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\"><div  class=\"card card--page has-white-background-color has-black-color\">\n<a href=\"/indoor-air-quality-services-financing-options\" target=\"_blank\" aria-label=\"\" class=\"link stretch-link\"></a>        <figure class=\"card__featured-image\">\n        <img loading=\"lazy\" decoding=\"async\" width=\"640\" height=\"427\" src=\"/images/2024/04/cooling-service-category-page-1024x683.jpeg\" class=\"attachment-large size-large\" alt=\"Happy family under air conditioner, mom holding remote control switch on conditioning in living room adjust comfort temperature for daughter, climate system at modern home\" srcset=\"/images/2024/04/cooling-service-category-page-1024x683.jpeg 1024w, /images/2024/04/cooling-service-category-page-300x200.jpeg 300w, /images/2024/04/cooling-service-category-page-768x512.jpeg 768w, /images/2024/04/cooling-service-category-page-1536x1024.jpeg 1536w, /images/2024/04/cooling-service-category-page-2048x1365.jpeg 2048w\" sizes=\"(max-width: 640px) 100vw, 640px\" />    </figure>\n        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Indoor Air Quality Finance Options\" aria-label=\"Indoor Air Quality Finance Options\">Indoor Air Quality Finance Options</p>\n\n                    <div class=\"card__content__description card__description\"><div class=\"flex max-w-full flex-col flex-grow\">\n<div class=\"min-h-8 text-message flex w-full flex-col items-end gap-2 whitespace-normal break-words [.text-message+&amp;]:mt-5\" dir=\"auto\" data-message-author-role=\"assistant\" data-message-id=\"4338e222-4c96-4150-b4ab-432bfcedb847\" data-message-model-slug=\"gpt-4o\">\n<div class=\"flex w-full flex-col gap-1 empty:hidden first:pt-[3px]\">\n<div class=\"markdown prose w-full break-words dark:prose-invert dark\">\n<p>At 2nd Wind, we know that improving indoor air quality is a big decision. That’s why we offer <strong>flexible financing options</strong> for IAQ products and services. Whether you’re upgrading an air purifier, adding a humidifier, or replacing outdated equipment, our plans are designed to make the process seamless and affordable. Breathe easier today with solutions tailored to your needs. Contact us to learn more about our financing options.</p>\n</div>\n</div>\n</div>\n</div>\n</div>\n\n            <div class=\"card__content__cta\">\n<a href=\"/indoor-air-quality-services-financing-options\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-indoor-air-quality\" /></svg><span >Indoor Air Quality Finance Options</span>\n\n</a></div>    </div></div>\n</div>\n</div>\n</div>\n\n        <div  class=\"google-reviews-featured container container py-5 has-background has-gray-light-background-color\">\n    <div class=\"google-reviews-featured__head\">\n        <div class=\"google-reviews-featured__head__logo\">            <svg version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\" viewBox=\"0 0 107.3 35.2\" style=\"enable-background:new 0 0 107.3 35.2;\" xml:space=\"preserve\"><title>Google</title><path fill=\"#4885ED\" d=\"M26.4,12.4H13.9v3.7h8.9c-0.4,5.2-4.8,7.4-8.9,7.4c-5.4,0-9.8-4.3-9.8-9.7c0-0.1,0-0.1,0-0.2 c0-5.6,4.4-10,9.8-10c4.2,0,6.7,2.7,6.7,2.7l2.6-2.7c0,0-3.3-3.7-9.4-3.7C6,0,0,6.5,0,13.6c0,6.9,5.6,13.7,14,13.7 c7.3,0,12.7-5,12.7-12.4C26.6,13.3,26.4,12.4,26.4,12.4L26.4,12.4z\"/><g><path id=\"A\" fill=\"#DB3236\" d=\"M36.6,9.7c-5.1,0-8.8,4-8.8,8.7c0,4.8,3.6,8.8,8.9,8.8c4.8,0,8.7-3.7,8.7-8.7 C45.4,12.7,40.9,9.7,36.6,9.7L36.6,9.7z M36.7,13.2c2.5,0,4.9,2,4.9,5.3c0,3.2-2.4,5.3-4.9,5.3c-2.8,0-5-2.2-5-5.3 C31.7,15.4,33.9,13.2,36.7,13.2L36.7,13.2z\"/></g><g><path id=\"A_00000019641008515513977120000006682861592563020936_\" fill=\"#F4C20D\" d=\"M55.8,9.7c-5.1,0-8.8,4-8.8,8.7 c0,4.8,3.6,8.8,8.9,8.8c4.8,0,8.7-3.7,8.7-8.7C64.6,12.7,60,9.7,55.8,9.7L55.8,9.7z M55.9,13.2c2.5,0,4.9,2,4.9,5.3 c0,3.2-2.4,5.3-4.9,5.3c-2.8,0-5-2.2-5-5.3C50.9,15.4,53,13.2,55.9,13.2L55.9,13.2z\"/></g><path fill=\"#4885ED\" d=\"M74.6,9.7c-4.7,0-8.4,4.1-8.4,8.8c0,5.3,4.3,8.8,8.3,8.8c2.5,0,3.8-1,4.8-2.1v1.7c0,3-1.8,4.8-4.6,4.8 c-2.7,0-4-2-4.5-3.
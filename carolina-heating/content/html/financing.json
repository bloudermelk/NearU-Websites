  "html": "<article id=\"post-972\" class=\"container post-972 page type-page status-publish hentry\">\n\n\t<div class=\"entry-content | container\">\n\t\t<section  class=\"container section--services-hero pt-5 services-hero\">\n\t<div class=\"section--services-hero__main\">\n\t\t<div class=\"section--services-hero__main__row\">\n\t\t\t<div class=\"section--services-hero__main__row__left\">\n                <div class=\"acf-innerblocks-container\">\n\n<div class=\"wp-block-group full-width-mobile is-vertical is-layout-flex wp-container-core-group-is-layout-2c90304e wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group is-nowrap is-layout-flex wp-container-core-group-is-layout-7387b849 wp-block-group-is-layout-flex\">\n<figure class=\"wp-block-image size-full is-resized\"><img decoding=\"async\" width=\"728\" height=\"165\" src=\"/images/2024/03/Upgrade-logo.png\" alt=\"Upgrade logo\" class=\"wp-image-4793\" style=\"width:auto;height:55px\" srcset=\"/images/2024/03/Upgrade-logo.png 728w, /images/2024/03/Upgrade-logo-300x68.png 300w\" sizes=\"(max-width: 728px) 100vw, 728px\" /></figure>\n\n<figure class=\"wp-block-image size-full is-resized\"><img decoding=\"async\" width=\"1130\" height=\"1209\" src=\"/images/2026/04/equal-housing-opportunity-logo-1200w-1.png\" alt=\"\" class=\"wp-image-6519\" style=\"width:auto;height:55px\" srcset=\"/images/2026/04/equal-housing-opportunity-logo-1200w-1.png 1130w, /images/2026/04/equal-housing-opportunity-logo-1200w-1-280x300.png 280w, /images/2026/04/equal-housing-opportunity-logo-1200w-1-957x1024.png 957w, /images/2026/04/equal-housing-opportunity-logo-1200w-1-768x822.png 768w\" sizes=\"(max-width: 1130px) 100vw, 1130px\" /></figure>\n</div>\n\n<div class=\"wp-block-group h-align is-nowrap is-layout-flex wp-container-core-group-is-layout-7387b849 wp-block-group-is-layout-flex\">    <div class=\"iconblock wp-elements-1 has-background has-secondary-background-color has-text-color has-primary-inverse-color\" data-size=\"md\" data-padding=\"2\" data-display=\"inline\">\n        <svg class=\"icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-money\" /></svg>    </div>\n\n<h1 class=\"wp-block-heading has-x-large-font-size\">Financing Options</h1>\n</div>\n\n<div class=\"wp-block-group my-3 is-layout-flex wp-block-group-is-layout-flex\">\n<p class=\"wp-block-paragraph\">We understand that everyone’s financial situation is unique. That’s why Carolina Heating Service offers flexible financing options to ensure your home stays comfortable starting today.</p>\n</div>\n\n<div class=\"wp-block-group mb-3 is-content-justification-left is-nowrap is-layout-flex wp-container-core-group-is-layout-a1b15d37 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group full-width-mobile is-vertical is-content-justification-stretch is-layout-flex wp-container-core-group-is-layout-41171c72 wp-block-group-is-layout-flex\">\n<p class=\"horizon-text full-width-mobile has-secondary-font-family wp-block-paragraph\" style=\"text-transform:uppercase\">Speak with an expert</p>\n\n<a href=\"tel:+18643626329\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"icon\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta full-width-mobile\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-phone\" /></svg><span>(864) 362-6329</span>\n</a>\n\n<p class=\"text-center has-primary-color has-text-color has-link-color has-secondary-font-family has-small-font-size wp-elements-2 wp-block-paragraph\" style=\"text-transform:uppercase\"><strong>Same-day appointments available by phone</strong></p>\n</div>\n</div>\n</div>\n\n<div class=\"wp-block-group has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\"></div>\n\n</div>\n\t\t\t</div><!-- ./left -->\n\t\t\t<div class=\"section--services-hero__main__row__right\">\n\t\t\t<div class=\"elevated content-fullbleed-mobile box-shadow-lg border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\t\t\t<figure class=\"wp-block-post-featured-image\"><img decoding=\"async\" width=\"1688\" height=\"1125\" src=\"/images/2024/03/A-senior-aged-man-and-woman-smiling-sitting-at-a-kitchen-table.jpg\" class=\"attachment-full size-full\" alt=\"A senior-aged man and woman smiling, sitting at a kitchen table\" srcset=\"/images/2024/03/A-senior-aged-man-and-woman-smiling-sitting-at-a-kitchen-table.jpg 1688w, /images/2024/03/A-senior-aged-man-and-woman-smiling-sitting-at-a-kitchen-table-300x200.jpg 300w, /images/2024/03/A-senior-aged-man-and-woman-smiling-sitting-at-a-kitchen-table-1024x682.jpg 1024w, /images/2024/03/A-senior-aged-man-and-woman-smiling-sitting-at-a-kitchen-table-768x512.jpg 768w, /images/2024/03/A-senior-aged-man-and-woman-smiling-sitting-at-a-kitchen-table-1536x1024.jpg 1536w\" sizes=\"(max-width: 1688px) 100vw, 1688px\" /></figure>\n\t\t\t</div>\n</div>\t\t\t</div><!-- ./right -->\n\t\t</div><!-- ./row -->\n\n</div>\n\t<div class=\"section--services-hero__main section--services-hero__main--empty has-background has-secondary-background-color\">\n\t</div><!-- ./row -->\n\n</section>\n\n<div class=\"wp-block-group content-fullbleed has-primary-inverse-color has-secondary-active-background-color has-text-color has-background has-link-color wp-elements-3 has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<div class=\"wp-block-group container pb-5 flow has-primary-inverse-color has-secondary-background-color has-text-color has-background has-link-color wp-elements-4\">\n<div style=\"height:1rem\" aria-hidden=\"true\" class=\"wp-block-spacer d-block d-md-none\"></div>\n\n<h2 class=\"wp-block-heading\">Flexible Financing Options for Home Comfort Services</h2>\n\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-7387b849 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\"><div  class=\"card card--page has-white-background-color has-black-color\">\n<a href=\"/cooling-services-financing-options\" target=\"_blank\" aria-label=\"\" class=\"link stretch-link\"></a>        <figure class=\"card__featured-image\">\n        <img loading=\"lazy\" decoding=\"async\" width=\"640\" height=\"427\" src=\"/images/2024/04/Trane_WRT_Unit_Shot1_0882_201022144525-1024x683.jpg\" class=\"attachment-large size-large\" alt=\"A Trane heating unit installed outdoors in Greenville SC\" srcset=\"/images/2024/04/Trane_WRT_Unit_Shot1_0882_201022144525-1024x683.jpg 1024w, /images/2024/04/Trane_WRT_Unit_Shot1_0882_201022144525-300x200.jpg 300w, /images/2024/04/Trane_WRT_Unit_Shot1_0882_201022144525-768x512.jpg 768w, /images/2024/04/Trane_WRT_Unit_Shot1_0882_201022144525-1536x1025.jpg 1536w, /images/2024/04/Trane_WRT_Unit_Shot1_0882_201022144525.jpg 2000w\" sizes=\"(max-width: 640px) 100vw, 640px\" />    </figure>\n        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Cooling Finance Options\" aria-label=\"Cooling Finance Options\">Cooling Finance Options</p>\n\n                    <div class=\"card__content__description card__description\"><p>Beat the heat with our flexible financing options for cooling systems. Whether you’re upgrading to a high-efficiency air conditioner, installing a heat pump, or replacing your old system, Carolina Heating Service makes it easy to stay comfortable.</p>\n</div>\n\n            <div class=\"card__content__cta\">\n<a href=\"/cooling-services-financing-options\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta\">\n    <span >Cooling Options</span>\n\n</a></div>    </div></div>\n</div>\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\"><div  class=\"card card--page has-white-background-color has-black-color\">\n<a href=\"/heating-services-financing-options\" target=\"_blank\" aria-label=\"\" class=\"link stretch-link\"></a>        <figure class=\"card__featured-image\">\n        <img loading=\"lazy\" decoding=\"async\" width=\"640\" height=\"694\" src=\"/images/2024/11/hvac-101-trane-hybrid-systems.webp\" class=\"attachment-large size-large\" alt=\"A trane hybrid system ready for installation in Greenville, SC\" srcset=\"/images/2024/11/hvac-101-trane-hybrid-systems.webp 826w, /images/2024/11/hvac-101-trane-hybrid-systems-277x300.webp 277w, /images/2024/11/hvac-101-trane-hybrid-systems-768x833.webp 768w\" sizes=\"(max-width: 640px) 100vw, 640px\" />    </figure>\n        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Heating Finance Options\" aria-label=\"Heating Finance Options\">Heating Finance Options</p>\n\n                    <div class=\"card__content__description card__description\"><p>Stay cozy with our flexible financing options for heating systems. Whether you’re upgrading to a high-efficiency furnace, installing a heat pump, or replacing your old unit, Carolina Heating Service ensures you stay warm during the coldest months.</p>\n</div>\n\n            <div class=\"card__content__cta\">\n<a href=\"/heating-services-financing-options\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta\">\n    <span >Heating Options</span>\n\n</a></div>    </div></div>\n</div>\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\"><div  class=\"card card--page has-white-background-color has-black-color\">\n<a href=\"/indoor-air-quality-services-financing-options\" target=\"_blank\" aria-label=\"\" class=\"link stretch-link\"></a>        <figure class=\"card__featured-image\">\n        <img loading=\"lazy\" decoding=\"async\" width=\"640\" height=\"640\" src=\"/images/2024/10/Air-Scrubber-Product-Image_2021.jpg\" class=\"attachment-large size-large\" alt=\"An air scrubber that is ready to be installed directly into the duct work of a residential customer in Greenville, SC\" srcset=\"/images/2024/10/Air-Scrubber-Product-Image_2021.jpg 900w, /images/2024/10/Air-Scrubber-Product-Image_2021-300x300.jpg 300w, /images/2024/10/Air-Scrubber-Product-Image_2021-150x150.jpg 150w, /images/2024/10/Air-Scrubber-Product-Image_2021-768x768.jpg 768w\" sizes=\"(max-width: 640px) 100vw, 640px\" />    </figure>\n        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Indoor Air Quality Finance Options\" aria-label=\"Indoor Air Quality Finance Options\">Indoor Air Quality Finance Options</p>\n\n                    <div class=\"card__content__description card__description\"><p>Breathe easier with our flexible financing options for indoor air quality systems. Whether you’re upgrading to an air purifier, adding a humidifier, or enhancing ventilation, Carolina Heating Service helps improve your home&#8217;s air quality.</p>\n</div>\n\n            <div class=\"card__content__cta\">\n<a href=\"/indoor-air-quality-services-financing-options\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta\">\n    <span >IAQ Options</span>\n\n</a></div>    </div></div>\n</div>\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\"><div  class=\"card card--page has-white-background-color has-black-color\">\n<a href=\"/plumbing-services-financing-options\" target=\"_blank\" aria-label=\"\" class=\"link stretch-link\"></a>        <figure class=\"card__featured-image\">\n        <img loading=\"lazy\" decoding=\"async\" width=\"612\" height=\"408\" src=\"/images/2024/10/trap-and-pipe-image.jpg\" class=\"attachment-large size-large\" alt=\"A plumber at work in a bathroom, doing trap and pipe cleaning in Greenville, SC\" srcset=\"/images/2024/10/trap-and-pipe-image.jpg 612w, /images/2024/10/trap-and-pipe-image-300x200.jpg 300w\" sizes=\"(max-width: 612px) 100vw, 612px\" />    </figure>\n        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Plumbing Finance Options\" aria-label=\"Plumbing Finance Options\">Plumbing Finance Options</p>\n\n                    <div class=\"card__content__description card__description\"><div class=\"flex max-w-full flex-col flex-grow\">\n<div class=\"min-h-8 text-message flex w-full flex-col items-end gap-2 whitespace-normal break-words [.text-message+&amp;]:mt-5\" dir=\"auto\" data-message-author-role=\"assistant\" data-message-id=\"bed50680-a5c1-40c2-800e-9ad06c7ae96a\" data-message-model-slug=\"gpt-4o\">\n<div class=\"flex w-full flex-col gap-1 empty:hidden first:pt-[3px]\">\n<div class=\"markdown prose w-full break-words dark:prose-invert dark\">\n<p>Fix leaks fast with our flexible financing options for plumbing services. Whether you’re upgrading your water heater, repairing pipes, or remodeling your bathroom, Carolina Heating Service makes it easy to keep your home running smoothly.</p>\n</div>\n</div>\n</div>\n</div>\n</div>\n\n            <div class=\"card__content__cta\">\n<a href=\"/plumbing-services-financing-options\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta\">\n    <span >Plumbing Options</span>\n\n</a></div>    </div></div>\n</div>\n</div>\n\n<div style=\"height:2rem\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<p class=\"wp-block-paragraph\">Carolina Heating Service makes it simple and affordable to upgrade your home’s comfort systems. Explore our financing options and schedule your consultation today to learn how we can keep your home running efficiently without breaking the bank.</p>\n</div>\n</div>\n\n        <div  class=\"google-reviews-featured container container py-5 has-background has-gray-light-background-color\">\n    <div class=\"google-reviews-featured__head\">\n        <div class=\"google-reviews-featured__head__logo\">            <svg version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\" viewBox=\"0 0 107.3 35.2\" style=\"enable-background:new 0 0 107.3 35.2;\" xml:space=\"preserve\"><title>Google</title><path fill=\"#4885ED\" d=\"M26.4,12.4H13.9v3.7h8.9c-0.4,5.2-4.8,7.4-8.9,7.4c-5.4,0-9.8-4.3-9.8-9.7c0-0.1,0-0.1,0-0.2 c0-5.6,4.4-10,9.8-10c4.2,0,6.7,2.7,6.7,2.7l2.6-2.7c0,0-3.3-3.7-9.4-3.7C6,0,0,6.5,0,13.6c0,6.9,5.6,13.7,14,13.7 c7.3,0,12.7-5,12.7-12.4C26.6,13.3,26.4,12.4,26.4,12.4L26.4,12.4z\"/><g><path id=\"A\" fill=\"#DB3236\" d=\"M36.6,9.7c-5.1,0-8.8,4-8.8,8.7c0,4.8,3.6,8.8,8.9,8.8c4.8,0,8.7-3.7,8.7-8.7 C45.4,12.7,40.9,9.7,36.6,9.7L36.6,9.7z M36.7,13.2c2.5,0,4.9,2,4.9,5.3c0,3.2-2.4,5.3-4.9,5.3c-2.8,0-5-2.2-5-5.3 C31.7,15.4,33.9,13.2,36.7,13.2L36.7,13.2z\"/></g><g><path id=\"A_00000019641008515513977120000006682861592563020936_\" fill=\"#F4C20D\" d=\"M55.8,9.7c-5.1,0-8.8,4-8.8,8.7 c0,4.8,3.6,8.8,8.9,8.8c4.8,0,8.7-3.7,8.7-8.7C64.6,12.7,60,9.7,55.8,9.7L55.8,9.7z M55.9,13.2c2.5,0,4.9,2,4.9,5.3 c0,3.2-2.4,5.3-4.9,5.3c-2.8,0-5-2.2-5-5.3C50.9,15.4,53,13.2,55.9,13.2L55.9,13.2z\"/></g><path fill=\"#4885ED\" d=\"M74.6,9.7c-4.7,0-8.4,4.1-8.4,8.8c0,5.3,4.3,8.8,8.3,8.8c2.5,0,3.8-1,4.8-2.1v1.7c0,3-1.8,4.8-4.6,4.8 c-2.7,0-4-2-4.5-3.1L66.9,30c1.2,2.5,3.6,5.2,7.9,5.2c4.7,0,8.3-3,8.3-9.1V10.3h-3.7v1.5C78.2,10.5,76.7,9.7,74.6,9.7L74.6,9.7z M75,13.2c2.3,0,4.7,2,4.7,5.3c0,3.4-2.4,5.3-4.7,5.3c-2.5,0-4.9-2-4.9-5.3C70.1,15.2,72.5,13.2,75,13.2L75,13.2z\"/><path fill=\"#DB3236\" d=\"M99.4,9.7c-4.4,0-8.2,3.5-8.2,8.8c0,5.5,4.2,8.8,8.6,8.8c3.7,0,6-2,7.4-3.8l-3-2c-0.8,1.2-2.1,2.4-4.3,2.4 c-2.5,0-3.6-1.3-4.3-2.7l11.8-4.9l-0.6-1.4C105.6,12.1,102.9,9.7,99.4,9.7L99.4,9.7z M99.6,13.1c1.6,0,2.8,0.9,3.2,1.9l-7.9,3.3 C94.6,15.7,97,13.1,99.6,13.1L99.6,13.1z\"/><path fill=\"#3CBA54\" d=\"M85.6,26.8h3.9V0.9h-3.9V26.8z\"/></svg>\n            <div class=\"google-reviews-featured__head__logo__text\">\n                Reviews <span class=\"google-reviews-featured__head__logo__text__stars\">★★★★★</span>\n            </div>\n        </div>\n        <div class=\"google-reviews-featured__head__rating\"><div class=\"google-reviews-featured__head__rating__stars\">\n                <div class=\"google-reviews-featured__head__rating__stars__black\">★★★★★</div>\n                <div class=\"google-reviews-featured__head__rating__stars__white\">☆☆☆☆☆</div>\n            </div>\n            <div class=\"google-reviews-featured__head__rating__score\">\n                5/5\n            </div>\n            <div class=\"google-reviews-featured__head__rating__number-of-reviews\">\n                <span>18 Reviews</span>\n            </div>\n        </div>\n    </div>\n        <!-- reviews body -->\n    <div class=\"google-reviews-featured__body\">\n                                                <!-- review carousel -->\n                <div class=\"nearu-carousel multi-component-container multi-component-container--uniform-height\">                    <div  class=\"card card--google-review has-white-background-color has-black-color\">\n        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Sigrid McMahon\" aria-label=\"Sigrid McMahon\">Sigrid McMahon</p>\n            <div class=\"card__content__title__stars\">★★★★★</div>\n                    <div class=\"card__content__description card__description\">\n<p>Carolina Heating came out the very next day to attend to our problem and were thorough in solving it. Previously we called them for a tankless hot water heater that just stopped working. They came out that day, fixed the problem and did a complete maintenance of the system and took the time to explain how a tankless water heater works. We will definitely continue to use them. They respond quickly, their technicians are knowledgeable, courteous and prompt and they are reasonably priced.</p>\n</div>\n\n                </div></div>\n                            <div  class=\"card card--google-review has-white-background-color has-black-color\">\n        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Robert Elliott\" aria-label=\"Robert Elliott\">Robert Elliott</p>\n            <div class=\"card__content__title__stars\">★★★★★</div>\n                    <div class=\"card__content__description card__description\">\n<p>The technician fixed the problem in no time and gave me a reasonable estimate for the full repairs. We have heat again and me and my pregnant wife couldn&#8217;t be happier! Definitely will stick with this service!</p>\n</div>\n\n                </div></div>\n                            <div  class=\"card card--google-review has-white-background-color has-black-color\">\n        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Mark Vogt\" aria-label=\"Mark Vogt\">Mark Vogt</p>\n            <div class=\"card__content__title__stars\">★★★★★</div>\n                    <div class=\"card__content__description card__description\">\n<p>These guys have become our Go-To HVAC &amp; Electrical contractors. Always perform outstanding service, quality &amp; support! Techs, Supervisors, &amp; Office personnel are very professional &amp; friendly.</p>\n</div>\n\n                </div></div>\n            </div>\n    <!-- ./ review carousel -->\n    <div class=\"nearu-carousel-controls\">\n\t<div class=\"nearu-carousel-button button-prev\">    <div class=\"iconblock\" data-size=\"lg\" data-padding=\"2\" data-display=\"block\">\n        <svg class=\"icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronleft\" /></svg>    </div>\n    </div>\n\t<div class=\"carousel-dots\"><div role=\"button\" aria-label=\"Go to slide 1 of 3\" data-nearu-carousel-dot-index=\"1\" class=\"carousel-dots__dot selected\"></div><div role=\"button\" aria-label=\"Go to slide 2 of 3\" data-nearu-carousel-dot-index=\"2\" class=\"carousel-dots__dot\"></div><div role=\"button\" aria-label=\"Go to slide 3 of 3\" data-nearu-carousel-dot-index=\"3\" class=\"carousel-dots__dot\"></div></div>\n<div class=\"nearu-carousel-button button-next\">    <div class=\"iconblock\" data-size=\"lg\" data-padding=\"2\" data-display=\"block\">\n        <svg class=\"icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronright\" /></svg>    </div>\n    </div>\n</div></div>\n<!-- ./ reviews body -->\n\n</div>\t</div>\n\t</article><!-- #post-972 -->"

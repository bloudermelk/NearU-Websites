  "html": "<article id=\"post-6046\" class=\"container post-6046 page type-page status-publish has-post-thumbnail hentry\">\n\n\t<div class=\"entry-content | container\">\n\t\t<section  class=\"container section--services-hero pt-5 services-hero hide-on-mobile\">\n\t<div class=\"section--services-hero__main\">\n\t\t<div class=\"section--services-hero__main__row\">\n\t\t\t<div class=\"section--services-hero__main__row__left\">\n                <div class=\"acf-innerblocks-container\">\n\n<div class=\"wp-block-group flow has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<div class=\"wp-block-group h-align is-layout-flex wp-block-group-is-layout-flex\">\n<h1 class=\"wp-block-heading has-secondary-color has-text-color has-link-color has-x-large-font-size wp-elements-1\">Special Offer: $59 Service Call Fee — Free with Any Service Over $250!</h1>\n</div>\n\n<div class=\"wp-block-group is-layout-flex wp-block-group-is-layout-flex\">\n<p class=\"wp-block-paragraph\"></p>\n</div>\n\n<div class=\"wp-block-group mb-3 is-content-justification-left is-nowrap is-layout-flex wp-container-core-group-is-layout-a1b15d37 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group full-width-mobile is-vertical is-content-justification-stretch is-layout-flex wp-container-core-group-is-layout-41171c72 wp-block-group-is-layout-flex\">\n<p class=\"horizon-text has-secondary-font-family wp-block-paragraph\" style=\"text-transform:uppercase\">Talk to a professional today</p>\n\n<a href=\"tel:+18643626329\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"icon\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-phone\" /></svg><span>(864) 362-6329</span>\n</a>\n\n<p class=\"text-center has-primary-color has-text-color has-link-color has-secondary-font-family has-small-font-size wp-elements-2 wp-block-paragraph\" style=\"text-transform:uppercase\"><strong>Same-day appointments available by phone</strong></p>\n\n<a href=\"/bookings\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta se-widget-button\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-tools\" /></svg><span >Schedule Service Now</span>\n\n</a></div>\n</div>\n</div>\n\n</div>\n\t\t\t</div><!-- ./left -->\n\t\t\t<div class=\"section--services-hero__main__row__right\">\n\t\t\t<div class=\"elevated content-fullbleed-mobile box-shadow-lg border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\t\t\t<figure class=\"wp-block-post-featured-image\"><img decoding=\"async\" width=\"1800\" height=\"1200\" src=\"/images/2024/02/indoor-air-quality-services-dehumidifiers.jpg\" class=\"attachment-full size-full\" alt=\"A father with his daughter on his shoulders, pretending to fly.\" srcset=\"/images/2024/02/indoor-air-quality-services-dehumidifiers.jpg 1800w, /images/2024/02/indoor-air-quality-services-dehumidifiers-300x200.jpg 300w, /images/2024/02/indoor-air-quality-services-dehumidifiers-1024x683.jpg 1024w, /images/2024/02/indoor-air-quality-services-dehumidifiers-768x512.jpg 768w, /images/2024/02/indoor-air-quality-services-dehumidifiers-1536x1024.jpg 1536w\" sizes=\"(max-width: 1800px) 100vw, 1800px\" /></figure>\n\t\t\t</div>\n</div>\t\t\t</div><!-- ./right -->\n\t\t</div><!-- ./row -->\n\n</div>\n\t<div class=\"section--services-hero__main section--services-hero__main--empty has-background has-secondary-background-color\">\n\t</div><!-- ./row -->\n\n</section>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<p class=\"wp-block-paragraph\">Take advantage of our limited-time promotion and save on your next service! Our $59 service call fee is <strong>completely waived</strong> when your service exceeds $250. Now is the perfect time to address any HVAC, plumbing, or electrical needs while saving money.</p>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<h3 class=\"wp-block-heading\"><strong>Why Choose This Offer?</strong></h3>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<ul class=\"wp-block-list\">\n<li><strong>Affordable Pricing:</strong> Reduce upfront costs with our waived service call fee for qualifying repairs or installations.</li>\n\n<li><strong>Trusted Professionals:</strong> Our licensed and certified technicians ensure top-notch service every time.</li>\n\n<li><strong>Fast Response:</strong> Same-day appointments are available to resolve your issues quickly and effectively.</li>\n</ul>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<h3 class=\"wp-block-heading\"><strong>Terms &amp; Conditions</strong></h3>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<p class=\"wp-block-paragraph\">*<strong>$59 Service Call Fee Waived</strong></p>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<p class=\"wp-block-paragraph\">No cash value. Offer valid only at <strong>Carolina Heating Service</strong> and limited to one coupon per customer. Applicable for residential properties only. The service fee will be waived when the service total is $250 or higher, excluding taxes and fees. Coupon must be presented at the time of purchase. This offer cannot be combined with other promotions, discounts, or offers. Offer expires December 16, 2024, and services must be booked and completed by this date. We reserve the right to cancel or modify this offer at any time. Appointment availability is subject to scheduling, and cancellation fees may apply for missed or rescheduled appointments.</p>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\t</div>\n\t</article><!-- #post-6046 -->"

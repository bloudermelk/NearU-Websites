  "html": "<article id=\"post-6226\" class=\"container post-6226 page type-page status-publish has-post-thumbnail hentry\">\n\n\t<div class=\"entry-content | container\">\n\t\t<section  class=\"container section--services-hero pt-5 services-hero\">\n\t<div class=\"section--services-hero__main\">\n\t\t<div class=\"section--services-hero__main__row\">\n\t\t\t<div class=\"section--services-hero__main__row__left\">\n                <div class=\"acf-innerblocks-container\">\n\n<div class=\"wp-block-group full-width-mobile is-vertical is-layout-flex wp-container-core-group-is-layout-2c90304e wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group flow center-content-mobile full-width-mobile has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<div class=\"wp-block-group h-align icon-plus-title is-layout-flex wp-block-group-is-layout-flex\">    <div class=\"iconblock wp-elements-1 has-background has-secondary-background-color has-text-color has-primary-inverse-color\" data-size=\"md\" data-padding=\"2\" data-display=\"inline\">\n        <svg class=\"icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-info\" /></svg>    </div>\n\n<h1 class=\"wp-block-heading has-secondary-color has-text-color has-link-color has-x-large-font-size wp-elements-2\"><strong>Careers at Carolina Heating Service</strong></h1>\n</div>\n\n<p class=\"wp-block-paragraph\">At Carolina Heating Service, we’re more than just your local HVAC experts—we’re your neighbors, dedicated to providing the highest quality service to keep your home comfortable year-round. From expertly trained technicians to responsive communication, we’re here to deliver peace of mind with every visit. Discover what sets us apart and why Greenville residents trust us for their heating, cooling, and generator needs.</p>\n\n<p class=\"wp-block-paragraph\">We have opportunities for skilled, experienced field team and office personnel. We offer excellent compensation packages, health benefits, company vehicle (field), and career advancement opportunities. Join an exceptional company with exceptional people that can furnish the right person an exciting and rewarding career.</p>\n</div>\n</div>\n\n<div style=\"height:30px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<a href=\"https://jobs.dayforcehcm.com/en-US/nearu/CarolinaHeating\" target=\"_blank\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"false\" class=\"cta\">\n    <span >View Open Positions</span>\n        <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronright\" /></svg>\n</a>\n</div>\n\t\t\t</div><!-- ./left -->\n\t\t\t<div class=\"section--services-hero__main__row__right\">\n\t\t\t<div class=\"elevated content-fullbleed-mobile box-shadow-lg border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\t\t\t<figure class=\"wp-block-post-featured-image\"><img decoding=\"async\" width=\"2560\" height=\"1710\" src=\"/images/2025/06/030624-CHS-3-scaled-1.webp\" class=\"attachment-post-thumbnail size-post-thumbnail wp-post-image\" alt=\"Carolina Heating Service Employees sitting around a table smiling\" style=\"object-fit:cover;\" srcset=\"/images/2025/06/030624-CHS-3-scaled-1.webp 2560w, /images/2025/06/030624-CHS-3-scaled-1-300x200.webp 300w, /images/2025/06/030624-CHS-3-scaled-1-1024x684.webp 1024w, /images/2025/06/030624-CHS-3-scaled-1-768x513.webp 768w, /images/2025/06/030624-CHS-3-scaled-1-1536x1026.webp 1536w, /images/2025/06/030624-CHS-3-scaled-1-2048x1368.webp 2048w\" sizes=\"(max-width: 1010px) 100vw, (max-width: 1440px) 50vw, 768px\" /></figure>\n\t\t\t</div>\n</div>\t\t\t</div><!-- ./right -->\n\t\t</div><!-- ./row -->\n\n</div>\n\t<div class=\"section--services-hero__main section--services-hero__main--empty has-background has-none-background-color\">\n\t</div><!-- ./row -->\n\n</section>\n\n<div style=\"height:80px\" ar
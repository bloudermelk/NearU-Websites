  "testimonials": [
    {
      "author": "Stephanie Buccolo",
      "rating": 5,
      "body": "Furnace stopped working unexpectedly two days before the holiday weekend and Carolina had a tech out right away. Had to order a new blower motor but expedited it and got it installed next day! Excellent communication and a big thanks to the tech who fit me into his already busy schedule."
    },
    {
      "author": "Sigrid McMahon",
      "rating": 5,
      "body": "Carolina Heating came out the very next day to attend to our problem and were thorough in solving it. Previously we called them for a tankless hot water heater that just stopped working. They came out that day, fixed the problem and did a complete maintenance of the system and took the time to explain how a tankless water heater works. We will definitely continue to use them. They respond quickly, their technicians are knowledgeable, courteous and prompt and they are reasonably priced."
    },
    {
      "author": "Robert Elliott",
      "rating": 5,
      "body": "The technician fixed the problem in no time and gave me a reasonable estimate for the full repairs. We have heat again and me and my pregnant wife couldn't be happier! Definitely will stick with this service!"
    }
  ],

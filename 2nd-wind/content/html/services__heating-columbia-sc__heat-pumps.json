ng 2048w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"135\" src=\"/images/2024/03/LG-logo-300x135.png\" class=\"logogrid-image\" alt=\"LG logo\" srcset=\"/images/2024/03/LG-logo-300x135.png 300w, /images/2024/03/LG-logo.png 556w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"167\" src=\"/images/2024/02/trane_logo-300x167.png\" class=\"logogrid-image\" alt=\"Trane Logo\" srcset=\"/images/2024/02/trane_logo-300x167.png 300w, /images/2024/02/trane_logo-768x427.png 768w, /images/2024/02/trane_logo.png 900w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"169\" src=\"/images/2024/02/Lennox-logo-300x169.png\" class=\"logogrid-image\" alt=\"Lennox logo\" srcset=\"/images/2024/02/Lennox-logo-300x169.png 300w, /images/2024/02/Lennox-logo-1024x576.png 1024w, /images/2024/02/Lennox-logo-768x432.png 768w, /images/2024/02/Lennox-logo-1536x864.png 1536w, /images/2024/02/Lennox-logo-2048x1152.png 2048w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"63\" src=\"/images/2024/03/Daikin-logo-300x63.png\" class=\"logogrid-image\" alt=\"Daikin logo\" srcset=\"/images/2024/03/Daikin-logo-300x63.png 300w, /images/2024/03/Daikin-logo-768x162.png 768w, /images/2024/03/Daikin-logo.png 1018w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"167\" src=\"/images/2024/02/york-install-confidence-vector-logo-300x167.png\" class=\"logogrid-image\" alt=\"York logo\" srcset=\"/images/2024/02/york-install-confidence-vector-logo-300x167.png 300w, /images/2024/02/york-install-confidence-vector-logo-768x427.png 768w, /images/2024/02/york-install-confidence-vector-logo.png 900w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"53\" src=\"/images/2024/03/Honeywell-logo-300x53.png\" class=\"logogrid-image\" alt=\"Honeywell logo\" srcset=\"/images/2024/03/Honeywell-logo-300x53.png 300w, /images/2024/03/Honeywell-logo-1024x181.png 1024w, /images/2024/03/Honeywell-logo-768x136.png 768w, /images/2024/03/Honeywell-logo.png 1413w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"225\" height=\"225\" src=\"/images/2024/02/rheem.png\" class=\"logogrid-image\" alt=\"Rheem logo\" srcset=\"/images/2024/02/rheem.png 225w, /images/2024/02/rheem-150x150.png 150w\" sizes=\"(max-width: 225px) 100vw, 225px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"76\" src=\"/images/2024/06/Tempstar-logo-300x76.jpg\" class=\"logogrid-image\" alt=\"Tempstar Heating and Cooling Products logo\" srcset=\"/images/2024/06/Tempstar-logo-300x76.jpg 300w, /images/2024/06/Tempstar-logo.jpg 568w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"88\" src=\"/images/2024/03/Mitsubishi-Electric-logo-300x88.png\" class=\"logogrid-image\" alt=\"Mitsubishi Electric logo\" srcset=\"/images/2024/03/Mitsubishi-Electric-logo-300x88.png 300w, /images/2024/03/Mitsubishi-Electric-logo-768x226.png 768w, /images/2024/03/Mitsubishi-Electric-logo.png 851w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n        </ul>\n</div>\n\n            <h6 class=\"wp-block-heading has-text-align-center\" style=\"text-transform:uppercase\">\n                And Dozens More\n            </h6></div>\n\n    </div>\n</div>\n\n<div  class=\"splitter-column splitter-column--right splitter-column--center py-3 has-custom-acf-color has-background has-secondary-background-color has-text-color has-secondary-inverse-color wp-elements-5\">\n    <div class=\"splitter-column-inner splitter-column-inner--contained splitter-column-inner--padded\">\n\n    <h2 class=\"wp-block-heading mb-3\">Qualified for All Major Makes and Models</h2>\n\n    <div class=\"wp-block-group flow mb-2 has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n    <p>Our team of expert technicians is trained to handle all makes and models of major brands with precision and care. From routine maintenance to complex repairs, we ensure top-notch service for all.</p>\n\n    </div>\n\n<div  class=\"iconlist\" data-orientation=\"vertical\" data-iconsize=\"md\">\n    <ul role=\"list\">\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-check\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p>Ensure optimal efficiency of all your systems</p>\n</p>\n            </div>\n        </li>\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-check\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p>Lower your utility costs with energy efficiency</p>\n</p>\n            </div>\n        </li>\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-check\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p>Extend your system’s lifespan through regular maintenance</p>\n</p>\n            </div>\n        </li>\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-check\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p>Keep you and your family comfortable and safe during all seasons</p>\n</p>\n            </div>\n        </li>\n            </ul>\n</div>\n    </div>\n</div>\n\n</div>\n<div id=\"FAQs\" class=\"wp-block-group py-5 flow has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading has-text-align-center\">FAQs</h2>\n\n<div  class=\"accordion\" style=\"--_accordion-separator-color: #1051a1\">\n            <details class=\"accordion-item\" data-custom-open=\"true\" open>\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Why is my heat pump blowing air that feels cool in winter?</p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p class=\"FirstParagraph\">Heat pump supply air runs cooler than furnace air by design, often around 90 to 100 degrees, which feels cool against skin but still heats the house. Air that is genuinely cold, or a house losing ground, points to a refrigerant or reversing valve problem worth diagnosing.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Why is there ice on my heat pump in winter?</p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p class=\"FirstParagraph\">Light frost is normal and the defrost cycle clears it. Ice that encases the coil or persists through defrost means a failing defrost control, low refrigerant, or airflow trouble, and running the unit that way damages the compressor.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">What does auxiliary heat mean on my thermostat?</p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p class=\"FirstParagraph\">It is the electric backup heat that assists the compressor during cold snaps or after big setback recoveries. Seeing it occasionally in January is normal. Seeing it constantly means the system&#8217;s settings or capacity need attention, because auxiliary heat is the most expensive heat in the house.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">How many years does a heat pump last in Columbia?</p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p class=\"FirstParagraph\">Ten to fifteen years is typical, and the year-round duty cycle is why maintenance matters. A heat pump here works roughly twice the annual hours of a furnace, so skipped tune-ups age it faster.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Can one heat pump replace both my furnace and my AC?</p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p class=\"FirstParagraph\">In most Midlands homes, yes. The heat pump handles cooling identically to an air conditioner and covers the heating season with supplemental heat for the coldest days. We confirm it with a load calculation before recommending the switch.</p>\n                </div>\n            </div>\n        </details>    </div>\n</div>\n\n<div id=\"maintenance-financing\" class=\"container splitter splitter--uniform-height-stick-last\" style=\"--CTX-container-split-size: 0.5\">\n\n<div  class=\"splitter-column splitter-column--left splitter-column--start wp-elements-6 has-background has-primary-background-color has-text-color has-primary-inverse-color\">\n    <div class=\"splitter-column-inner splitter-column-inner--contained splitter-column-inner--padded\">\n\n<div class=\"wp-block-group flow w100 has-global-padding is-layout-constrained wp-container-core-group-is-layout-2468f3b8 wp-block-group-is-layout-constrained\"><div class=\"elevated content-fullbleed-mobile w100 border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\n<figure class=\"wp-block-image size-full has-custom-border w100\"><img decoding=\"async\" width=\"1916\" height=\"1280\" src=\"/images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-technician-retreiving-an-item-from-a-service-truck.jpg\" alt=\"A 2nd Wind Heating and Air Conditioning technician retreiving an item from a service truck\" class=\"wp-image-5698\" style=\"border-radius:0px;object-fit:cover\" srcset=\"/images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-technician-retreiving-an-item-from-a-service-truck.jpg 1916w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-technician-retreiving-an-item-from-a-service-truck-300x200.jpg 300w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-technician-retreiving-an-item-from-a-service-truck-1024x684.jpg 1024w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-technician-retreiving-an-item-from-a-service-truck-768x513.jpg 768w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-technician-retreiving-an-item-from-a-service-truck-1536x1026.jpg 1536w\" sizes=\"(max-width: 1916px) 100vw, 1916px\" /></figure>\n\n</div>\n</div>\n\n<h2 class=\"wp-block-heading mt-3 has-primary-inverse-color has-text-color has-link-color wp-elements-7\">Need a Maintenance Plan?</h2>\n\n<ul class=\"wp-block-list\">\n<li>Prevent costly repairs with regular maintenance checks</li>\n\n<li>Ensure your systems are running efficiently year-round</li>\n\n<li>Extend the lifespan of your heating and cooling units</li>\n\n<li>Minimize the risk of unexpected breakdowns and emergencies</li>\n\n<li>Improve energy efficiency and lower utility bills</li>\n\n<li>Ensure the safety and reliability of your home's systems</li>\n</ul>\n\n<a href=\"/maintenance\" data-cta-gap=\"md\" data-cta-type=\"outline\" data-cta-content=\"mixed\" data-cta-minwidth=\"true\" class=\"cta full-width-mobile\">\n    <span >Learn More</span>\n        <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronright\" /></svg>\n</a></div>\n\n</div>\n</div>\n\n<div  class=\"splitter-column splitter-column--right splitter-column--start has-background has-primary-inverse-background-color\">\n    <div class=\"splitter-column-inner splitter-column-inner--contained splitter-column-inner--padded\">\n\n<div class=\"wp-block-group flow has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\"><div class=\"elevated content-fullbleed-mobile border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\n<figure class=\"wp-block-image size-full has-custom-border\"><img decoding=\"async\" width=\"1916\" height=\"1280\" src=\"/images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-employee-working-on-a-computer-while-on-the-telephone.jpg\" alt=\"A 2nd Wind Heating and Air Conditioning employee working on a computer while on the telephone\" class=\"wp-image-5693\" style=\"border-radius:0px\" srcset=\"/images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-employee-working-on-a-computer-while-on-the-telephone.jpg 1916w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-employee-working-on-a-computer-while-on-the-telephone-300x200.jpg 300w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-employee-working-on-a-computer-while-on-the-telephone-1024x684.jpg 1024w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-employee-working-on-a-computer-while-on-the-telephone-768x513.jpg 768w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-employee-working-on-a-computer-while-on-the-telephone-1536x1026.jpg 1536w\" sizes=\"(max-width: 1916px) 100vw, 1916px\" /></figure>\n\n</div>\n</div>\n\n<h2 class=\"wp-block-heading mt-3\">Ask Us About Financing!</h2>\n\n<p class=\"mb-3 wp-block-paragraph\">Financing plans bring value and benefits to homeowners. By opting for a financing option, you can tackle necessary repairs or upgrades without draining your savings or delaying important projects. Here are some key advantages:</p>\n\n<ul class=\"mb-3 wp-block-list\">\n<li>Budget-Friendly</li>\n\n<li>Access to Quality Services</li>\n\n<li>Timely Repairs</li>\n\n<li>Flexibility</li>\n\n<li>Increase Home Value</li>\n\n<li>Emergency Protection</li>\n</ul>\n\n<p class=\"mb-3 mt-0 wp-block-paragraph\">Keep your home safe and comfortable with a finance plan. Always assess terms and interest rates to find the best one for your needs. A professional can help you make an informed decision.</p>\n\n<a href=\"/financing\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta full-width-mobile\">\n    <span >Learn More</s
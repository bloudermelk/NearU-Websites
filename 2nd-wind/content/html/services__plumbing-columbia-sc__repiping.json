\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"167\" src=\"/images/2024/02/york-install-confidence-vector-logo-300x167.png\" class=\"logogrid-image\" alt=\"York logo\" srcset=\"/images/2024/02/york-install-confidence-vector-logo-300x167.png 300w, /images/2024/02/york-install-confidence-vector-logo-768x427.png 768w, /images/2024/02/york-install-confidence-vector-logo.png 900w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"53\" src=\"/images/2024/03/Honeywell-logo-300x53.png\" class=\"logogrid-image\" alt=\"Honeywell logo\" srcset=\"/images/2024/03/Honeywell-logo-300x53.png 300w, /images/2024/03/Honeywell-logo-1024x181.png 1024w, /images/2024/03/Honeywell-logo-768x136.png 768w, /images/2024/03/Honeywell-logo.png 1413w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"225\" height=\"225\" src=\"/images/2024/02/rheem.png\" class=\"logogrid-image\" alt=\"Rheem logo\" srcset=\"/images/2024/02/rheem.png 225w, /images/2024/02/rheem-150x150.png 150w\" sizes=\"(max-width: 225px) 100vw, 225px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"76\" src=\"/images/2024/06/Tempstar-logo-300x76.jpg\" class=\"logogrid-image\" alt=\"Tempstar Heating and Cooling Products logo\" srcset=\"/images/2024/06/Tempstar-logo-300x76.jpg 300w, /images/2024/06/Tempstar-logo.jpg 568w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"88\" src=\"/images/2024/03/Mitsubishi-Electric-logo-300x88.png\" class=\"logogrid-image\" alt=\"Mitsubishi Electric logo\" srcset=\"/images/2024/03/Mitsubishi-Electric-logo-300x88.png 300w, /images/2024/03/Mitsubishi-Electric-logo-768x226.png 768w, /images/2024/03/Mitsubishi-Electric-logo.png 851w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n        </ul>\n</div>\n\n            <h6 class=\"wp-block-heading has-text-align-center\" style=\"text-transform:uppercase\">\n                And Dozens More\n            </h6></div>\n\n    </div>\n</div>\n\n<div  class=\"splitter-column splitter-column--right splitter-column--center py-3 has-custom-acf-color has-background has-secondary-background-color has-text-color has-secondary-inverse-color wp-elements-5\">\n    <div class=\"splitter-column-inner splitter-column-inner--contained splitter-column-inner--padded\">\n\n    <h2 class=\"wp-block-heading mb-3\">Qualified for All Major Makes and Models</h2>\n\n    <div class=\"wp-block-group flow mb-2 has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n    <p>Our team of expert technicians is trained to handle all makes and models of major brands with precision and care. From routine maintenance to complex repairs, we ensure top-notch service for all.</p>\n\n    </div>\n\n<div  class=\"iconlist\" data-orientation=\"vertical\" data-iconsize=\"md\">\n    <ul role=\"list\">\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-check\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p>Ensure optimal efficiency of all your systems</p>\n</p>\n            </div>\n        </li>\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-check\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p>Lower your utility costs with energy efficiency</p>\n</p>\n            </div>\n        </li>\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-check\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p>Extend your system’s lifespan through regular maintenance</p>\n</p>\n            </div>\n        </li>\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-check\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p>Keep you and your family comfortable and safe during all seasons</p>\n</p>\n            </div>\n        </li>\n            </ul>\n</div>\n    </div>\n</div>\n\n</div>\n<div id=\"FAQs\" class=\"wp-block-group py-5 flow has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading has-text-align-center\">FAQs</h2>\n\n<div  class=\"accordion\" style=\"--_accordion-separator-color: \">\n            <details class=\"accordion-item\" data-custom-open=\"true\" open>\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">How do I know if my home has polybutylene piping?</p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p class=\"FirstParagraph\">Look for gray plastic pipe, often marked PB2110, at the water heater, under sinks, or in the crawl space, common in homes built or replumbed between the late 1970s and mid 1990s. We confirm the material during an inspection and show you what we find.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">How long does a whole-home repipe take?</p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p class=\"FirstParagraph\">Most single-family repipes run two to five days of plumbing work depending on size and access, with water restored each evening in a well-planned job. Drywall repair afterward is a separate, scheduled step.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Does repiping mean tearing out all my walls?</p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p class=\"FirstParagraph\">No. Modern repiping opens access points at fixtures and key runs rather than stripping walls. PEX in particular routes through existing cavities, which keeps openings small, planned, and listed before work begins.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Will repiping fix my low water pressure?</p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p class=\"FirstParagraph\">If the cause is corroded galvanized pipe narrowing the lines, yes, and the difference is immediate. If the cause is the pressure regulator or the utility supply, repiping alone will not, which is why we measure pressure as part of the evaluation.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Is gray polybutylene an insurance problem even before it fails?</p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p class=\"FirstParagraph\">Many insurers surcharge or decline homes with polybutylene because its failure history is documented. Replacing it removes both the flood risk and the underwriting problem, and we provide documentation of the completed repipe.</p>\n                </div>\n            </div>\n        </details>    </div>\n</div>\n\n<div id=\"maintenance-financing\" class=\"container splitter splitter--uniform-height-stick-last\" style=\"--CTX-container-split-size: 0.5\">\n\n<div  class=\"splitter-column splitter-column--left splitter-column--start wp-elements-6 has-background has-primary-background-color has-text-color has-primary-inverse-color\">\n    <div class=\"splitter-column-inner splitter-column-inner--contained splitter-column-inner--padded\">\n\n<div class=\"wp-block-group flow w100 has-global-padding is-layout-constrained wp-container-core-group-is-layout-2468f3b8 wp-block-group-is-layout-constrained\"><div class=\"elevated content-fullbleed-mobile w100 border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\n<figure class=\"wp-block-image size-full has-custom-border w100\"><img decoding=\"async\" width=\"1916\" height=\"1280\" src=\"/images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-technician-retreiving-an-item-from-a-service-truck.jpg\" alt=\"A 2nd Wind Heating and Air Conditioning technician retreiving an item from a service truck\" class=\"wp-image-5698\" style=\"border-radius:0px;object-fit:cover\" srcset=\"/images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-technician-retreiving-an-item-from-a-service-truck.jpg 1916w, /images/2024/06/A-2nd-Wind-Heating-and-Air-Conditioning-technician-retreiving-an-item-from-a-servi
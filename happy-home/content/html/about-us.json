for better visibility */\n      border-radius: 10px;\n      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);\n    }\n  </style>\n\n  <div class=\"map-container\">\n    <h2>We Serve the Entire Research Triangle!</h2>\n    <div id=\"map\"></div> <!-- Map loads here -->\n  </div>\n\n  <!-- Load Google Maps API and Initialize Map -->\n  <script>\n    function initMap() {\n      // Set center coordinates and zoom level\n      var map = new google.maps.Map(document.getElementById(\"map\"), {\n        center: { lat: 35.012385, lng: -78.918142}, // Adjusted center\n        zoom: 12, // Increased zoom level for closer view\n        mapTypeId: \"roadmap\"\n      });\n\n      // Load KML Layer from Google My Maps\n      var kmlLayer = new google.maps.KmlLayer({\n        url: \"https://www.google.com/maps/d/u/0/kml?mid=1kW1iyV3fr9_B2ohD2V1VDLk-o3_adIg\", // Updated KML link\n        map: map\n      });\n\n      // Handle errors if the KML layer fails to load\n      google.maps.event.addListener(kmlLayer, 'status_changed', function() {\n        if (kmlLayer.getStatus() !== 'OK') {\n          alert(\"Failed to load the map. Make sure the KML file is publicly accessible.\");\n        }\n      });\n    }\n  </script>\n\n  <!-- Google Maps API Script with your API Key -->\n  <script async defer src=\"https://maps.googleapis.com/maps/api/js?key=AIzaSyAkoAqb9urO5Kv96nPMn3tEIGRUtWvSwuc&#038;callback=initMap\"></script>\n\n</div>\n</div>\n\n</div></div>\n\n<div class=\"wp-block-group container flow py-5\">\n<h2 class=\"wp-block-heading\">Powered by NearU — We’re here to make your HVAC Service experience the best one yet!</h2>\n\n<figure class=\"wp-block-image size-full is-resized\"><img loading=\"lazy\" decoding=\"async\" width=\"430\" height=\"98\" src=\"/images/2024/02/NearU.png\" alt=\"NearU\" class=\"wp-image-36\" style=\"width:220px;height:auto\" srcset=\"/images/2024/02/NearU.png 430w, /images/2024/02/NearU-300x68.png 300w\" sizes=\"(max-width: 430px) 100vw, 430px\" /></figure>\n\n<p class=\"wp-block-paragraph\">NearU is setting up a new standard of HVAC, plumbing, drains, IAQ, and generator services with major improvements to reliability, convenience, and customer care. We equip our companies with better resources, training, and tools, so they can provide you with the best possible service outcome. If you’ve recently learned that your go-to HVAC, plumbing, drains, IAQ, and generator company has joined NearU, then this is something to get excited about! We protect the people and culture that make each company great, while ensuring their customers consistently receive the best possible care.</p>\n</div>\n\t</div>\n\t</article><!-- #post-65 -->"

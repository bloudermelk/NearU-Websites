  "html": "<article id=\"post-5848\" class=\"container post-5848 page type-page status-publish has-post-thumbnail hentry\">\n\n\t<div class=\"entry-content | container\">\n\t\t<section  class=\"container section--services-hero pt-5 services-hero\">\n\t<div class=\"section--services-hero__main\">\n\t\t<div class=\"section--services-hero__main__row\">\n\t\t\t<div class=\"section--services-hero__main__row__left\">\n                <div class=\"acf-innerblocks-container\">\n\n<div class=\"wp-block-group full-width-mobile is-vertical is-layout-flex wp-container-core-group-is-layout-2c90304e wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group h-align is-nowrap is-layout-flex wp-container-core-group-is-layout-7387b849 wp-block-group-is-layout-flex\">    <div class=\"iconblock wp-elements-1 has-background has-secondary-background-color has-text-color has-primary-inverse-color\" data-size=\"md\" data-padding=\"2\" data-display=\"inline\">\n        <svg class=\"icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-money\" /></svg>    </div>\n\n<h1 class=\"wp-block-heading has-secondary-active-color has-text-color has-link-color has-x-large-font-size wp-elements-2\">HVAC Heating Financing Options with Happy Home Services</h1>\n</div>\n\n<div class=\"wp-block-group my-3 is-layout-flex wp-block-group-is-layout-flex\">\n<p class=\"wp-block-paragraph\">At Happy Home Services, we know that upgrading your HVAC system is a significant decision. That’s why we offer <strong>flexible financing options</strong> to help you invest in reliable heating solutions without stress. Whether you’re replacing an outdated furnace or installing an energy-efficient heat pump, our financing plans make it easier than ever to bring comfort and warmth to your home. Contact Happy Home Services today to learn more about our HVAC financing options and start enjoying the benefits of a new system.</p>\n</div>\n\n<div class=\"wp-block-group mb-3 is-content-justification-left is-nowrap is-layout-flex wp-container-core-group-is-layout-a1b15d37 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group full-width-mobile is-vertical is-content-justification-stretch is-layout-flex wp-container-core-group-is-layout-41171c72 wp-block-group-is-layout-flex\">\n<p class=\"horizon-text full-width-mobile has-secondary-font-family wp-block-paragraph\" style=\"text-transform:uppercase\">Speak with an expert</p>\n\n<a href=\"tel:+13362819025\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"icon\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta full-width-mobile\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-phone\" /></svg><span>(336) 281-9025</span>\n</a>\n\n<p class=\"text-center has-primary-color has-text-color has-link-color has-secondary-font-family has-small-font-size wp-elements-3 wp-block-paragraph\" style=\"text-transform:uppercase\"><strong>Same day appointments available by phone</strong></p>\n</div>\n</div>\n</div>\n\n</div>\n\t\t\t</div><!-- ./left -->\n\t\t\t<div class=\"section--services-hero__main__row__right\">\n\t\t\t<div class=\"elevated content-fullbleed-mobile box-shadow-lg border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\t\t\t<figure class=\"wp-block-post-featured-image\"><img decoding=\"async\" width=\"600\" height=\"427\" src=\"/images/2024/11/img-heat-pump-rev.png\" class=\"attachment-post-thumbnail size-post-thumbnail wp-post-image\" alt=\"\" style=\"object-fit:cover;\" srcset=\"/images/2024/11/img-heat-pump-rev.png 600w, /images/2024/11/img-heat-pump-rev-300x214.png 300w\" sizes=\"(max-width: 1010px) 100vw, (max-width: 1440px) 50vw, 768px\" /></figure>\n\t\t\t</div>\n</div>\t\t\t</div><!-- ./right -->\n\t\t</div><!-- ./row -->\n\n</div>\n\t<div class=\"section--services-hero__main section--services-hero__main--empty has-background has-secondary-background-color\">\n\t</div><!-- ./row -->\n\n</section>\n\n<div class=\"wp-block-group container pb-5 flow has-primary-inverse-color has-secondary-background-color has-text-color has-background has-link-color wp-elements-4\">\n<div style=\"height:1rem\" aria-hidden=\"true\" class=\"wp-block-spacer d-block d-md-none\"></div>\n\n<h2 class=\"wp-block-heading has-secondary-inverse-color has-text-color has-link-color wp-elements-5\">Affordable Heating Financing Solutions</h2>\n\n<p class=\"has-secondary-inverse-color has-text-color has-link-color wp-elements-6 wp-block-paragraph\">Happy Home Services&#8217; flexible financing plans help you bring modern, energy-efficient heating to your home without breaking your budget. With options tailored to fit your financial needs, you can enjoy the comfort of a new HVAC system while spreading the cost over time. Our financing options are designed with convenience in mind, offering simple application processes, competitive rates, and online account management. Speak with us today to explore your options.</p>\n\n<div class=\"wp-block-group multi-component-container multi-component-container--2-up multi-component-container--uniform-height has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\"><div  class=\"card flow  wp-elements-7 has-white-background-color has-text-color has-black-color\" style=\"padding-top:1.33rem;padding-bottom:1.33rem;padding-left:1.33rem;padding-right:1.33rem;\">\n            <div class=\"acf-innerblocks-container\">\n\n<figure class=\"wp-block-image aligncenter size-full is-resized\"><img decoding=\"async\" width=\"396\" height=\"162\" src=\"/images/ext/2ndwindhvac.com/2024/02/Financing-Greensky-logo.jpg\" alt=\"Greensky logo\" class=\"wp-image-17\" style=\"width:222px;height:auto\" srcset=\"/images/2024/02/Financing-Greensky-logo.jpg 396w, /images/2024/02/Financing-Greensky-logo-300x123.jpg 300w\" sizes=\"(max-width: 396px) 100vw, 396px\" /></figure>\n\n<h3 class=\"wp-block-heading has-text-align-center\"><strong><strong>No Interest if Paid in Full in 18 Months</strong></strong></h3>\n\n<p class=\"has-text-align-center wp-block-paragraph\">Subject to credit approval. Minimum monthly payments required. Interest is billed during the promotional period but all interest is waived if the purchase is paid in full within the first 18 months. Making minimum monthly payments will not pay off the entire purchase balance before the end of the promotional period.</p>\n\n<a href=\"https://projects.greensky.com/merchantloanapplication?apptype=short&#038;merchant=81086633&#038;dealerplan=2631&#038;channel=External-Button-03\" target=\"_blank\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"false\" class=\"cta align-self-right\">\n    <span >Go to Greensky</span>\n        <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronright\" /></svg>\n</a>\n</div>\n    </div>\n\n<div  class=\"card flow  wp-elements-8 has-white-background-color has-text-color has-black-color\" style=\"padding-top:1.33rem;padding-bottom:1.33rem;padding-left:1.33rem;padding-right:1.33rem;\">\n            <div class=\"acf-innerblocks-container\">\n\n<figure class=\"wp-block-image aligncenter size-full is-resized\"><img decoding=\"async\" width=\"396\" height=\"162\" src=\"/images/ext/2ndwindhvac.com/2024/02/Financing-Greensky-logo.jpg\" alt=\"Greensky logo\" class=\"wp-image-17\" style=\"width:222px;height:auto\" srcset=\"/images/2024/02/Financing-Greensky-logo.jpg 396w, /images/2024/02/Financing-Greensky-logo-300x123.jpg 300w\" sizes=\"(max-width: 396px) 100vw, 396px\" /></figure>\n\n<h3 class=\"wp-block-heading has-text-align-center\"><strong><strong>Reduced Rate 0% for 6 Months</strong></strong></h3>\n\n<p class=\"has-text-align-center wp-block-paragraph\">Subject to credit approval. 6 month purchase window. 0.00% interest rate during 6 month promotional period followed by fixed interest rate of 9.99% for 120 months. Payment example assumes one-time $10,000 purchase on approval date (8.9% APR) with 6 months of $0.00 payments followed by 120 amortized payments of $132.10.</p>\n\n<a href=\"https://projects.greensky.com/merchantloanapplication?apptype=short&#038;merchant=81086633&#038;dealerplan=1069&#038;channel=External-Button-03\" target=\"_blank\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"false\" class=\"cta align-self-right\">\n    <span >Go to Greensky</span>\n        <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronright\" /></svg>\n</a>\n</div>\n    </div></div>\n\n<div class=\"wp-block-group multi-component-container multi-component-container--2-up multi-component-container--uniform-height has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\"><div  class=\"card flow  wp-elements-9 has-white-background-color has-text-color has-black-color\" style=\"padding-top:1.33rem;padding-bottom:1.33rem;padding-left:1.33rem;padding-right:1.33rem;\">\n            <div class=\"acf-innerblocks-container\">\n\n<figure class=\"wp-block-image aligncenter size-full is-resized\"><img decoding=\"async\" width=\"396\" height=\"162\" src=\"/images/ext/2ndwindhvac.com/2024/02/Financing-Greensky-logo.jpg\" alt=\"Greensky logo\" class=\"wp-image-17\" style=\"width:222px;height:auto\" srcset=\"/images/2024/02/Financing-Greensky-logo.jpg 396w, /images/2024/02/Financing-Greensky-logo-300x123.jpg 300w\" sizes=\"(max-width: 396px) 100vw, 396px\" /></figure>\n\n<h3 class=\"wp-block-heading has-text-align-center\"><strong><strong>Reduced Rate of 7.99% for 180 Months!</strong></strong></h3>\n\n<p class=\"has-text-align-center wp-block-paragraph\">Subject to credit approval. Fixed APR of 7.99% for 180 months. Payment example: for $10,000 purchase on approval date, 180 payments of $95.50.</p>\n\n<a href=\"https://projects.greensky.com/merchantloanapplication?apptype=short&#038;merchant=81086633&#038;dealerplan=1579&#038;channel=External-Button-03\" target=\"_blank\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"false\" class=\"cta align-self-right\">\n    <span >Go to Greensky</span>\n        <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronright\" /></svg>\n</a>\n</div>\n    </div>\n\n<div  class=\"card flow  wp-elements-10 has-white-background-color has-text-color has-black-color\" style=\"padding-top:1.33rem;padding-bottom:1.33rem;padding-left:1.33rem;padding-right:1.33rem;\">\n            <div class=\"acf-innerblocks-container\">\n\n<figure class=\"wp-block-image aligncenter size-full is-resized\"><img decoding=\"async\" width=\"396\" height=\"162\" src=\"/images/ext/2ndwindhvac.com/2024/02/Financing-Greensky-logo.jpg\" alt=\"Greensky logo\" class=\"wp-image-17\" style=\"width:222px;height:auto\" srcset=\"/images/2024/02/Financing-Greensky-logo.jpg 396w, /images/2024/02/Financing-Greensky-logo-300x123.jpg 300w\" sizes=\"(max-width: 396px) 100vw, 396px\" /></figure>\n\n<h3 class=\"wp-block-heading has-text-align-center\"><strong><strong>Reduced Rate of 6.99% for 60 Months</strong></strong></h3>\n\n<p class=\"has-text-align-center wp-block-paragraph\">Subject to credit approval. Fixed APR of 6.99% for 60 months. Payment example: for $10,000 purchase on approval date, 60 payments of $197.96.</p>\n\n<a href=\"https://projects.greensky.com/merchantloanapplication?apptype=short&#038;merchant=81086633&#038;dealerplan=2716&#038;channel=External-Button-03\" target=\"_blank\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"false\" class=\"cta align-self-right\">\n    <span >Go to Greensky</span>\n        <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronright\" /></svg>\n</a>\n</div>\n    </div></div>\n\n<div class=\"wp-block-group multi-component-container multi-component-container--2-up multi-component-container--uniform-height has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\"><div  class=\"card flow  wp-elements-11 has-white-background-color has-text-color has-black-color\" style=\"padding-top:1.33rem;padding-bottom:1.33rem;padding-left:1.33rem;padding-right:1.33rem;\">\n            <div class=\"acf-innerblocks-container\">\n\n<figure class=\"wp-block-image aligncenter size-full is-resized\"><img decoding=\"async\" width=\"327\" height=\"95\" src=\"/images/2024/02/Goodleap-Logo-Financial-Provider.jpg\" alt=\"Goodleap logo\" class=\"wp-image-3201\" style=\"width:222px;height:auto\" srcset=\"/images/2024/02/Goodleap-Logo-Financial-Provider.jpg 327w, /images/2024/02/Goodleap-Logo-Financial-Provider-300x87.jpg 300w\" sizes=\"(max-width: 327px) 100vw, 327px\" /></figure>\n\n<h3 class=\"wp-block-heading has-text-align-center\"><strong>Monthly Payments to Fit your Budget!</strong></h3>\n\n<p class=\"has-text-align-center wp-block-paragraph\">Special terms and promotions available. Online account management and bill payment options. View details on the Upgrade site.</p>\n\n<a href=\"tel:+13362819025\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"false\" class=\"cta align-self-right\">\n    <span >Call Now</span>\n        <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronright\" /></svg>\n</a>\n</div>\n    </div></div>\n</div>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<h2 class=\"wp-block-heading\">Flexible Financing for Heating Services with Happy Home Services</h2>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<p class=\"wp-block-paragraph\">At Happy Home Services, we understand that investing in a new heating system is a significant decision. Whether you’re replacing an outdated furnace, upgrading to a heat pump, or installing a cutting-edge geothermal system, our&nbsp;<strong>flexible financing options</strong>&nbsp;make it easy to bring efficient, reliable heating to your home. Serving Durham and the surrounding areas, we’re here to provide the support you need to make a confident, informed decision.</p>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<h2 class=\"wp-block-heading\">Financing for Furnace Installation</h2>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<p class=\"wp-block-paragraph\">Furnaces are an essential part of keeping your home warm during colder months. With our financing options, you can spread the cost of installation over time while enjoying the immediate comfort of a new system. Here’s what you can expect:</p>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<h3 class=\"wp-block-heading\">Electric Furnace</h3>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<ul class=\"wp-block-list\">\n<li>Cost: $2,000 – $6,300</li>\n\n<li>Benefits: Affordable and environmentally friendly, electric furnaces are easy to maintain and can last up to 30 years! While their operating costs may be higher due to electricity rates, their long lifespan and lower maintenance needs make them a popular option.</li>\n\n<li>Ideal For: Homes with access to affordable electricity.</li>\n</ul>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<h3 class=\"wp-block-heading\">Natural Gas Furnace</h3>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<ul class=\"wp-block-list\">\n<li><strong>Cost:</strong>&nbsp;$3,500 – $9,000</li>\n\n<li><strong>Benefits:</strong>&nbsp;Known for their energy efficiency and consistent heat output, natural gas furnaces offer long-term savings on energy costs.</li>\n\n<li><strong>Ideal For:</strong>&nbsp;Homes in colder climates with access to natural gas.</li>\n</ul>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<h3 class=\"wp-block-heading\">Oil Furnace</h3>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<ul class=\"wp-block-list\">\n<li><strong>Cost:</strong>&nbsp;$6,000 – $10,000</li>\n\n<li><strong>Benefits:</strong>&nbsp;Durable and capable of generating heat quickly, oil furnaces are suitable for homes in areas without access to natural gas. However, they come with higher operating costs and require proper ventilation to ensure safety.</li>\n\n<li><strong>Ideal For:</strong>&nbsp;Homes without natural gas lines that need powerful heating capabilities.</li>\n</ul>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<h2 class=\"wp-block-heading\">Financing for Heat Pump Installation</h2>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<p class=\"wp-block-paragraph\">Heat pumps offer a versatile, energy-efficient alternative to traditional furnaces. While they have a higher upfront cost, their long-term savings and eco-friendly operation make them an excellent investment. Our financing options make it easy to upgrade to the latest in heating technology.</p>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<h3 class=\"wp-block-heading\">Ductless Mini-Split Heat Pump</h3>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<ul class=\"wp-block-list\">\n<li><strong>Cost:</strong>&nbsp;$2,000 – $14,000</li>\n\n<li><strong>Benefits:</strong>&nbsp;Perfect for homes without ductwork, these highly energy-efficient units offer zone-specific heating and cooling to reduce energy bills.</li>\n\n<li><strong>Ideal For:</strong>&nbsp;Homes seeking ductless heating and cooling solutions.</li>\n</ul>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<h3 class=\"wp-block-heading\">Dual Fuel or Hybrid Heat Pump</h3>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<ul class=\"wp-block-list\">\n<li><strong>Cost:</strong>&nbsp;$3,000 – $15,000</li>\n\n<li><strong>Benefits:</strong>&nbsp;These systems switch between gas and electric heating, optimizing efficiency based on outdoor temperatures for cost savings over time.</li>\n\n<li><strong>Ideal For:</strong>&nbsp;Homeowners looking for energy efficiency and flexibility in fluctuating climates.</li>\n</ul>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<h3 class=\"wp-block-heading\">Gas-Fired Heat Pump</h3>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<ul class=\"wp-block-list\">\n<li><strong>Cost:</strong>&nbsp;$4,000 – $10,000</li>\n\n<li><strong>Benefits:</strong>&nbsp;A robust heating solution for larger homes, gas-fired units offer dependable performance but may not be as energy-efficient as hybrid systems.</li>\n\n<li><strong>Ideal For:</strong>&nbsp;Larger homes or commercial buildings over 4,000 square feet.</li>\n</ul>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<h3 class=\"wp-block-heading\">Air-Source Heat Pump</h3>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<ul class=\"wp-block-list\">\n<li><strong>Cost:</strong>&nbsp;$5,000 – $14,000</li>\n\n<li><strong>Benefits:</strong>&nbsp;These systems extract heat from outdoor air and are highly efficient, offering significant savings on energy bills. However, their performance may be limited in extremely cold climates.</li>\n\n<li><strong>Ideal For:</strong>&nbsp;Moderate climates with homeowners looking to reduce energy costs.</li>\n</ul>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<h3 class=\"wp-block-heading\">Geothermal Heat Pump</h3>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<ul class=\"wp-block-list\">\n<li><strong>Cost:</strong>&nbsp;$10,000 – $35,000</li>\n\n<li><strong>Benefits:</strong>&nbsp;One of the most energy-efficient and environmentally friendly systems available, geothermal units provide substantial long-term savings with minimal maintenance.</li>\n\n<li><strong>Ideal For:</strong>&nbsp;Eco-conscious homeowners seeking the ultimate in efficiency and longevity.</li>\n</ul>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<h2 class=\"wp-block-heading\">Why Choose Happy Home Services for Your Heating System Financing?</h2>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<figure class=\"wp-block-table\"><table><tbody><tr><td><strong>Benefit</strong></td><td><strong>Description</strong></td></tr><tr><td>Affordable Plans</td><td>Our flexible financing options make it easy to manage the cost of any heating system installation.</td></tr><tr><td>Expert Guidance</td><td>Our team will help you select the right system for your home and budget, ensuring your investment meets your needs.</td></tr><tr><td>Trusted Service Area</td><td>Proudly serving the entire Durham area, we’re committed to keeping our community warm and comfortable.</td></tr><tr><td>Energy Savings</td><td>Many of our systems are designed to reduce energy consumption, saving you money over time.</td></tr></tbody></table></figure>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<h2 class=\"wp-block-heading\">Get Started Today</h2>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<p class=\"wp-block-paragraph\">Don’t let upfront costs keep you from the comfort your home deserves. With Happy Home Services&nbsp;<strong>financing solutions for heating services</strong>, you can upgrade to a high-efficiency furnace or heat pump without financial stress. Contact us today to schedule a consultation and learn more about how we can make your home more comfortable and energy-efficient—one affordable payment at a time.</p>\n\n<div style=\"height:15px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\t</div>\n\t</article><!-- #post-5848 -->"
}
class=\"splitter-column splitter-column--right splitter-column--stretch\">\n    <div class=\"splitter-column-inner\">\n\n<style>\n    /* Centering container */\n    .map-container {\n      max-width: 900px;\n      margin: 0 auto;\n      padding: 0 1rem;\n      text-align: center;\n    }\n\n    /* Responsive Map */\n    #map {\n      width: 100%;\n      height: 600px; /* Adjusted for better visibility */\n      border-radius: 10px;\n      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);\n    }\n  </style>\n\n  <div class=\"map-container\">\n    <h2>We Serve the Entire Research Triangle!</h2>\n    <div id=\"map\"></div> <!-- Map loads here -->\n  </div>\n\n  <!-- Load Google Maps API and Initialize Map -->\n  <script>\n    function initMap() {\n      // Set center coordinates and zoom level\n      var map = new google.maps.Map(document.getElementById(\"map\"), {\n        center: { lat: 35.012385, lng: -78.918142}, // Adjusted center\n        zoom: 12, // Increased zoom level for closer view\n        mapTypeId: \"roadmap\"\n      });\n\n      // Load KML Layer from Google My Maps\n      var kmlLayer = new google.maps.KmlLayer({\n        url: \"https://www.google.com/maps/d/u/0/kml?mid=1kW1iyV3fr9_B2ohD2V1VDLk-o3_adIg\", // Updated KML link\n        map: map\n      });\n\n      // Handle errors if the KML layer fails to load\n      google.maps.event.addListener(kmlLayer, 'status_changed', function() {\n        if (kmlLayer.getStatus() !== 'OK') {\n          alert(\"Failed to load the map. Make sure the KML file is publicly accessible.\");\n        }\n      });\n    }\n  </script>\n\n  <!-- Google Maps API Script with your API Key -->\n  <script async defer src=\"https://maps.googleapis.com/maps/api/js?key=AIzaSyAkoAqb9urO5Kv96nPMn3tEIGRUtWvSwuc&#038;callback=initMap\"></script>\n\n</div>\n</div>\n\n</div>\n\n<div id=\"maintenance-financing\" class=\"container splitter splitter--uniform-height-stick-last\" style=\"--CTX-container-split-size: 0.5\">\n\n<div  class=\"splitter-colu
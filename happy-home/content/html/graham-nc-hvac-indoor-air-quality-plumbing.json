  "html": "<article id=\"post-6724\" class=\"container post-6724 page type-page status-publish has-post-thumbnail hentry\">\n\n\t<div class=\"entry-content | container\">\n\t\t<section  class=\"container section--services-hero pt-5 services-hero\">\n\t<div class=\"section--services-hero__main\">\n\t\t<div class=\"section--services-hero__main__row\">\n\t\t\t<div class=\"section--services-hero__main__row__left\">\n                <div class=\"acf-innerblocks-container\">\n\n<div class=\"wp-block-group full-width-mobile is-vertical is-layout-flex wp-container-core-group-is-layout-2c90304e wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group flow center-content-mobile full-width-mobile has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<div class=\"wp-block-group h-align icon-plus-title is-layout-flex wp-block-group-is-layout-flex\">    <div class=\"iconblock wp-elements-1 has-background has-red-background-color has-text-color has-secondary-inverse-color\" data-size=\"md\" data-padding=\"2\" data-display=\"inline\">\n        <svg class=\"icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-info\" /></svg>    </div>\n\n<h1 class=\"wp-block-heading has-primary-inverse-color has-text-color has-link-color has-x-large-font-size wp-elements-2\">HVAC, Plumbing &amp; Indoor Air Quality Services in Graham, NC&nbsp;</h1>\n</div>\n\n<p class=\"wp-block-paragraph\">Happy Home Services covers heating and cooling, plumbing, and indoor air quality for Graham and central Alamance County, pricing every job before it starts and answering calls 24/7. The blocks around the courthouse square hold some of the county&#8217;s oldest homes, and the subdivisions spreading outward hold some of its newest, which keeps our Graham workload varied.&nbsp;</p>\n\n<p class=\"wp-block-paragraph\">Historic homes near Court Square bring the classic old-house service profile: retrofitted&nbsp;heating,&nbsp;duct runs added long after construction, and supply pipe from an earlier era. The new builds on Graham&#8217;s edges bring tight envelopes and builder-grade equipment.&nbsp;We diagnose each according to what it actually is.&nbsp;</p>\n\n<div class=\"wp-block-group mb-1 full-width-mobile is-content-justification-left is-nowrap is-layout-flex wp-container-core-group-is-layout-a1b15d37 wp-block-group-is-layout-flex\">\n<div  class=\"wp-block-group mb-3 full-width-mobile schedule-and-call-cta is-content-justification-left is-nowrap is-layout-flex wp-container-core-group-is-layout-a1b15d37 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group schedule-cta-container is-vertical is-content-justification-stretch is-layout-flex wp-container-core-group-is-layout-41171c72 wp-block-group-is-layout-flex\">\n<a href=\"/bookings\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta se-widget-button\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-event\" /></svg><span >Schedule Now</span>\n\n</a>\n\n    <p class=\"horizon-text has-secondary-font-family wp-block-paragraph\" style=\"text-transform:uppercase\">or speak with an expert!</p>\n\n<a href=\"tel:+13362819025\" aria-label=\"Call now: +13362819025\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta phone-link\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-phone\" /></svg><span data-show-on=\"desktop\">(336) 281-9025</span>\n        <span data-show-on=\"mobile\">Call Now</span>\n</a>\n\n<p class=\"has-black-color has-text-color has-link-color has-secondary-font-family has-small-font-size text-center wp-elements-3 wp-block-paragraph\" style=\"text-transform:uppercase\"><strong>Same Day Appointments Available by Phone</strong></p>\n</div>\n</div>\n</div>\n\n<div  class=\"badge mb-3\" style='min-height:unset;'>\n    <div class=\"badge__content\">\n        <svg width=\"45\" height=\"45\" viewBox=\"0 0 45 45\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <title>Google</title>\n            <path d=\"M42.0046 22.9145C42.0046 21.4661 41.8746 20.0733 41.6332 18.7363H22.395V26.647H33.3882C32.9054 29.191 31.457 31.3451 29.2844 32.7935V37.9373H35.9137C39.7762 34.372 42.0046 29.1353 42.0046 22.9145Z\" fill=\"#4285F4\"/>\n            <path d=\"M22.396 42.8766C27.9112 42.8766 32.535 41.0568 35.9147 37.9371L29.2854 32.7933C27.4655 34.0189 25.1443 34.7617 22.396 34.7617C17.0851 34.7617 12.5727 31.1777 10.9571 26.3496H4.16064V31.6234C7.52175 38.2899 14.4111 42.8766 22.396 42.8766Z\" fill=\"#34A853\"/>\n            <path d=\"M10.9608 26.3308C10.5523 25.1052 10.3109 23.8053 10.3109 22.4498C10.3109 21.0942 10.5523 19.7943 10.9608 18.5687V13.2949H4.16436C2.77164 16.0432 1.97314 19.1444 1.97314 22.4498C1.97314 25.7551 2.77164 28.8563 4.16436 31.6046L9.45671 27.4821L10.9608 26.3308Z\" fill=\"#FBBC05\"/>\n            <path d=\"M22.396 10.155C25.4043 10.155 28.0783 11.1949 30.2138 13.2004L36.0633 7.35097C32.5165 4.04557 27.9112 2.02148 22.396 2.02148C14.4111 2.02148 7.52175 6.60818 4.16064 13.2933L10.9571 18.567C12.5727 13.7389 17.0851 10.155 22.396 10.155Z\" fill=\"#EA4335\"/>\n        </svg>\n        <div class=\"badge__content__rating-container\">\n            <p class=\"h6 badge__content__rating-container__title\">Google Rating</p>\n            <div class=\"badge__content__rating-container__stars\">\n                <div class=\"badge__content__rating-container__stars__number\">\n                    5                </div>\n                <div class=\"badge__content__rating-container__stars__container\">\n                    <div class=\"badge__content__rating-container__stars__container__black\">★★★★★</div>\n                    <div aria-hidden=\"true\" class=\"badge__content__rating-container__stars__container__white\">☆☆☆☆☆</div>\n                </div>\n            </div>\n                    </div>\n    </div>\n    </div></div>\n</div>\n\n</div>\n\t\t\t</div><!-- ./left -->\n\t\t\t<div class=\"section--services-hero__main__row__right\">\n\t\t\t<div class=\"elevated content-fullbleed-mobile box-shadow-lg border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\t\t\t<figure class=\"wp-block-post-featured-image\"><img decoding=\"async\" width=\"2560\" height=\"1707\" src=\"/images/2024/11/NU-HappyHome_Stock-9-scaled.jpg\" class=\"attachment-post-thumbnail size-post-thumbnail wp-post-image\" alt=\"The entrance of Happy Home Heating and Cooling in Durham, NC\" style=\"object-fit:cover;\" srcset=\"/images/2024/11/NU-HappyHome_Stock-9-scaled.jpg 2560w, /images/2024/11/NU-HappyHome_Stock-9-300x200.jpg 300w, /images/2024/11/NU-HappyHome_Stock-9-1024x683.jpg 1024w, /images/2024/11/NU-HappyHome_Stock-9-768x512.jpg 768w, /images/2024/11/NU-HappyHome_Stock-9-1536x1024.jpg 1536w, /images/2024/11/NU-HappyHome_Stock-9-2048x1365.jpg 2048w\" sizes=\"(max-width: 1010px) 100vw, (max-width: 1440px) 50vw, 768px\" /></figure>\n\t\t\t</div>\n</div>\t\t\t</div><!-- ./right -->\n\t\t</div><!-- ./row -->\n\n</div>\n\t<div class=\"section--services-hero__main section--services-hero__main--empty has-background has-secondary-background-color\">\n\t</div><!-- ./row -->\n\n</section>\n\n<div class=\"wp-block-group container flow pb-4 has-secondary-inverse-color has-primary-background-color has-text-color has-background\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--60)\">\n<div class=\"wp-block-group wrap-mobile flow pb-4 has-primary-inverse-color has-text-color has-link-color wp-elements-4 is-horizontal is-nowrap is-layout-flex wp-container-core-group-is-layout-cdbf0242 wp-block-group-is-layout-flex\" style=\"margin-top:0;margin-bottom:0;padding-top:0;padding-bottom:0\">\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-db3ccc14 wp-block-columns-is-layout-flex\" style=\"margin-top:0;margin-bottom:0;padding-top:0;padding-bottom:0\">\n<div class=\"wp-block-column flow is-layout-flow wp-block-column-is-layout-flow\">\n<div class=\"wp-block-group has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">Heating and Cooling for the County Seat&nbsp;</h2>\n\n<p class=\"wp-block-paragraph\">Gas reaches most of Graham, so furnaces, heat pumps, and hybrid systems all run here.&nbsp;Long humid summers and freeze-prone winters give equipment no off-season, which makes spring and fall maintenance the cheapest insurance available.&nbsp;</p>\n\n<p class=\"wp-block-paragraph\"><a href=\"/services/cooling/air-conditioning\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Air Conditioning Services in Graham</strong></a>&nbsp;We install, replace, repair, and tune up every major brand, and when a unit near the end of its life fails again, we show you the honest math on one more repair versus replacement.&nbsp;</p>\n\n<p class=\"wp-block-paragraph\"><a href=\"/services/heating\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Heating Services in Graham</strong></a>&nbsp;Furnaces in the established neighborhoods, heat pumps in the new ones, and both&nbsp;maintained&nbsp;on a schedule that catches small faults before January exposes them.&nbsp;</p>\n\n<p class=\"wp-block-paragraph\"><a href=\"/services/cooling/mini-split\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Ductless Mini-Split Systems</strong></a>&nbsp;Homes near the square built before ductwork get room-by-room heating and cooling from mini-splits, with no original walls&nbsp;opened. Sunrooms and converted attics&nbsp;benefit&nbsp;the same way.&nbsp;</p>\n</div>\n\n<div class=\"wp-block-group has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">Indoor Air Quality Around Court Square&nbsp;</h2>\n\n<p class=\"wp-block-paragraph\">Spring pollen and summer humidity reach every Graham home, and the older houses with vented crawl spaces and aging ducts feel them most. The fixes are mechanical and lasting.&nbsp;</p>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"/services/dehumidifiers\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Whole-Home and Crawlspace Dehumidifiers</strong></a>: Moisture held in range protects old framing and cuts mold risk under the house.&nbsp;</li>\n</ul>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"/services/indoor-air-quality/air-ducts\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Air Duct Cleaning and Sealing</strong></a>: Sealing stops conditioned air from leaking into the crawl&nbsp;space&nbsp;and cleaning removes decades of dust from the runs.&nbsp;</li>\n</ul>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"/services/indoor-air-quality/air-purifiers\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Air Filtration and Purification</strong></a>: High-efficiency filtration brings the indoor pollen count down during the season&#8217;s worst weeks.&nbsp;</li>\n</ul>\n</div>\n</div>\n\n<div class=\"wp-block-column flow is-layout-flow wp-block-column-is-layout-flow\">\n<div class=\"wp-block-group has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">Plumbing From the Square to the Subdivisions&nbsp;</h2>\n\n<p class=\"wp-block-paragraph\">Graham draws its municipal water from Graham-Mebane Lake, and the treated supply arrives&nbsp;relatively soft, so softeners rarely earn a place in town. The plumbing work that matters here concentrates in the older blocks, where original galvanized and cast-iron lines are reaching&nbsp;genuine&nbsp;end of life.&nbsp;</p>\n\n<p class=\"wp-block-paragraph\"><a href=\"/services/plumbing/repiping-services\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Repiping and Pipe Repair</strong></a>&nbsp;Corroding old pipe strangles pressure and tints water years before it visibly fails.&nbsp;Repiping&nbsp;during a renovation is the permanent fix, and it protects finished spaces from hidden leaks.&nbsp;</p>\n\n<p class=\"wp-block-paragraph\"><a href=\"/services/plumbing/water-heater-installation-replacements\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Water Heater Installation and Replacement</strong></a>&nbsp;Tank and tankless units&nbsp;sized&nbsp;and fueled to the household, installed cleanly and tested before we leave.&nbsp;</p>\n\n<p class=\"wp-block-paragraph\"><a href=\"/services/plumbing/frozen-burst-pipe-repair\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Frozen and Burst Pipe Repair</strong></a>&nbsp;Piedmont freezes&nbsp;find&nbsp;the under-insulated line in an old crawl space first. We stop the water fast and repair the break properly.&nbsp;</p>\n\n<p class=\"wp-block-paragraph\"><a href=\"/services/plumbing/kitchen-bathroom\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Kitchen and Bathroom Plumbing</strong></a>&nbsp;Fixture upgrades in a historic home or leak repairs in a new build, priced upfront and finished clean. Rural Alamance properties on wells can also schedule&nbsp;<a href=\"/services/plumbing/well-pump\" target=\"_blank\" rel=\"noreferrer noopener\">well pump service</a>, and homeowners wanting&nbsp;better-tasting&nbsp;water can add&nbsp;<a href=\"/services/plumbing/water-treatment-filtration\" target=\"_blank\" rel=\"noreferrer noopener\">filtration</a>.&nbsp;</p>\n</div>\n</div>\n</div>\n</div>\n</div>\n\n<div class=\"wp-block-group has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">How We Earn Graham&#8217;s Repeat Calls&nbsp;</h2>\n\n<p class=\"wp-block-paragraph\">The order never&nbsp;changes:&nbsp;diagnose the actual fault, present the price, then do the work, with honest, upfront pricing and a 100% money-back guarantee standing behind it. Problems other companies could not crack are the calls our trained technicians most want. Call or book online to schedule service anywhere in Graham.&nbsp;</p>\n</div>\n\n<div  class=\"accordion\" style=\"--_accordion-separator-color: #076395\">\n            <details class=\"accordion-item\" data-custom-open=\"true\" open>\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Can I get emergency plumbing help in Graham on a weekend? </p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p>Yes. Weekend, overnight, and holiday coverage runs 24/7 across Graham and Alamance County. Call us when the problem starts.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">My home near Court Square predates ductwork. What are my cooling options? </p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p>Ductless mini-splits are the proven answer. Compact wall units deliver heating and cooling room by room, and installation leaves original plaster and framing untouched.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Should Graham homeowners install water softeners? </p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p>In town, usually not. Graham-Mebane Lake water arrives treated and relatively soft, so filtration for taste tends to be the worthwhile upgrade instead. Private wells outside town are a separate question we answer with a water test.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">What explains weak water pressure in Graham&#8217;s older homes? </p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p>Original galvanized pipe corroding from the inside is the most common cause. The narrowing happens gradually over decades, and repiping restores full flow throughout the house.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Which other communities around Graham do you take calls from? </p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p>Burlington, Haw River, and Saxapahaw all sit inside our coverage. The Service Areas menu holds the full list.</p>\n                </div>\n            </div>\n        </details>    </div>\n\n<div class=\"wp-block-group container flow py-5\">\n<h2 class=\"wp-block-heading\">Powered by NearU — We’re here to make your HVAC Service experience the best one yet!</h2>\n\n<figure class=\"wp-block-image size-full is-resized\"><img decoding=\"async\" width=\"430\" height=\"98\" src=\"/images/2024/02/NearU.png\" alt=\"NearU\" class=\"wp-image-36\" style=\"width:220px\" srcset=\"/images/2024/02/NearU.png 430w, /images/2024/02/NearU-300x68.png 300w\" sizes=\"(max-width: 430px) 100vw, 430px\" /></figure>\n\n<p class=\"wp-block-paragraph\">NearU is setting up a new standard of HVAC, plumbing, drains, IAQ, and generator services with major improvements to reliability, convenience, and customer care. We equip our companies with better resources, training, and tools, so they can provide you with the best possible service outcome. If you’ve recently learned that your go-to HVAC, plumbing, drains, IAQ, and generator company has joined NearU, then this is something to get excited about! We protect the people and culture that make each company great, while ensuring their customers consistently receive the best possible care.</p>\n</div>\n\t</div>\n\t</article><!-- #post-6724 -->"
}
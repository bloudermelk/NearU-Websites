  <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"53\" src=\"/images/2024/02/Honeywell-logo-300x53.png\" class=\"logogrid-image\" alt=\"Honeywell logo an HVAC partner in Durham, NC\" srcset=\"/images/2024/02/Honeywell-logo-300x53.png 300w, /images/2024/02/Honeywell-logo-1024x181.png 1024w, /images/2024/02/Honeywell-logo-768x136.png 768w, /images/2024/02/Honeywell-logo.png 1413w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"225\" height=\"225\" src=\"/images/2024/02/rheem.png\" class=\"logogrid-image\" alt=\"Rheem logo\" srcset=\"/images/2024/02/rheem.png 225w, /images/2024/02/rheem-150x150.png 150w\" sizes=\"(max-width: 225px) 100vw, 225px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"88\" src=\"/images/2024/02/Mitsubishi-Electric-logo-300x88.png\" class=\"logogrid-image\" alt=\"Mitsubishi Electric logo an HVAC partner in Durham, NC\" srcset=\"/images/2024/02/Mitsubishi-Electric-logo-300x88.png 300w, /images/2024/02/Mitsubishi-Electric-logo-768x226.png 768w, /images/2024/02/Mitsubishi-Electric-logo.png 851w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n            <li class=\"logogrid-item\">\n            <div class=\"logogrid-wrap\"><img decoding=\"async\" width=\"300\" height=\"57\" src=\"/images/2024/02/Water-Furnace-logo-300x57.png\" class=\"logogrid-image\" alt=\"Water Furnace logo an HVAC partner in Durham, NC\" srcset=\"/images/2024/02/Water-Furnace-logo-300x57.png 300w, /images/2024/02/Water-Furnace-logo-768x147.png 768w, /images/2024/02/Water-Furnace-logo.png 1024w\" sizes=\"(max-width: 300px) 100vw, 300px\" /></div>        </li>\n        </ul>\n</div>\n\n            <h6 class=\"wp-block-heading has-text-align-center\" style=\"text-transform:uppercase\">\n                And Dozens More\n            </h6></div>\n\n    </div>\n</div>\n\n<div  class=\"splitter-column splitter-column--right splitter-column--center py-3 has-custom-acf-color has-background has-secondary-background-color has-text-color has-secondary-inverse-color wp-elements-5\">\n    <div class=\"splitter-column-inner splitter-column-inner--contained splitter-column-inner--padded\">\n\n    <h2 class=\"wp-block-heading mb-3\">Qualified for All Major Makes and Models</h2>\n\n    <div class=\"wp-block-group flow mb-2 has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n    <p>Our team of expert technicians is trained to handle all makes and models of major brands with precision and care. From routine maintenance to complex repairs, we ensure top-notch service for all.</p>\n\n    </div>\n\n<div  class=\"iconlist\" data-orientation=\"vertical\" data-iconsize=\"md\">\n    <ul role=\"list\">\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-check\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p>Ensure optimal efficiency of all your systems</p>\n</p>\n            </div>\n        </li>\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-check\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p>Lower your utility costs with energy efficiency</p>\n</p>\n            </div>\n        </li>\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-check\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p>Extend your system’s lifespan through regular maintenance</p>\n</p>\n            </div>\n        </li>\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-check\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p>Keep you and your family comfortable and safe during all seasons</p>\n</p>\n            </div>\n        </li>\n            </ul>\n</div>\n    </div>\n</div>\n\n</div><div id=\"our-certifications\" class=\"container certifications-and-awards py-5\">\n    <h2 class=\"wp-block-heading has-text-align-center mb-4 d-inline-block h-decorator h-decorator--primary\">Our Certifications & Awards</h2>\n<div  class=\"logocarousel\" style=\"--count: 2;\" data-logo-count=\"2\">\n    <div class=\"logocarousel--inner-container\">\n        <ul role=\"list\" class=\"logocarousel-list\" style=\"--logo-count:2;\">\n                                <li class=\"logocarousel-item\">\n                        <div class=\"logocarousel-wrap\"><img decoding=\"async\" width=\"249\" height=\"245\" src=\"/images/2024/03/OnCallAir-Customer-First-Award-Winner.png\" class=\"logocarousel-image\" alt=\"OnCallAir Customer First Award Winner\" sizes=\"(max-width: 680px) 150px, (max-width: 820px) 128px, (max-width: 1024px) 100px, 128px\" /></div>                    </li>\n                                    <li class=\"logocarousel-item\">\n                        <div class=\"logocarousel-wrap\"><img decoding=\"async\" width=\"252\" height=\"250\" src=\"/images/2024/03/North-American-Technician-Excellence-logo-NATE.png\" class=\"logocarousel-image\" alt=\"North American Technician Excellence logo (NATE) given to Happy Home in Durham, NC\" sizes=\"(max-width: 680px) 150px, (max-width: 820px) 128px, (max-width: 1024px) 100px, 128px\" srcset=\"/images/2024/03/North-American-Technician-Excellence-logo-NATE.png 252w, /images/2024/03/North-American-Technician-Excellence-logo-NATE-150x150.png 150w\" /></div>                    </li>\n                        </ul>\n    </div>\n</div></div>\n\n<div id=\"FAQs\" class=\"wp-block-group py-5 flow has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading has-text-align-center\">FAQs</h2>\n\n<div  class=\"accordion\" style=\"--_accordion-separator-color: #076395\">\n            <details class=\"accordion-item\" data-custom-open=\"true\" open>\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Can a well pump freeze in the winter?</p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p>Well pumps can freeze in the winter if proper precautions aren&#8217;t taken. Cold temperatures can cause water inside the pump and pipes to freeze, leading to damage. Insulating the well pump and pipes, installing a well house, and using heat tape or a heater are effective measures to prevent freezing. Regular maintenance checks by professionals ensure that the pump is in good condition. Keeping the well pump protected during winter is essential to avoid costly repairs.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">How can I keep my well pump in good condition?</p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p>Keep your well pump operating smoothly and maximize its lifespan by following these steps:</p>\n<ul>\n<li>Schedule routine inspections to catch problems early</li>\n<li>Insulate your pump and install a well house to protect the well pump from extreme weather</li>\n<li>Ensure the pump is away from any source of water or chemicals.</li>\n<li>Monitor water pressure regularly to detect abnormalities.</li>\n<li>Avoid running the pump excessively or letting it run dry.</li>\n<li>Maintain proper well water treatment, including regular testing and filtration, to prevent mineral buildup or contamination.</li>\n</ul>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">What signs mean something is wrong with my well pump?</p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p>Several signs may indicate a problem with your well pump. Our technicians can diagnose the issue and provide efficient repair or replacement services. If you notice any of the following signs, it&#8217;s crucial to seek professional assistance promptly:</p>\n<ul>\n<li>A sudden decrease in water pressure or no water flow at all</li>\n<li>Your water appears muddy, has a strange odor, or a metallic taste</li>\n<li>Frequent short cycling, where the pump turns on and off rapidly</li>\n<li>Unusual noises like grinding or squealing and higher electricity bills may also point to pump problems.</li>\n</ul>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">How much does it cost to repair or replace a well pump? </p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p>Submersible pumps generally cost more to service than jet pumps because of their location deep in the well, and deeper wells add labor and equipment. A minor fix like a pressure switch or control box may run a few hundred dollars, while a burnt-out motor usually means full replacement, and upgrades to wiring or pressure tanks add to the total. After an in-person inspection, we give you a detailed quote covering parts, labor, and your options.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">How long do well pump repairs take? </p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p>Many repairs are completed in a few hours. Harder-to-reach pumps or more involved issues take longer, and we walk you through the problem with a clear timeline and estimate before starting any work.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Why is my water pressure low? </p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p>Low pressure on a well system often traces to a failing pump, a clogged pressure switch, sediment buildup, or a damaged well pipe. An in-person <a href=\"/services/plumbing/water-pressure-assessments\">water pressure assessment</a> is the fastest way to pinpoint the cause, since guessing tends to lead to fixing the wrong thing first.</p>\n                </div>\n            </div>\n        </details>    </div>\n</div>\n\n<div id=\"maintenance-financing\" class=\"container splitter splitter--uniform-height-stick-last\" style=\"--CTX-container-split-size: 0.5\">\n\n<div  class=\"splitter-column splitter-column--left splitter-column--start has-background has-primary-background-color\">\n    <div class=\"splitter-column-inner splitter-column-inner--contained splitter-column-inner--padded\">\n\n<div class=\"wp-block-group flow w100 has-global-padding is-layout-constrained wp-container-core-group-is-layout-2468f3b8 wp-block-group-is-layout-constrained\"><div class=\"elevated content-fullbleed-mobile w100 border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\n<figure class=\"wp-block-image size-full has-custom-border w100\"><img decoding=\"async\" width=\"2560\" height=\"1707\" src=\"/images/2024/04/NU-Bullman-Stock-37-scaled.jpg\" alt=\"Clamp meter on HVAC unit\" class=\"wp-image-5359\" style=\"border-radius:0px\" srcset=\"/images/2024/04/NU-Bullman-Stock-37-scaled.jpg 2560w, /images/2024/04/NU-Bullman-Stock-37-300x200.jpg 300w, /images/2024/04/NU-Bullman-Stock-37-1024x683.jpg 1024w, /images/2024/04/NU-Bullman-Stock-37-768x512.jpg 768w, /images/2024/04/NU-Bullman-Stock-37-1536x1024.jpg 1536w, /images/2024/04/NU-Bullman-Stock-37-2048x1365.jpg 2048w\" sizes=\"(max-width: 2560px) 100vw, 2560px\" /></figure>\n\n</div>\n</div>\n\n<h2 class=\"wp-block-heading mt-3 has-primary-inverse-color has-text-color has-link-color wp-elements-6\">Happy Home Service VIP Club</h2>\n\n<p class=\"has-primary-inverse-color has-text-color has-link-color wp-elements-7 wp-block-paragraph\">What You Receive with Our VIP Maintenance Club:</p>\n\n<ul class=\"has-primary-inverse-color has-text-color has-link-color wp-block-list wp-elements-8\">\n<li>Up to 25% Discount on Repairs</li>\n\n<li>Up to an additional 25% discount on parts and labor</li>\n\n<li>Same Day Service</li>\n\n<li>Triple Labor Warranty</li>\n\n<li>50% off Minimum Service Fee</li>\n\n<li>$50 Yearly Rebate</li>\n\n<li>Flexible Payment Options</li>\n\n<li>Convenient Service Reminders</li>\n\n<li>Your 13th Month Free when you join or renew your one-year plan</li>\n</ul>\n\n<a href=\"/maintenance\" data-cta-gap=\"md\" data-cta-type=\"outline\" data-cta-content=\"mixed\" data-cta-minwidth=\"true\" class=\"cta full-width-mobile\">\n    <span >Learn More</span>\n        <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronright\" /></svg>\n</a></div>\n\n</div>\n</div>\n\n<div  class=\"splitter-column splitter-column--right splitter-column--start\">\n    <div class=\"splitter-column-inner splitter-column-inner--contained splitter-column-inner--padded\">\n\n<div class=\"wp-block-group flow has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\"><div class=\"elevated content-fullbleed-mobile border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\n<figure class=\"wp-block-image size-full has-custom-border\"><img decoding=\"async\" width=\"1916\" height=\"1280\" src=\"/images/2024/03/A-Happy-Home-Services-employee-speaking-on-the-phone-with-a-customer.jpg\" alt=\"A Happy Home Services employee speaking on the phone with a customer\" class=\"wp-image-4758\" style=\"border-radius:0px\" srcset=\"/images/2024/03/A-Happy-Home-Services-employee-speaking-on-the-phone-with-a-customer.jpg 1916w, /images/2024/03/A-Happy-Home-Services-employee-speaking-on-the-phone-with-a-customer-300x200.jpg 300w, /images/2024/03/A-Happy-Home-Services-employee-speaking-on-the-phone-with-a-customer-1024x684.jpg 1024w, /images/2024/03/A-Happy-Home-Services-employee-speaking-on-the-phone-with-a-customer-768x513.jpg 768w, /images/2024/03/A-Happy-Home-Services-employee-speaking-on-the-phone-with-a-customer-1536x1026.jpg 1536w\" sizes=\"(max-width: 1916px) 100vw, 1916px\" /></figure>\n\n</div>\n</div>\n\n<h2 class=\"wp-block-heading mt-3\">We Offer Financing!</h2>\n\n<p class=\"wp-block-paragraph\">Happy Home Services proudly offers financing options through Goodleap<sup>®</sup> and GreenSky<sup>®</sup>. Financing options let you tackle necessary repairs or upgrades without draining your savings or delaying important projects. <br></p>\n\n<p class=\"wp-block-paragraph\">Financing is dependent on service requirements and credit history. Some of our short- and long-term financing options include:</p>\n\n<ul class=\"wp-block-list\">\n<li>0% interest</li>\n\n<li>6.99% interest</li>\n\n<li>$58/month for furnaces</li>\n\n<li>$99/month for AC/heating units</li>\n\n<li>And more!</li>\n</ul>\n\n<a href=\"/financing\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta full-width-mobile\">\n    <span >Learn More</span>\n        <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronright\" /></svg>\n</a></div>\n\n</div>\n</div>\n\n</div>        <div id=\"reviews\" class=\"google-reviews-featured container container py-5 has-background has-gray-light-background-color\">\n    <div class=\"google-reviews-featured__head\">\n        <div class=\"google-reviews-featured__head__logo\">            <svg version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\" viewBox=\"0 0 107.3 35.2\" style=\"enable-background:new 0 0 107.3 35.2;\" xml:space=\"preserve\"><title>Google</title><path fill=\"#4885ED\" d=\"M26.4,12.4H13.9v3.7h8.9c-0.4,5.2-4.8,7.4-8.9,7.4c-5.4,0-9.8-4.3-9.8-9.7c0-0.1,0-0.1,0-0.2 c0-5.6,4.4-10,9.8-10c4.2,0,6.7,2.7,6.7,2.7l2.6-2.7c0,0-3.3-3.7-9.4-3.7C6,0,0,6.5,0,13.6c0,6.9,5.6,13.7,14,13.7 c7.3,0,12.7-5,12.7-12.4C26.6,13.3,26.4,12.4,26.4,12.4L26.4,12.4z\"/><g><path id=\"A\" fill=\"#DB3236\" d=\"M36.6,9.7c-5.1,0-8.8,4-8.8,8.7c0,4.8,3.6,8.8,8.9,8.8c4.8,0,8.7-3.7,8.7-8.7 C45.4,12.7,40.9,9.7,36.6,9.7L36.6,9.7z M36.7,13.2c2.5,0,4.9,2,4.9,5.3c0,3.2-2.4,5.3-4.9,5.3c-2.8,0-5-2.2-
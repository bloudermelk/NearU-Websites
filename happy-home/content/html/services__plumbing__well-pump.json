s-featured__body\">\n                                                <!-- review carousel -->\n                <div class=\"nearu-carousel multi-component-container multi-component-container--uniform-height\">                    <div  class=\"card card--google-review has-white-background-color has-black-color\">\n        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Nicole Tinnen\" aria-label=\"Nicole Tinnen\">Nicole Tinnen</p>\n            <div class=\"card__content__title__stars\">★★★★★</div>\n                    <div class=\"card__content__description card__description\">\n<p>The customer service from the phone call to the gentleman coming into my house was perfect 🤩! I was able to get an appointment the same day I called. My issue was resolved Monday. I had no heat and they was nice to let me borrow a heater. Thank you guys so much.</p>\n</div>\n\n                </div></div>\n                            <div  class=\"card card--google-review has-white-background-color has-black-color\">\n        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Damon Nance\" aria-label=\"Damon Nance\">Damon Nance</p>\n            <div class=\"card__content__title__stars\">★★★★★</div>\n                    <div class=\"card__content__description card__description\">\n<p>My technician was on time, polite, knowledgeable, and a real pleasure to deal with. He was proficient and efficient. He took his time, explained everything and gave me a great overview. I would recommend Happy Home to anyone.</p>\n</div>\n\n                </div></div>\n                            <div  class=\"card card--google-review has-white-background-color has-black-color\">\n        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Billy Strickland\" aria-label=\"Billy Strickland\">Billy Strickland</p>\n            <div class=\"card__content__title__stars\">★★★★★</div>\n                    <div class=\"card__content__description card__description\">\n<p>The service technician came to do the fall/winter maintenance on my heat/AC unit. He was very thorough. Did a great job servicing, and cleaning the unit, and the air cleaner unit. Very courteous and friendly. Definitely a professional technician.</p>\n</div>\n\n                </div></div>\n            </div>\n    <!-- ./ review carousel -->\n    <div class=\"nearu-carousel-controls\">\n\t<div class=\"nearu-carousel-button button-prev\">    <div class=\"iconblock\" data-size=\"lg\" data-padding=\"2\" data-display=\"block\">\n        <svg class=\"icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronleft\" /></svg>    </div>\n    </div>\n\t<div class=\"carousel-dots\"><div role=\"button\" aria-label=\"Go to slide 1 of 3\" data-nearu-carousel-dot-index=\"1\" class=\"carousel-dots__dot selected\"></div><div role=\"button\" aria-label=\"Go to slide 2 of 3\" data-nearu-carousel-dot-index=\"2\" class=\"carousel-dots__dot\"></div><div role=\"button\" aria-label=\"Go to slide 3 of 3\" data-nearu-carousel-dot-index=\"3\" class=\"carousel-dots__dot\"></div></div>\n<div class=\"nearu-carousel-button button-next\">    <div class=\"iconblock\" data-size=\"lg\" data-padding=\"2\" data-display=\"block\">\n        <svg class=\"icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronright\" /></svg>    </div>\n    </div>\n</div></div>\n<!-- ./ reviews body -->\n\n</div>\n<div id=\"our-community\" class=\"container splitter mobile-flip-splitter has-background has-white-background-color\" style=\"--CTX-container-split-size: 0.5\">\n\n<div  class=\"splitter-column splitter-column--left splitter-column--center splitter-column--padded-edge\">\n    <div class=\"splitter-column-inner splitter-column-inner--contained splitter-column-inner--padded\">\n\n<div class=\"wp-block-group flow has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\"><div class=\"wp-block-site-logo\"><a href=\"/\" class=\"custom-logo-link\" rel=\"home\"><img decoding=\"async\" width=\"200\" height=\"69\" src=\"/images/2024/03/Happy-Home-Services-logo.png\" class=\"custom-logo\" alt=\"Happy Home Services, a NearU Company, logo, an HVAC, Plumbing, and Indoor Air Quality services company in Durham, NC\" srcset=\"/images/2024/03/Happy-Home-Services-logo.png 800w, /images/2024/03/Happy-Home-Services-logo-300x104.png 300w, /images/2024/03/Happy-Home-Services-logo-768x265.png 768w\" sizes=\"(max-width: 200px) 100vw, 200px\" /></a></div>\n\n<h2 class=\"wp-block-heading h-decorator h-decorator--primary has-primary-inverse-color has-text-color has-link-color wp-elements-9\" style=\"font-style:normal;font-weight:600\">Serving the Greater Durham &amp; Chapel Hill Communities for 70 Years!</h2>\n\n<p class=\"wp-block-paragraph\">Happy Home Services has been the trusted HVAC and plumbing company in <strong>Greater Durham</strong> and <strong>Chapel Hill, NC, </strong>since 1955. Our team of technicians is background-checked to ensure trustworthy professionals will be working in your home. Whether it's 24/7 emergency repairs or scheduled maintenance, Happy Home Services is the go-to choice for all your heating, cooling, indoor air quality, plumbing, and drain needs in <strong>North Carolina</strong>.</p>\n\n<div  class=\"wp-block-group mb-3 full-width-mobile schedule-and-call-cta is-content-justification-left is-nowrap is-layout-flex wp-container-core-group-is-layout-a1b15d37 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group schedule-cta-container is-vertical is-content-justification-stretch is-layout-flex wp-container-core-group-is-layout-41171c72 wp-block-group-is-layout-flex\">\n<a href=\"/bookings\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta se-widget-button\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-event\" /></svg><span >Schedule Now</span>\n\n</a>\n\n    <p class=\"horizon-text has-secondary-font-family wp-block-paragraph\" style=\"text-transform:uppercase\">or speak with an expert!</p>\n\n<a href=\"tel:+13362819025\" aria-label=\"Call now: +13362819025\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta phone-link\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-phone\" /></svg><span data-show-on=\"desktop\">(336) 281-9025</span>\n        <span data-show-on=\"mobile\">Call Now</span>\n</a>\n\n<p class=\"has-black-color has-text-color has-link-color has-secondary-font-family has-small-font-size text-center wp-elements-10 wp-block-paragraph\" style=\"text-transform:uppercase\"><strong>Same Day Appointments Available by Phone</strong></p>\n</div>\n</div>\n</div>\n\n</div>\n</div>\n\n<div  class=\"splitter-column splitter-column--right splitter-column--stretch\">\n    <div class=\"splitter-column-inner\">\n\n<style>\n    /* Centering container */\n    .map-container {\n      max-width: 900px;\n      margin: 0 auto;\n      padding: 0 1rem;\n      text-align: center;\n    }\n\n    /* Responsive Map */\n    #map {\n      width: 100%;\n      height: 600px; /* Adjusted for better visibility */\n      border-radius: 10px;\n      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);\n    }\n  </style>\n\n  <div class=\"map-container\">\n    <h2>We Serve the Entire Research Triangle!</h2>\n    <div id=\"map\"></div> <!-- Map loads here -->\n  </div>\n\n  <!-- Load Google Maps API and Initialize Map -->\n  <script>\n    function initMap() {\n      // Set center coordinates and zoom level\n      var map = new google.maps.Map(document.getElementById(\"map\"), {\n        center: { lat: 35.012385, lng: -78.918142}, // Adjusted center\n        zoom: 12, // Increased zoom level for closer view\n        mapTypeId: \"roadmap\"\n      });\n\n      // Load KML Layer from Google My Maps\n      var kmlLayer = new google.maps.KmlLayer({\n        url: \"https://www.google.com/maps/d/u/0/kml?mid=1kW1iyV3fr9_B2ohD2V1VDLk-o3_adIg\", // Updated KML link\n        map: map\n      });\n\n      // Handle errors if the KML layer fails to load\n      google.maps.event.addListener(kmlLayer, 'status_changed', function() {\n        if (kmlLayer.getStatus() !== 'OK') {\n          alert(\"Failed to load the map. Make sure the KML file is publicly accessible.\");\n        }\n      });\n    }\n  </script>\n\n  <!-- Google Maps API Script with your API Key -->\n  <script async defer src=\"https://maps.googleapis.com/maps/api/js?key=AIzaSyAkoAqb9urO5Kv96nPMn3tEIGRUtWvSwuc&callback=initMap\"></script>\n\n</div>\n</div>\n\n</div>"

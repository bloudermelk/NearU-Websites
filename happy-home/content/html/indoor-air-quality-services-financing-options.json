  "html": "<article id=\"post-5851\" class=\"container post-5851 page type-page status-publish has-post-thumbnail hentry\">\n\n\t<div class=\"entry-content | container\">\n\t\t<section  class=\"container section--services-hero pt-5 services-hero\">\n\t<div class=\"section--services-hero__main\">\n\t\t<div class=\"section--services-hero__main__row\">\n\t\t\t<div class=\"section--services-hero__main__row__left\">\n                <div class=\"acf-innerblocks-container\">\n\n<div class=\"wp-block-group full-width-mobile is-vertical is-layout-flex wp-container-core-group-is-layout-2c90304e wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group h-align is-nowrap is-layout-flex wp-container-core-group-is-layout-7387b849 wp-block-group-is-layout-flex\">    <div class=\"iconblock wp-elements-1 has-background has-secondary-background-color has-text-color has-primary-inverse-color\" data-size=\"md\" data-padding=\"2\" data-display=\"inline\">\n        <svg class=\"icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-money\" /></svg>    </div>\n\n<h1 class=\"wp-block-heading has-secondary-active-color has-text-color has-link-color has-x-large-font-size wp-elements-2\">Indoor Air Quality Services Financing Options with Happy Home Services</h1>\n</div>\n\n<div class=\"wp-block-group my-3 is-layout-flex wp-block-group-is-layout-flex\">\n<p class=\"wp-block-paragraph\">At Happy Home Services, we believe that clean, healthy air should be accessible to every homeowner. That’s why we offer&nbsp;<strong>flexible financing options</strong>&nbsp;for indoor air quality systems, making it easier to improve the air in your home without financial stress. Whether you’re installing a whole-home air purifier, upgrading your filtration system, or adding a humidifier, we’re here to help you breathe easier. Contact us today to learn more about financing your indoor air quality improvements.</p>\n</div>\n\n<div class=\"wp-block-group mb-3 is-content-justification-left is-nowrap is-layout-flex wp-container-core-group-is-layout-a1b15d37 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group full-width-mobile is-vertical is-content-justification-stretch is-layout-flex wp-container-core-group-is-layout-41171c72 wp-block-group-is-layout-flex\">\n<p class=\"horizon-text full-width-mobile has-secondary-font-family wp-block-paragraph\" style=\"text-transform:uppercase\">Speak with an expert</p>\n\n<a href=\"tel:+13362819025\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"icon\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta full-width-mobile\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-phone\" /></svg><span>(336) 281-9025</span>\n</a>\n\n<p class=\"text-center has-primary-color has-text-color has-link-color has-secondary-font-family has-small-font-size wp-elements-3 wp-block-paragraph\" style=\"text-transform:uppercase\"><strong>Same day appointments available by phone</strong></p>\n</div>\n</div>\n</div>\n\n</div>\n\t\t\t</div><!-- ./left -->\n\t\t\t<div class=\"section--services-hero__main__row__right\">\n\t\t\t<div class=\"elevated content-fullbleed-mobile box-shadow-lg border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\t\t\t<figure class=\"wp-block-post-featured-image\"><img decoding=\"async\" width=\"1920\" height=\"1280\" src=\"/images/2024/10/indoor-air-quality-blog-image.jpg\" class=\"attachment-post-thumbnail size-post-thumbnail wp-post-image\" alt=\"Indoor Air Filter System that improves the indoor air quality of a residential customer&#039;s home.\" style=\"object-fit:cover;\" srcset=\"/images/2024/10/indoor-air-quality-blog-image.jpg 1920w, /images/2024/10/indoor-air-quality-blog-image-300x200.jpg 300w, /images/2024/10/indoor-air-quality-blog-image-1024x683.jpg 1024w, /images/2024/10/indoor-air-quality-blog-image-768x512.jpg 768w, /images/2024/10/indoor-air-quality-blog-image-1536x1024.jpg 1536w\" sizes=\"(max-width: 1010px) 100vw, (max-width: 1440px) 50vw, 768px\" /></figure>\n\t\t\t</div>\n</div>\t\t\t</div><!-- ./right -->\n\t\t</div><!-- ./row -->\n\n</div>\n\t<div class=\"section--services-hero__main section--services-hero__main--empty has-background has-secondary-background-color\">\n\t</div><!-- ./row -->\n\n</section>\n\n<div class=\"wp-block-group container pb-5 flow has-primary-inverse-color has-secondary-background-color has-text-color has-background has-link-color wp-elements-4\">\n<div style=\"height:1rem\" aria-hidden=\"true\" class=\"wp-block-spacer d-block d-md-none\"></div>\n\n<h2 class=\"wp-block-heading has-secondary-inverse-color has-text-color has-link-color wp-elements-5\">Affordable Financing for Indoor Air Quality Solutions</h2>\n\n<p class=\"has-secondary-inverse-color has-text-color has-link-color wp-elements-6 wp-block-paragraph\">From removing allergens to maintaining proper humidity levels, indoor air quality systems can transform your living environment. Whether you’re looking to install UV lights, a whole-home air purifier, or advanced filtration systems, Happy Home Services offers comprehensive solutions tailored to your needs. Our systems not only improve your air but also protect your HVAC system and your family’s health.</p>\n\n<div class=\"wp-block-group multi-component-container multi-component-container--2-up multi-component-container--uniform-height has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\"><div  class=\"card flow  wp-elements-7 has-white-background-color has-text-color has-black-color\" style=\"padding-top:1.33rem;padding-bottom:1.33rem;padding-left:1.33rem;padding-right:1.33rem;\">\n            <div class=\"acf-innerblocks-container\">\n\n<figure class=\"wp-block-image aligncenter size-full is-resized\"><img decoding=\"async\" width=\"396\" height=\"162\" src=\"/images/ext/2ndwindhvac.com/2024/02/Financing-Greensky-logo.jpg\" alt=\"Greensky logo\" class=\"wp-image-17\" style=\"widt
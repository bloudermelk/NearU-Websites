  "html": "<article id=\"post-2712\" class=\"container post-2712 page type-page status-publish hentry\">\n\n\t<div class=\"entry-content | container\">\n\n<div  class=\"container splitter container pt-5 bottom-overlap bottom-overlap--secondary\" style=\"--CTX-container-split-size: 0.5\">\n\n<div  class=\"splitter-column splitter-column--left splitter-column--stretch\">\n    <div class=\"splitter-column-inner splitter-column-inner--contained splitter-column-inner--padded\">\n\n<div class=\"wp-block-group flow\">\n<h2 class=\"wp-block-heading has-secondary-color has-text-color has-x-large-font-size\">Schedule an Appointment</h2>\n\n<p class=\"wp-block-paragraph\">Use the form below to request an appointment with us and we’ll reach out to you to confirm the service type and date/time.</p>\n\n<p class=\"wp-block-paragraph\">If you prefer to speak on the phone we’re happy to speak with you directly about your needs.</p>\n</div>\n\n</div>\n</div>\n\n<div  class=\"splitter-column splitter-column--right splitter-column--stretch splitter-column--padded-edge\">\n    <div class=\"splitter-column-inner\">\n<div class=\"elevated content-fullbleed-mobile box-shadow-lg border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\n</div>\n</div>\n</div>\n</div>\n\n</div>\n\n<div class=\"wp-block-group container py-5 has-primary-inverse-color has-secondary-background-color has-text-color has-background has-link-color wp-elements-1\">\n<div class=\"wp-block-group asymmetric-container\">\n<div class=\"wp-block-group asymmetric-main has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">        <form data-scheduler-form action=\"/schedule-request-confirmation\" method=\"POST\" class=\"contact-form | has-white-background-color has-black-color\">\n            <input type=\"hidden\" id=\"_scheduler_form_submit\" name=\"_scheduler_form_submit\" value=\"5d87f2f49d\" /><input type=\"hidden\" name=\"_wp_http_referer\" value=\"/schedule/?nowprocket=1\" />                            <section class=\"flow\" id=\"step1\">\n                    <p class=\"h6 has-gray-dark-color\">Step 1</p>\n                    <h2 class=\"h1\" id=\"step1-heading\">Select Your Service</h2>\n                    <fieldset class=\"contact-form__group contact-form__group--radio\"><legend class=\"contact-form__group-label visually-hidden\">Service Type</legend>                                <div>\n                                                                            <label for=\"step1-service_type-inspection-repair\" class=\"contact-form__group-item\">\n                                            <input\n                                                type=\"radio\"\n                                                id=\"step1-service_type-inspection-repair\"\n                                                name=\"service_type\"\n                                                value=\"inspection-repair\"\n                                                class=\"contact-form__group-input contact-form__group-input--checkable\"\n                                                required                                            >\n\n                                            <strong class=\"contact-form__group-text-main\">Inspection or repair</strong>\n                                            <span class=\"contact-form__group-text-description\">Lorem ipsum dolor sit amet consectetur adipisicing elit. Voluptates, quas. Ea, odio laboriosam pariatur ratione natus eum omnis commodi eligendi?</span>                                        </label>\n                                                                            <label for=\"step1-service_type-installation\" class=\"contact-form__group-item\">\n                                            <input\n                                                type=\"radio\"\n                                                id=\"step1-service_type-installation\"\n                                                name=\"service_type\"\n                                                value=\"installation\"\n                                                class=\"contact-form__group-input contact-form__group-input--checkable\"\n                                                                                            >\n\n                                            <strong class=\"contact-form__group-text-main\">Installation</strong>\n                                            <span class=\"contact-form__group-text-description\">Lorem ipsum dolor sit amet consectetur adipisicing elit. Voluptates, quas. Ea, odio laboriosam pariatur ratione natus eum omnis commodi eligendi?</span>                                        </label>\n                                                                            <label for=\"step1-service_type-maintenance\" class=\"contact-form__group-item\">\n                                            <input\n                                                type=\"radio\"\n                                                id=\"step1-service_type-maintenance\"\n                                                name=\"service_type\"\n                                                value=\"maintenance\"\n                                                class=\"contact-form__group-input contact-form__group-input--checkable\"\n                                                                                            >\n\n                                            <strong class=\"contact-form__group-text-main\">Maintenance</strong>\n                                            <span class=\"contact-form__group-text-description\">Lorem ipsum dolor sit amet consectetur adipisicing elit. Voluptates, quas. Ea, odio laboriosam pariatur ratione natus eum omnis commodi eligendi?</span>                                        </label>\n                                                                    </div>\n                                </fieldset><fieldset class=\"contact-form__group contact-form__group--radio\" data-conditional=\"[{&quot;field&quot;:&quot;service_type&quot;,&quot;value&quot;:[&quot;inspection-repair&quot;,&quot;maintenance&quot;]}]\"><legend class=\"contact-form__group-label\">How old is your equipment?</legend>                                <div>\n                                                                            <label for=\"step1-equipement_age-1-5\" class=\"contact-form__group-item\">\n                                            <input\n                                                type=\"radio\"\n                                                id=\"step1-equipement_age-1-5\"\n                                                name=\"equipement_age\"\n                                                value=\"1-5\"\n                                                class=\"contact-form__group-input contact-form__group-input--checkable\"\n                                                                                            >\n\n                                            <strong class=\"contact-form__group-text-main\">1–5 years</strong>\n                                                                                    </label>\n                                                                            <label for=\"step1-equipement_age-6-10\" class=\"contact-form__group-item\">\n                                            <input\n                                                type=\"radio\"\n                                                id=\"step1-equipement_age-6-10\"\n                                                name=\"equipement_age\"\n                                                value=\"6-10\"\n                                                class=\"contact-form__group-input contact-form__group-input--checkable\"\n                                                                                            >\n\n                                            <strong class=\"contact-form__group-text-main\">6–10 years</strong>\n                                                                                    </label>\n                                                                            <label for=\"step1-equipement_age-10-plus\" class=\"contact-form__group-item\">\n                                            <input\n                                                type=\"radio\"\n                                                id=\"step1-equipement_age-10-plus\"\n                                                name=\"equipement_age\"\n                                                value=\"10-plus\"\n                                                class=\"contact-form__group-input contact-form__group-input--checkable\"\n                                                                                            >\n\n                                            <strong class=\"contact-form__group-text-main\">10+ years</strong>\n                                                                                    </label>\n                                                                            <label for=\"step1-equipement_age-unsure\" class=\"contact-form__group-item\">\n                                            <input\n                                                type=\"radio\"\n                                                id=\"step1-equipement_age-unsure\"\n                                                name=\"equipement_age\"\n                                                value=\"unsure\"\n                                                class=\"contact-form__group-input contact-form__group-input--checkable\"\n                                                                                            >\n\n                                            <strong class=\"contact-form__group-text-main\">Not Sure</strong>\n                                                                                    </label>\n                                                                    </div>\n                                </fieldset><div class=\"contact-form__group contact-form__group--select\" data-conditional=\"[{&quot;field&quot;:&quot;service_type&quot;,&quot;value&quot;:[&quot;inspection-repair&quot;]}]\"><label class=\"contact-form__group-label\" for=\"step1-inspection_repair_type\">What kind of inspection or repair do you need?</label>                                <select\n                                    id=\"step1-inspection_repair_type\"\n                                    name=\"inspection_repair_type\"\n                                    class=\"contact-form__group-input contact-form__group-input--select\"\n                                                                                                        >\n                                    <option value=\"\" disabled selected>–</option>                                                <option value=\"basic\">\n                                                    Basic                                                </option>\n                                                                                                <option value=\"thorough\">\n                                                    In-Depth                                                </option>\n                                                                                </select>\n                                </div><div class=\"contact-form__group contact-form__group--textarea\"><label class=\"contact-form__group-label\" for=\"step1-issue_description\">Describe your issue in detail</label>                                <textarea\n                                    id=\"step1-issue_description\"\n                                    name=\"issue_description\"\n                                    class=\"contact-form__group-input contact-form__group-input--textarea\"\n                                    placeholder=\"e.g. Heating not working, Weak airflow…\"                                                                                                        ></textarea>\n                                </div>                        <a href=\"#step2\" class=\"cta\" data-cta-type=\"solid\" data-cta-level=\"primary\" data-cta-minwidth=\"false\">Continue</a>\n                                    </section>\n                <hr>                <section class=\"flow\" id=\"step2\">\n                    <p class=\"h6 has-gray-dark-color\">Step 2</p>\n                    <h2 class=\"h1\" id=\"step2-heading\">Select Date & Time Preference</h2>\n                    <div class=\"contact-form__group contact-form__group--calendar\"><label class=\"contact-form__group-label visually-hidden\" for=\"step2-datetime_preference_date\">Date preference</label>                                <input type=\"date\"\n                                    id=\"step2-datetime_preference_date\"\n                                    name=\"datetime_preference_date\"\n                                    class=\"contact-form__group-input contact-form__group-input--calendar\"\n                                                                        value=\"2026-09-22\"                                    min=\"2026-09-22\"                                                                        required                                >\n                                </div><fieldset class=\"contact-form__group contact-form__group--radio\"><legend class=\"contact-form__group-label\">Time of day preference</legend>                                <div>\n                                                                            <label for=\"step2-datetime_preference_time-morning\" class=\"contact-form__group-item\">\n                                            <input\n                                                type=\"radio\"\n                                                id=\"step2-datetime_preference_time-morning\"\n                                                name=\"datetime_preference_time\"\n                                                value=\"morning\"\n                                                class=\"contact-form__group-input contact-form__group-input--checkable\"\n                                                required                                            >\n\n                                            <strong class=\"contact-form__group-text-main\">Morning (8:00AM – 11:30AM)</strong>\n                                                                                    </label>\n                                                                            <label for=\"step2-datetime_preference_time-afternoon\" class=\"contact-form__group-item\">\n                                            <input\n                                                type=\"radio\"\n                                                id=\"step2-datetime_preference_time-afternoon\"\n                                                name=\"datetime_preference_time\"\n                                                value=\"afternoon\"\n                                                class=\"contact-form__group-input contact-form__group-input--checkable\"\n                                                                                            >\n\n                                            <strong class=\"contact-form__group-text-main\">Afternoon (12:00PM – 5PM)</strong>\n                                                                                    </label>\n                                                                    </div>\n                                </fieldset>                    <label for=\"wtp_link_url\" class=\"wtp_winniethepooh visually-hidden\" aria-hidden=\"true\">\n                        Your website link URL\n                        <input id=\"wtp_link_url\" type=\"url\" name=\"_wtp_link_url\" autocomplete=\"off\" tabindex=\"-1\"/>\n                    </label>\n                                            <a href=\"#step3\" class=\"cta\" data-cta-type=\"solid\" data-cta-level=\"primary\" data-cta-minwidth=\"false\">Continue</a>\n                                    </section>\n                <hr>                <section class=\"flow\" id=\"step3\">\n                    <p class=\"h6 has-gray-dark-color\">Step 3</p>\n                    <h2 class=\"h1\" id=\"step3-heading\">Your Contact Information</h2>\n                    <div class=\"contact-form__section contact-form__section--split\"><div class=\"contact-form__group contact-form__group--text contact-form__group--half contact-form__group--inset-label\"><label class=\"contact-form__group-label\" for=\"step3-contact_first_name\">First name</label>                                <input type=\"text\"\n                                    id=\"step3-contact_first_name\"\n                                    name=\"contact_first_name\"\n                                    class=\"contact-form__group-input contact-form__group-input--text\"\n                                                                                                            autocomplete=\"given-name\"                                    required                                >\n                                </div><div class=\"contact-form__group contact-form__group--text contact-form__group--half contact-form__group--inset-label\"><label class=\"contact-form__group-label\" for=\"step3-contact_last_name\">Last name</label>                                <input type=\"text\"\n                                    id=\"step3-contact_last_name\"\n                                    name=\"contact_last_name\"\n                                    class=\"contact-form__group-input contact-form__group-input--text\"\n                                                                                                            autocomplete=\"family-name\"                                    required                                >\n                                </div><div class=\"contact-form__group contact-form__group--email contact-form__group--half contact-form__group--inset-label\"><label class=\"contact-form__group-label\" for=\"step3-contact_email\">Email</label>                                <input type=\"email\"\n                                    id=\"step3-contact_email\"\n                                    name=\"contact_email\"\n                                    class=\"contact-form__group-input contact-form__group-input--text\"\n                                    placeholder=\"e.g. me@example.com\"                                                                        autocomplete=\"email\"                                    required                                >\n                                </div><div class=\"contact-form__group contact-form__group--tel contact-form__group--half contact-form__group--inset-label\"><label class=\"contact-form__group-label\" for=\"step3-contact_phone\">Phone Number</label>                                <input type=\"tel\"\n                                    id=\"step3-contact_phone\"\n                                    name=\"contact_phone\"\n                                    class=\"contact-form__group-input contact-form__group-input--text\"\n                                    placeholder=\"e.g. (###) ###-####\"                                    pattern=\"\\(?[0-9]{3}\\)?( |-)?[0-9]{3}( |-)?[0-9]{4}\"                                    autocomplete=\"tel-national\"                                    required                                >\n                                </div><div class=\"contact-form__group contact-form__group--text contact-form__group--full contact-form__group--inset-label\"><label class=\"contact-form__group-label\" for=\"step3-contact_address_street\">Street Address</label>                                <input type=\"text\"\n                                    id=\"step3-contact_address_street\"\n                                    name=\"contact_address_street\"\n                                    class=\"contact-form__group-input contact-form__group-input--text\"\n                                                                                                            autocomplete=\"address-line1\"                                    required                                >\n                                </div><div class=\"contact-form__group contact-form__group--text contact-form__group--full contact-form__group--inset-label\"><label class=\"contact-form__group-label\" for=\"step3-contact_address_additional\">Additional Address Info</label>                                <input type=\"text\"\n                                    id=\"step3-contact_address_additional\"\n                                    name=\"contact_address_additional\"\n                                    class=\"contact-form__group-input contact-form__group-input--text\"\n                                                                                                            autocomplete=\"address-line2\"                                                                    >\n                                </div><div class=\"contact-form__group contact-form__group--text contact-form__group--half contact-form__group--inset-label\"><label class=\"contact-form__group-label\" for=\"step3-contact_address_city\">City</label>                                <input type=\"text\"\n                                    id=\"step3-contact_address_city\"\n                                    name=\"contact_address_city\"\n                                    class=\"contact-form__group-input contact-form__group-input--text\"\n                                                                                                            autocomplete=\"address-level2\"                                    required                                >\n                                </div><div class=\"contact-form__group contact-form__group--select contact-form__group--half contact-form__group--inset-label\"><label class=\"contact-form__group-label\" for=\"step3-contact_address_state\">State</label>                                <select\n                                    id=\"step3-contact_address_state\"\n                                    name=\"contact_address_state\"\n                                    class=\"contact-form__group-input contact-form__group-input--select\"\n                                    autocomplete=\"address-level1\"                                    required                                >\n                                                                                    <option value=\"NC\">\n                                                    North Carolina                                                </option>\n                                                                                </select>\n                                </div><div class=\"contact-form__group contact-form__group--text contact-form__group--half contact-form__group--inset-label\"><label class=\"contact-form__group-label\" for=\"step3-contact_address_zip\">ZIP</label>                                <input type=\"text\"\n                                    id=\"step3-contact_address_zip\"\n                                    name=\"contact_address_zip\"\n                                    class=\"contact-form__group-input contact-form__group-input--text\"\n                                                                                                            autocomplete=\"postal-code\"                                    required                                >\n                                </div></div>                        <button type=\"submit\" class=\"cta\" data-cta-type=\"solid\" data-cta-level=\"primary\" data-cta-minwidth=\"false\">Submit</button>\n                                    </section>\n                        </form>\n        <script>\n            const contactFormStorageKey = \"SchedulerFormData\";\n            function getFormData(form) {\n                if (!form) { return; }\n                const formData = Object.fromEntries(new FormData(form).entries().filter(entry => entry[0].indexOf('_') !== 0 && entry[1] !== '')); // Don't keep keys with that start with an underscore or don't have a value\n                return formData;\n            }\n            function saveFormToLocalStorage(form) {\n                if (!form) { return; }\n                const formData = getFormData(form);\n                window.localStorage.setItem(contactFormStorageKey, JSON.stringify(formData));\n            }\n            function toggleCondtionalFields(form) {\n                if (!form) { return; }\n                const formData = getFormData(form);\n                const conditionalGroups = Array.from(form.querySelectorAll('[data-conditional]')).forEach((group) => {\n                    const conditions = JSON.parse(group.getAttribute('data-conditional'));\n                    let isShown = false;\n                    conditions.forEach((condition) => {\n                        const field = condition.field;\n                        const value = condition.value || undefined;\n\n                        if (formData.hasOwnProperty(field) && value === undefined) {\n                            isShown = true;\n                        } else if (formData.hasOwnProperty(field) && value) {\n                            isShown = value.includes(formData[field]);\n                        }\n                    });\n                    group.hidden = !isShown;\n                });\n            }\n            document.addEventListener('DOMContentLoaded', function(e) {\n                const form = document.querySelector('[data-scheduler-form]');\n                if (!form) { return; }\n                const savedData = JSON.parse(window.localStorage.getItem(contactFormStorageKey)) || {};\n                for (let field in savedData) {\n                    const storedValue = savedData[field];\n                    const fieldElement = form.querySelector(`[name=\"${field}\"]`);\n                    if (['radio','checkbox'].includes(fieldElement.type)) {\n                        const fieldElements = Array.from(form.querySelectorAll(`[name=\"${field}\"]`));\n                        fieldElements.forEach((fieldEl) => {\n                            if (fieldEl.value === storedValue) {\n                                fieldEl.checked = true;\n                            }\n                        })\n                    } else {\n                        if (storedValue) { fieldElement.value = storedValue; }\n                    }\n                }\n                toggleCondtionalFields(form);\n            });\n            document.addEventListener('change', function (e) {\n                const form = e.target.closest('[data-scheduler-form]');\n                if (!form) { return; }\n                saveFormToLocalStorage(form);\n                toggleCondtionalFields(form);\n            });\n            document.addEventListener('submit', function (e) {\n                const form = e.target.closest('[data-scheduler-form]');\n                if (!form) { return; }\n                saveFormToLocalStorage(form);\n                const isFormValid = form.checkValidity();\n\n                if (!isFormValid) {\n                    return;\n                }\n\n                Array.from(form.querySelectorAll('[type=\"submit\"]')).forEach((submit) => {\n                    submit.innerText = 'Submitting...';\n                    submit.disabled = true;\n                })\n            });\n        </script>\n\n</div>\n\n<div class=\"wp-block-group asymmetric-side has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\"><div  class=\"card card--page has-white-background-color has-black-color\">\n        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Have a question?\" aria-label=\"Have a question?\">Have a question?</p>\n\n                    <div class=\"card__content__description card__description\"><div class=\"flow\"><p>Let’s connect and have a quick conversation to see how we can help.</p>\n<a href=\"tel:+13362819025\" aria-label=\"Call now: +13362819025\" data-cta-gap=\"md\" data-cta-type=\"outline\" data-cta-content=\"mixed\" data-cta-minwidth=\"true\" class=\"cta phone-link\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-phone\" /></svg><span data-show-on=\"desktop\">(336) 281-9025</span>\n        <span data-show-on=\"mobile\">Call Now</span>\n</a></div></div>\n\n                </div></div>\n\n</div>\n</div>\n</div>\n\n<style>\n.container.py-5 {\npadding-top: 4rem !important;\n}\n</style>\n\t</div>\n\t</article><!-- #post-2712 -->"

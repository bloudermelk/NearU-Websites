  "html": "<article id=\"post-5567\" class=\"container post-5567 page type-page status-publish has-post-thumbnail hentry\">\n\n\t<div class=\"entry-content | container\">\n\t\t<section  class=\"container section--services-hero pt-5 services-hero\">\n\t<div class=\"section--services-hero__main\">\n\t\t<div class=\"section--services-hero__main__row\">\n\t\t\t<div class=\"section--services-hero__main__row__left\">\n                <div class=\"acf-innerblocks-container\">\n\n<div class=\"wp-block-group full-width-mobile is-vertical is-layout-flex wp-container-core-group-is-layout-2c90304e wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group flow center-content-mobile full-width-mobile has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<div class=\"wp-block-group h-align icon-plus-title is-layout-flex wp-block-group-is-layout-flex\">    <div class=\"iconblock wp-elements-1 has-background has-red-background-color has-text-color has-secondary-inverse-color\" data-size=\"md\" data-padding=\"2\" data-display=\"inline\">\n        <svg class=\"icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-info\" /></svg>    </div>\n\n<h1 class=\"wp-block-heading has-primary-inverse-color has-text-color has-link-color has-x-large-font-size wp-elements-2\">HVAC, Plumbing &amp; Indoor Air Quality Services in Cedar Grove, NC </h1>\n</div>\n\n<p class=\"wp-block-paragraph\">Happy Home Services takes care of heating, cooling, plumbing, and indoor air quality for the farm country of northern Orange County, with prices quoted before work starts and a phone line that never closes. Cedar Grove properties run on wells, septic, and propane far more often than on municipal utilities, and our technicians are equipped for exactly that.&nbsp;</p>\n\n<p class=\"wp-block-paragraph\">Working farmsteads and older farmhouses around Cedar Grove bring service needs that suburban houses never see. A pressure tank that short-cycles, iron staining every fixture, a furnace burning propane trucked in each winter: these are ordinary calls for us. Newer custom homes on wooded acreage get the same rural-literate service with modern equipment. </p>\n\n<div class=\"wp-block-group mb-1 full-width-mobile is-content-justification-left is-nowrap is-layout-flex wp-container-core-group-is-layout-a1b15d37 wp-block-group-is-layout-flex\">\n<div  class=\"wp-block-group mb-3 full-width-mobile schedule-and-call-cta is-content-justification-left is-nowrap is-layout-flex wp-container-core-group-is-layout-a1b15d37 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group schedule-cta-container is-vertical is-content-justification-stretch is-layout-flex wp-container-core-group-is-layout-41171c72 wp-block-group-is-layout-flex\">\n<a href=\"/bookings\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta se-widget-button\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-event\" /></svg><span >Schedule Now</span>\n\n</a>\n\n    <p class=\"horizon-text has-secondary-font-family wp-block-paragraph\" style=\"text-transform:uppercase\">or speak with an expert!</p>\n\n<a href=\"tel:+13362819025\" aria-label=\"Call now: +13362819025\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta phone-link\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-phone\" /></svg><span data-show-on=\"desktop\">(336) 281-9025</span>\n        <span data-show-on=\"mobile\">Call Now</span>\n</a>\n\n<p class=\"has-black-color has-text-color has-link-color has-secondary-font-family has-small-font-size text-center wp-elements-3 wp-block-paragraph\" style=\"text-transform:uppercase\"><strong>Same Day Appointments Available by Phone</strong></p>\n</div>\n</div>\n</div>\n\n<div  class=\"badge mb-3\" style='min-height:unset;'>\n    <div class=\"badge__content\">\n        <svg width=\"45\" height=\"45\" viewBox=\"0 0 45 45\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <title>Google</title>\n            <path d=\"M42.0046 22.9145C42.0046 21.4661 41.8746 20.0733 41.6332 18.7363H22.395V26.647H33.3882C32.9054 29.191 31.457 31.3451 29.2844 32.7935V37.9373H35.9137C39.7762 34.372 42.0046 29.1353 42.0046 22.9145Z\" fill=\"#4285F4\"/>\n            <path d=\"M22.396 42.8766C27.9112 42.8766 32.535 41.0568 35.9147 37.9371L29.2854 32.7933C27.4655 34.0189 25.1443 34.7617 22.396 34.7617C17.0851 34.7617 12.5727 31.1777 10.9571 26.3496H4.16064V31.6234C7.52175 38.2899 14.4111 42.8766 22.396 42.8766Z\" fill=\"#34A853\"/>\n            <path d=\"M10.9608 26.3308C10.5523 25.1052 10.3109 23.8053 10.3109 22.4498C10.3109 21.0942 10.5523 19.7943 10.9608 18.5687V13.2949H4.16436C2.77164 16.0432 1.97314 19.1444 1.97314 22.4498C1.97314 25.7551 2.77164 28.8563 4.16436 31.6046L9.45671 27.4821L10.9608 26.3308Z\" fill=\"#FBBC05\"/>\n            <path d=\"M22.396 10.155C25.4043 10.155 28.0783 11.1949 30.2138 13.2004L36.0633 7.35097C32.5165 4.04557 27.9112 2.02148 22.396 2.02148C14.4111 2.02148 7.52175 6.60818 4.16064 13.2933L10.9571 18.567C12.5727 13.7389 17.0851 10.155 22.396 10.155Z\" fill=\"#EA4335\"/>\n        </svg>\n        <div class=\"badge__content__rating-container\">\n            <p class=\"h6 badge__content__rating-container__title\">Google Rating</p>\n            <div class=\"badge__content__rating-container__stars\">\n                <div class=\"badge__content__rating-container__stars__number\">\n                    5                </div>\n                <div class=\"badge__content__rating-container__stars__container\">\n                    <div class=\"badge__content__rating-container__stars__container__black\">★★★★★</div>\n                    <div aria-hidden=\"true\" class=\"badge__content__rating-container__stars__container__white\">☆☆☆☆☆</div>\n                </div>\n            </div>\n                    </div>\n    </div>\n    </div></div>\n</div>\n\n</div>\n\t\t\t</div><!-- ./left -->\n\t\t\t<div class=\"section--services-hero__main__row__right\">\n\t\t\t<div class=\"elevated content-fullbleed-mobile box-shadow-lg border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\t\t\t<figure class=\"wp-block-post-featured-image\"><img decoding=\"async\" width=\"2560\" height=\"1707\" src=\"/images/2024/10/NU-HappyHome_Group-Shot-10-scaled.jpg\" class=\"attachment-post-thumbnail size-post-thumbnail wp-post-image\" alt=\"Happy Home team dedicated to providing top quality HVAC, Plumbing, and Indoor Air Quality all across Raleigh-Durham\" style=\"object-fit:cover;\" srcset=\"/images/2024/10/NU-HappyHome_Group-Shot-10-scaled.jpg 2560w, /images/2024/10/NU-HappyHome_Group-Shot-10-300x200.jpg 300w, /images/2024/10/NU-HappyHome_Group-Shot-10-1024x683.jpg 1024w, /images/2024/10/NU-HappyHome_Group-Shot-10-768x512.jpg 768w, /images/2024/10/NU-HappyHome_Group-Shot-10-1536x1024.jpg 1536w, /images/2024/10/NU-HappyHome_Group-Shot-10-2048x1365.jpg 2048w\" sizes=\"(max-width: 1010px) 100vw, (max-width: 1440px) 50vw, 768px\" /></figure>\n\t\t\t</div>\n</div>\t\t\t</div><!-- ./right -->\n\t\t</div><!-- ./row -->\n\n</div>\n\t<div class=\"section--services-hero__main section--services-hero__main--empty has-background has-secondary-background-color\">\n\t</div><!-- ./row -->\n\n</section>\n\n<div class=\"wp-block-group container flow pb-4 has-secondary-inverse-color has-primary-background-color has-text-color has-background\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--60)\">\n<div class=\"wp-block-group wrap-mobile flow pb-4 has-primary-inverse-color has-text-color has-link-color wp-elements-4 is-horizontal is-nowrap is-layout-flex wp-container-core-group-is-layout-cdbf0242 wp-block-group-is-layout-flex\" style=\"margin-top:0;margin-bottom:0;padding-top:0;padding-bottom:0\">\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-db3ccc14 wp-block-columns-is-layout-flex\" style=\"margin-top:0;margin-bottom:0;padding-top:0;padding-bottom:0\">\n<div class=\"wp-block-column flow is-layout-flow wp-block-column-is-layout-flow\">\n<div class=\"wp-block-group has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h5 class=\"wp-block-heading\">Heating and Cooling Without a Gas Main </h5>\n\n<p class=\"wp-block-paragraph\">Natural gas does not reach the Cedar Grove countryside, so homes here heat with electric heat pumps, propane furnaces, or a pairing of the two. Sizing matters more on larger rural homes, and we calculate loads before recommending equipment.&nbsp;</p>\n\n<p class=\"wp-block-paragraph\"><a href=\"/services/heating/heat-pumps\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Heat Pump and Furnace Services</strong></a>&nbsp;We install, repair, and&nbsp;maintain&nbsp;the heat pumps and propane furnaces that carry Cedar Grove winters. A&nbsp;<a href=\"/services/cooling/dual-fuel-hybrid-systems\" target=\"_blank\" rel=\"noreferrer noopener\">dual-fuel hybrid system</a>&nbsp;runs&nbsp;the heat pump until deep cold makes propane cheaper, then switches automatically.&nbsp;</p>\n\n<p class=\"wp-block-paragraph\"><a href=\"/services/cooling/air-conditioning\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Air Conditioning Services in Cedar Grove</strong></a>&nbsp;Long humid summers demand dependable cooling. We install, repair, and tune up every major brand and size&nbsp;replacements&nbsp;to the actual house rather than the nameplate of the old unit.&nbsp;</p>\n\n<p class=\"wp-block-paragraph\"><a href=\"/services/cooling/mini-split\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Ductless Mini-Split Systems</strong></a>&nbsp;Farmhouse additions, workshops, and converted outbuildings rarely have duct runs. Mini-splits&nbsp;heat and cool those spaces independently without renovation.&nbsp;</p>\n</div>\n\n<div class=\"wp-block-group has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h5 class=\"wp-block-heading\">Country Air Has Its Own Challenges </h5>\n\n<p class=\"wp-block-paragraph\">Field dust, gravel-road grit, and heavy spring pollen surround a Cedar Grove home, and the damp crawl space under an older farmhouse adds moisture from below. We treat each source directly.&nbsp;</p>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"/services/dehumidifiers\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Crawlspace and Whole-Home Dehumidifiers</strong></a>: Drying the crawl space&nbsp;protects sills and joists&nbsp;and keeps musty air out of the living space above.&nbsp;</li>\n</ul>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"/services/indoor-air-quality/air-ducts\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Air Duct Cleaning and Sealing</strong></a>: Sealed, clean ductwork stops the system from pulling crawl space air and dust into every room.&nbsp;</li>\n</ul>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"/services/indoor-air-quality/air-purifiers\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Air Filtration and Purification</strong></a>: High-efficiency filtration handles the particle load that rural surroundings generate year-round.&nbsp;</li>\n</ul>\n</div>\n</div>\n\n<div class=\"wp-block-column flow is-layout-flow wp-block-column-is-layout-flow\">\n<div class=\"wp-block-group has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h5 class=\"wp-block-heading\">Well Systems and Farmhouse Plumbing </h5>\n\n<p class=\"wp-block-paragraph\">Nearly every&nbsp;Cedar Grove property draws from a private well, and northern Orange County groundwater commonly carries hardness, iron, manganese, sulfur odor, or acidity that eats at pipe over time. Treating the specific problem starts with testing the specific water, which is where we begin every treatment job.&nbsp;</p>\n\n<p class=\"wp-block-paragraph\"><a href=\"/services/plumbing/well-pump\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Well Pump Services</strong></a>&nbsp;A dead pump leaves the whole property&nbsp;dry,&nbsp;livestock troughs included. We repair and replace pumps, pressure tanks, and controls to get water moving again fast.&nbsp;</p>\n\n<p class=\"wp-block-paragraph\"><a href=\"/services/plumbing/water-treatment-filtration\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Water Treatment and Filtration</strong></a>&nbsp;Softening, iron and sediment filtration, pH neutralizing, and UV purification, combined according to what your water test&nbsp;actually shows.&nbsp;</p>\n\n<p class=\"wp-block-paragraph\"><a href=\"/services/plumbing/water-heater-installation-replacements\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Water Heater Installation and Replacement</strong></a>&nbsp;Untreated well water shortens water heater life, so we pair the right tank or tankless unit with the right treatment upstream and match fuel to electric or propane supply.&nbsp;</p>\n\n<p class=\"wp-block-paragraph\"><a href=\"/services/plumbing/frozen-burst-pipe-repair\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Frozen and Burst Pipe Repair</strong></a>&nbsp;Long supply runs to barns and outbuildings freeze before anything else on the property. We repair&nbsp;breaks fast&nbsp;and help insulate vulnerable lines before winter. Everyday&nbsp;<a href=\"/services/plumbing/kitchen-bathroom\" target=\"_blank\" rel=\"noreferrer noopener\">kitchen and bathroom plumbing</a>&nbsp;work is on the truck too.&nbsp;</p>\n</div>\n</div>\n</div>\n</div>\n</div>\n\n<div class=\"wp-block-group has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h4 class=\"wp-block-heading\">Rural Work Is Our Regular Work </h4>\n\n<p class=\"wp-block-paragraph\">Plenty of contractors treat a well property as an exception. For us it is a Tuesday, and our trained technicians carry the parts and testing equipment rural calls require. Pricing is quoted upfront before any work begins, and the phone is staffed 24/7 because pump failures ignore business hours. Call or book online to schedule service in Cedar Grove. </p>\n</div>\n\n<div  class=\"accordion\" style=\"--_accordion-separator-color: #076395\">\n            <details class=\"accordion-item\" data-custom-open=\"true\" open>\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Is well service available for Cedar Grove properties? </p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p>Yes, it is one of our core services in northern Orange County. We handle pump and pressure tank repair and replacement plus treatment for hardness, iron, sediment, and odor.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">What causes rust stains and sulfur smells in my well water? </p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p>Iron produces the staining and hydrogen sulfide produces the rotten-egg odor, and both are common in Piedmont groundwater. A water test tells us the concentrations, and the right filtration and neutralizing equipment corrects them.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Can you service a propane furnace out in the county? </p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p>Yes. Propane furnaces, heat pumps, and the dual-fuel systems that pair them are the standard equipment mix for homes beyond the gas mains, and we install and service all of them.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Who answers if my heat fails on a winter night in Cedar Grove? </p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p>We do. The line is staffed 24/7, rural addresses included, and a home without heat in January gets emergency priority.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Do you cover other northern Orange County communities? </p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p>Hillsborough, Efland, and Hurdle Mills are all within our range. Check the Service Areas menu for the complete list.</p>\n                </div>\n            </div>\n        </details>    </div>\n\n<div class=\"wp-block-group container flow py-5\">\n<h2 class=\"wp-block-heading\">Powered by NearU — We’re here to make your HVAC Service experience the best one yet!</h2>\n\n<figure class=\"wp-block-image size-full is-resized\"><img decoding=\"async\" width=\"430\" height=\"98\" src=\"/images/2024/02/NearU.png\" alt=\"NearU\" class=\"wp-image-36\" style=\"width:220px\" srcset=\"/images/2024/02/NearU.png 430w, /images/2024/02/NearU-300x68.png 300w\" sizes=\"(max-width: 430px) 100vw, 430px\" /></figure>\n\n<p class=\"wp-block-paragraph\">NearU is setting up a new standard of HVAC, plumbing, drains, IAQ, and generator services with major improvements to reliability, convenience, and customer care. We equip our companies with better resources, training, and tools, so they can provide you with the best possible service outcome. If you’ve recently learned that your go-to HVAC, plumbing, drains, IAQ, and generator company has joined NearU, then this is something to get excited about! We protect the people and culture that make each company great, while ensuring their customers consistently receive the best possible care.</p>\n</div>\n\t</div>\n\t</article><!-- #post-5567 -->"
}
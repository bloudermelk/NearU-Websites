  "html": "<article id=\"post-6098\" class=\"container post-6098 page type-page status-publish has-post-thumbnail hentry\">\n\n\t<div class=\"entry-content | container\">\n\t\t<section  class=\"container section--services-hero pt-5 services-hero\">\n\t<div class=\"section--services-hero__main\">\n\t\t<div class=\"section--services-hero__main__row\">\n\t\t\t<div class=\"section--services-hero__main__row__left\">\n                <div class=\"acf-innerblocks-container\">\n\n<div class=\"wp-block-group full-width-mobile is-vertical is-layout-flex wp-container-core-group-is-layout-2c90304e wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group flow center-content-mobile full-width-mobile has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<div class=\"wp-block-group h-align icon-plus-title is-layout-flex wp-block-group-is-layout-flex\">    <div class=\"iconblock wp-elements-1 has-background has-red-background-color has-text-color has-secondary-inverse-color\" data-size=\"md\" data-padding=\"2\" data-display=\"inline\">\n        <svg class=\"icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-toolbox\" /></svg>    </div>\n\n<h1 class=\"wp-block-heading has-secondary-color has-text-color has-link-color has-x-large-font-size wp-elements-2\">Careers at Happy Home Services</h1>\n</div>\n\n<p class=\"wp-block-paragraph\">Happy Home is setting up a new standard of HVAC, plumbing, drains, and Indoor Air Quality services with major improvements to reliability, convenience, and customer care. We equip our technicians with resources, training, and tools, so they can provide you with the best possible service outcome. Come join us; we protect the people and culture that make our branch great while ensuring our customers consistently receive the best possible care.</p>\n\n<p class=\"wp-block-paragraph\">We have opportunities for skilled, experienced field team and office personnel. We offer excellent compensation packages, health benefits, company vehicle (field), and career advancement opportunities. Join an exceptional company with exceptional people that can furnish the right person an exciting and rewarding career.</p>\n</div>\n</div>\n\n<div style=\"height:20px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<div style=\"height:20px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\n<a href=\"https://jobs.dayforcehcm.com/en-us/nearu/happyhome\" target=\"_blank\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"false\" class=\"cta\">\n    <span >View Open Positions</span>\n        <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronright\" /></svg>\n</a>\n</div>\n\t\t\t</div><!-- ./left -->\n\t\t\t<div class=\"section--services-hero__main__row__right\">\n\t\t\t<div class=\"elevated content-fullbleed-mobile box-shadow-lg border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\t\t\t<figure class=\"wp-block-post-featured-image\"><img decoding=\"async\" width=\"1916\" height=\"1280\" src=\"/images/2024/03/A-Happy-Home-Services-technician-behind-the-wheel-of-a-Happy-Home-Services-van.jpg\" class=\"attachment-post-thumbnail size-post-thumbnail wp-post-image\" alt=\"A Happy Home Services technician behind the wheel of a Happy Home Services van\" style=\"object-fit:cover;\" srcset=\"/images/2024/03/A-Happy-Home-Services-technician-behind-the-wheel-of-a-Happy-Home-Services-van.jpg 1916w, /images/2024/03/A-Happy-Home-Services-technician-behind-the-wheel-of-a-Happy-Home-Services-van-300x200.jpg 300w, /images/2024/03/A-Happy-Home-Services-technician-behind-the-wheel-of-a-Happy-Home-Services-van-1024x684.jpg 1024w, /images/2024/03/A-Happy-Home-Services-technician-behind-the-wheel-of-a-Happy-Home-Services-van-768x513.jpg 768w, /images/2024/03/A-Happy-Home-Services-technician-behind-the-wheel-of-a-Happy-Home-Services-van-1536x1026.jpg 1
  "html": "<article id=\"post-1325\" class=\"container post-1325 page type-page status-publish has-post-thumbnail hentry\">\n\n\t<div class=\"entry-content | container\">\n\t\t<section  class=\"container section--services-hero pt-5 services-hero\">\n\t<div class=\"section--services-hero__main\">\n\t\t<div class=\"section--services-hero__main__row\">\n\t\t\t<div class=\"section--services-hero__main__row__left\">\n                <div class=\"acf-innerblocks-container\">\n\n<div class=\"wp-block-group flow has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<div class=\"wp-block-group h-align icon-plus-title is-layout-flex wp-block-group-is-layout-flex\">    <div class=\"iconblock wp-elements-1 has-background has-red-background-color has-text-color has-secondary-inverse-color\" data-size=\"md\" data-padding=\"2\" data-display=\"inline\">\n        <svg class=\"icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-wrench\" /></svg>    </div>\n\n<h1 class=\"wp-block-heading has-red-color has-text-color has-link-color has-x-large-font-size wp-elements-2\">Maintenance Plans</h1>\n</div>\n\n<div class=\"wp-block-group is-layout-flex wp-block-group-is-layout-flex\">\n<p class=\"wp-block-paragraph\">A maintenance plan is a wise choice for homeowners. With our VIP Club, you receive benefits like up to 25% off repairs, same-day service, a triple labor warranty, and convenient service reminders. It offers peace of mind and cost savings, ensuring your HVAC and plumbing systems are well-maintained and operating efficiently. Join the VIP Club to extend the lifespan of your equipment and avoid unexpected breakdowns and costly repairs.</p>\n</div>\n\n<div class=\"wp-block-group mb-3 is-content-justification-left is-nowrap is-layout-flex wp-container-core-group-is-layout-a1b15d37 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group full-width-mobile is-vertical is-content-justification-stretch is-layout-flex wp-container-core-group-is-layout-41171c72 wp-block-group-is-layout-flex\">\n<p class=\"horizon-text has-secondary-font-family wp-block-paragraph\" style=\"text-transform:uppercase\">Speak with an expert</p>\n\n<a href=\"tel:+13362819025\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"icon\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-phone\" /></svg><span>(336) 281-9025</span>\n</a>\n\n<p class=\"text-center has-primary-inverse-color has-text-color has-link-color has-secondary-font-family has-small-font-size wp-elements-3 wp-block-paragraph\" style=\"text-transform:uppercase\"><strong>Same day appointments available by phone</strong></p>\n</div>\n</div>\n</div>\n\n</div>\n\t\t\t</div><!-- ./left -->\n\t\t\t<div class=\"section--services-hero__main__row__right\">\n\t\t\t<div class=\"elevated content-fullbleed-mobile box-shadow-lg border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\t\t\t<figure class=\"wp-block-post-featured-image\"><img decoding=\"async\" width=\"1920\" height=\"1280\" src=\"/images/2024/03/A-Happy-Home-Services-technician-retrieving-tools-from-the-service-truck.jpg\" class=\"attachment-post-thumbnail size-post-thumbnail wp-post-image\" alt=\"A Happy Home Services technician retrieving tools from the service truck\" style=\"object-fit:cover;\" srcset=\"/images/2024/03/A-Happy-Home-Services-technician-retrieving-tools-from-the-service-truck.jpg 1920w, /images/2024/03/A-Happy-Home-Services-technician-retrieving-tools-from-the-service-truck-300x200.jpg 300w, /images/2024/03/A-Happy-Home-Services-technician-retrieving-tools-from-the-service-truck-1024x683.jpg 1024w, /images/2024/03/A-Happy-Home-Services-technician-retrieving-tools-from-the-service-truck-768x512.jpg 768w, /images/2024/03/A-Happy-Home-Services-technician-retrieving-tools-from-the-service-truck-1536x1024.jpg 1536w\" sizes=\"(max-width: 1010px) 100vw, (max-width: 1440px) 50vw, 768px\" /></figure>\n\t\t\t</div>\n</div>\t\t\t</div><!-- ./right -->\n\t\t</div><!-- ./row -->\n\n</div>\n\t<div class=\"section--services-hero__main section--services-hero__main--empty has-background has-secondary-background-color\">\n\t</div><!-- ./row -->\n\n</section>\n\n<div class=\"wp-block-group container pb-5 has-secondary-background-color has-background\"><div  class=\"card mt-5 p-3 border-radius-sm flow align-self-center card--wide has-white-background-color\" style=\"\">\n            <div class=\"acf-innerblocks-container\">\n\n<div class=\"wp-block-group h-decorator h-decorator--primary is-content-justification-space-between is-nowrap is-layout-flex wp-container-core-group-is-layout-f36ac205 wp-block-group-is-layout-flex\">\n<h2 class=\"wp-block-heading\">Happy Home Service VIP Club</h2>\n</div>\n\n<div class=\"wp-block-group flow is-vertical is-layout-flex wp-container-core-group-is-layout-2c90304e wp-block-group-is-layout-flex\">\n<p class=\"mt-2 wp-block-paragraph\">Enjoy discounts on repairs, same-day service, and convenient reminders while keeping your HVAC and plumbing systems running smoothly with our VIP maintenance plan.</p>\n\n<div class=\"wp-block-group p-3 mt-2 border-radius-xs has-gray-light-background-color has-background has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<div  class=\"iconlist\" data-orientation=\"vertical\" data-iconsize=\"md\">\n    <ul role=\"list\">\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-wrench\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p><strong>Up to 25% Discount on Repairs:</strong> Ensure your HVAC and plumbing systems receive the attention they need at a discounted rate.</p>\n</p>\n            </div>\n        </li>\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-note\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p><strong>Priority, Same Day Service:</strong> As a VIP member, you receive top priority for same-day service, ensuring your comfort is never compromised.</p>\n</p>\n            </div>\n        </li>\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-clock\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p><strong>No overtime charges:</strong> Enjoy peace of mind knowing you won&#8217;t be charged extra for after-hours or weekend service calls.</p>\n</p>\n            </div>\n        </li>\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-home-with-checkmark\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p><strong>Triple Labor Warranty:</strong> Rest easy with our VIP Maintenance Plan, as we provide an extended labor warranty on all repairs to provide you with added protection.</p>\n</p>\n            </div>\n        </li>\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-price-change\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p><strong>50% Off Minimum Service Fee:</strong> Access affordable service with our VIP Maintenance Plan, benefiting from a reduced minimum service fee.</p>\n</p>\n            </div>\n        </li>\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-check\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p><strong>Flexible Payment Options:</strong> We make it convenient for you to enjoy the benefits of our VIP Maintenance Plan without straining your budget.</p>\n</p>\n            </div>\n        </li>\n                <li class=\"iconlist-item\">\n            <svg class=\"icon iconlist-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-event_blank\" /></svg>            <div class=\"iconlist-text\">\n                <p class=\"iconlist-label\"></p>\n                <p class=\"iconlist-description\"><p><strong>13th Month Free:</strong> When you sign up for a one-year plan, you&#8217;ll receive the 13th month for free, giving you even more value for your investment.</p>\n</p>\n            </div>\n        </li>\n            </ul>\n</div></div>\n</div>\n\n<div class=\"wp-block-group mobile-wrap-and-center align-flex-end is-content-justification-space-between is-nowrap is-layout-flex wp-container-core-group-is-layout-f36ac205 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group card__price is-vertical is-layout-flex wp-container-core-group-is-layout-2c90304e wp-block-group-is-layout-flex\">\n<p class=\"text-uppercase text-upper wp-block-paragraph\">Prices Starting at</p>\n\n<h2 class=\"wp-block-heading\">$16.85 / month</h2>\n</div>\n\n<a href=\"tel:+13362819025\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"icon\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta position-relative\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-phone\" /></svg><span>(336) 281-9025</span>\n</a></div>\n\n</div>\n    </div></div>\n\n        <div  class=\"google-reviews-featured container container py-5 has-background has-gray-light-background-color\">\n    <div class=\"google-reviews-featured__head\">\n        <div class=\"google-reviews-featured__head__logo\">            <svg version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\" viewBox=\"0 0 107.3 35.2\" style=\"enable-background:new 0 0 107.3 35.2;\" xml:space=\"preserve\"><title>Google</title><path fill=\"#4885ED\" d=\"M26.4,12.4H13.9v3.7h8.9c-0.4,5.2-4.8,7.4-8.9,7.4c-5.4,0-9.8-4.3-9.8-9.7c0-0.1,0-0.1,0-0.2 c0-5.6,4.4-10,9.8-10c4.2,0,6.7,2.7,6.7,2.7l2.6-2.7c0,0-3.3-3.7-9.4-3.7C6,0,0,6.5,0,13.6c0,6.9,5.6,13.7,14,13.7 c7.3,0,12.7-5,12.7-12.4C26.6,13.3,26.4,12.4,26.4,12.4L26.4,12.4z\"/><g><path id=\"A\" fill=\"#DB3236\" d=\"M36.6,9.7c-5.1,0-8.8,4-8.8,8.7c0,4.8,3.6,8.8,8.9,8.8c4.8,0,8.7-3.7,8.7-8.7 C45.4,12.7,40.9,9.7,36.6,9.7L36.6,9.7z M36.7,13.2c2.5,0,4.9,2,4.9,5.3c0,3.2-2.4,5.3-4.9,5.3c-2.8,0-5-2.2-5-5.3 C31.7,15.4,33.9,13.2,36.7,13.2L36.7,13.2z\"/></g><g><path id=\"A_00000019641008515513977120000006682861592563020936_\" fill=\"#F4C20D\" d=\"M55.8,9.7c-5.1,0-8.8,4-8.8,8.7 c0,4.8,3.6,8.8,8.9,8.8c4.8,0,8.7-3.7,8.7-8.7C64.6,12.7,60,9.7,55.8,9.7L55.8,9.7z M55.9,13.2c2.5,0,4.9,2,4.9,5.3 c0,3.2-2.4,5.3-4.9,5.3c-2.8,0-5-2.2-5-5.3C50.9,15.4,53,13.2,55.9,13.2L55.9,13.2z\"/></g><path fill=\"#4885ED\" d=\"M74.6,9.7c-4.7,0-8.4,4.1-8.4,8.8c0,5.3,4.3,8.8,8.3,8.8c2.5,0,3.8-1,4.8-2.1v1.7c0,3-1.8,4.8-4.6,4.8 c-2.7,0-4-2-4.5-3.1L66.9,30c1.2,2.5,3.6,5.2,7.9,5.2c4.7,0,8.3-3,8.3-9.1V10.3h-3.7v1.5C78.2,10.5,76.7,9.7,74.6,9.7L74.6,9.7z M75,13.2c2.3,0,4.7,2,4.7,5.3c0,3.4-2.4,5.3-4.7,5.3c-2.5,0-4.9-2-4.9-5.3C70.1,15.2,72.5,13.2,75,13.2L75,13.2z\"/><path fill=\"#DB3236\" d=\"M99.4,9.7c-4.4,0-8.2,3.5-8.2,8.8c0,5.5,4.2,8.8,8.6,8.8c3.7,0,6-2,7.4-3.8l-3-2c-0.8,1.2-2.1,2.4-4.3,2.4 c-2.5,0-3.6-1.3-4.3-2.7l11.8-4.9l-0.6-1.4C105.6,12.1,102.9,9.7,99.4,9.7L99.4,9.7z M99.6,13.1c1.6,0,2.8,0.9,3.2,1.9l-7.9,3.3 C94.6,15.7,97,13.1,99.6,13.1L99.6,13.1z\"/><path fill=\"#3CBA54\" d=\"M85.6,26.8h3.9V0.9h-3.9V26.8z\"/></svg>\n            <div class=\"google-reviews-featured__head__logo__text\">\n                Reviews <span class=\"google-reviews-featured__head__logo__text__stars\">★★★★★</span>\n            </div>\n        </div>\n        <div class=\"google-reviews-featured__head__rating\"><div class=\"google-reviews-featured__head__rating__stars\">\n                <div class=\"google-reviews-featured__head__rating__stars__black\">★★★★★</div>\n                <div class=\"google-reviews-featured__head__rating__stars__white\">☆☆☆☆☆</div>\n            </div>\n            <div class=\"google-reviews-featured__head__rating__score\">\n                5/5\n            </div>\n            <div class=\"google-reviews-featured__head__rating__number-of-reviews\">\n                <span>18 Reviews</span>\n            </div>\n        </div>\n    </div>\n        <!-- reviews body -->\n    <div class=\"google-reviews-featured__body\">\n                                                <!-- review carousel -->\n                <div class=\"nearu-carousel multi-component-container multi-component-container--uniform-height\">                    <div  class=\"card card--google-review has-white-background-color has-black-color\">\n        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Jeff Schindler\" aria-label=\"Jeff Schindler\">Jeff Schindler</p>\n            <div class=\"card__content__title__stars\">★★★★★</div>\n                    <div class=\"card__content__description card__description\">\n<p>We&#8217;re on their VIP plan and have been happy with their service every time they come out. Each technician has been knowledgeable, personable, and efficient. I&#8217;ve always trusted their assessment and have never felt we&#8217;re paying for something we don&#8217;t need.</p>\n</div>\n\n                </div></div>\n                            <div  class=\"card card--google-review has-white-background-color has-black-color\">\n        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Eric Lindsay\" aria-label=\"Eric Lindsay\">Eric Lindsay</p>\n            <div class=\"card__content__title__stars\">★★★★★</div>\n                    <div class=\"card__content__description card__description\">\n<p>Great staff and technicians. Was confused on the pricing and they took time to take my call to explain the cost structure. After doing some research, they’re reasonably priced compared to others in the area when in need of a home visit to diagnose an HVAC issue. The technician was easy to work with and helped make sense of things. Would definitely recommend.</p>\n</div>\n\n                </div></div>\n                            <div  class=\"card card--google-review has-white-background-color has-black-color\">\n        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Billy Strickland\" aria-label=\"Billy Strickland\">Billy Strickland</p>\n            <div class=\"card__content__title__stars\">★★★★★</div>\n                    <div class=\"card__content__description card__description\">\n<p>The service technician came to do the fall/winter maintenance on my heat/AC unit. He was very thorough. Did a great job servicing, and cleaning the unit, and the air cleaner unit. Very courteous and friendly. Definitely a professional technician.</p>\n</div>\n\n                </div></div>\n            </div>\n    <!-- ./ review carousel -->\n    <div class=\"nearu-carousel-controls\">\n\t<div class=\"nearu-carousel-button button-prev\">    <div class=\"iconblock\" data-size=\"lg\" data-padding=\"2\" data-display=\"block\">\n        <svg class=\"icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronleft\" /></svg>    </div>\n    </div>\n\t<div class=\"carousel-dots\"><div role=\"button\" aria-label=\"Go to slide 1 of 3\" data-nearu-carousel-dot-index=\"1\" class=\"carousel-dots__dot selected\"></div><div role=\"button\" aria-label=\"Go to slide 2 of 3\" data-nearu-carousel-dot-index=\"2\" class=\"carousel-dots__dot\"></div><div role=\"button\" aria-label=\"Go to slide 3 of 3\" data-nearu-carousel-dot-index=\"3\" class=\"carousel-dots__dot\"></div></div>\n<div class=\"nearu-carousel-button button-next\">    <div class=\"iconblock\" data-size=\"lg\" data-padding=\"2\" data-display=\"block\">\n        <svg class=\"icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronright\" /></svg>    </div>\n    </div>\n</div></div>\n<!-- ./ reviews body -->\n\n</div>\t</div>\n\t</article><!-- #post-1325 -->"

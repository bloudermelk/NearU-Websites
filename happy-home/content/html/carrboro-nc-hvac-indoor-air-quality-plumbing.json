  "html": "<article id=\"post-5561\" class=\"container post-5561 page type-page status-publish has-post-thumbnail hentry\">\n\n\t<div class=\"entry-content | container\">\n\t\t<section  class=\"container section--services-hero pt-5 services-hero\">\n\t<div class=\"section--services-hero__main\">\n\t\t<div class=\"section--services-hero__main__row\">\n\t\t\t<div class=\"section--services-hero__main__row__left\">\n                <div class=\"acf-innerblocks-container\">\n\n<div class=\"wp-block-group full-width-mobile is-vertical is-layout-flex wp-container-core-group-is-layout-2c90304e wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group flow center-content-mobile full-width-mobile has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<div class=\"wp-block-group h-align icon-plus-title is-layout-flex wp-block-group-is-layout-flex\">    <div class=\"iconblock wp-elements-1 has-background has-red-background-color has-text-color has-secondary-inverse-color\" data-size=\"md\" data-padding=\"2\" data-display=\"inline\">\n        <svg class=\"icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-info\" /></svg>    </div>\n\n<h1 class=\"wp-block-heading has-primary-inverse-color has-text-color has-link-color has-x-large-font-size wp-elements-2\">HVAC, Plumbing &amp; Indoor Air Quality Services in Carrboro, NC&nbsp;</h1>\n</div>\n\n<p class=\"wp-block-paragraph\">Happy Home Services handles heating and cooling, plumbing, and indoor air quality for homes across Carrboro, with the price set before work begins and phones staffed 24/7. A 1920s mill house north of downtown needs a different approach than a 2000s&nbsp;build&nbsp;in Claremont or&nbsp;Winmore, and we tailor each visit to the house in front of us.&nbsp;</p>\n\n<p class=\"wp-block-paragraph\">Carrboro&#8217;s restored mill cottages were framed a century before central air existed, and many still run on radiators, window units, or furnaces well past their design life. The newer subdivisions toward the Orange County line carry modern systems with their own maintenance schedules. Serving both on the same day is normal work for our team.&nbsp;</p>\n\n<div class=\"wp-block-group mb-1 full-width-mobile is-content-justification-left is-nowrap is-layout-flex wp-container-core-group-is-layout-a1b15d37 wp-block-group-is-layout-flex\">\n<div  class=\"wp-block-group mb-3 full-width-mobile schedule-and-call-cta is-content-justification-left is-nowrap is-layout-flex wp-container-core-group-is-layout-a1b15d37 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group schedule-cta-container is-vertical is-content-justification-stretch is-layout-flex wp-container-core-group-is-layout-41171c72 wp-block-group-is-layout-flex\">\n<a href=\"/bookings\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta se-widget-button\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-event\" /></svg><span >Schedule Now</span>\n\n</a>\n\n    <p class=\"horizon-text has-secondary-font-family wp-block-paragraph\" style=\"text-transform:uppercase\">or speak with an expert!</p>\n\n<a href=\"tel:+13362819025\" aria-label=\"Call now: +13362819025\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta phone-link\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-phone\" /></svg><span data-show-on=\"desktop\">(336) 281-9025</span>\n        <span data-show-on=\"mobile\">Call Now</span>\n</a>\n\n<p class=\"has-black-color has-text-color has-link-color has-secondary-font-family has-small-font-size text-center wp-elements-3 wp-block-paragraph\" style=\"text-transform:uppercase\"><strong>Same Day Appointments Available by Phone</strong></p>\n</div>\n</div>\n</div>\n\n<div  class=\"badge mb-3\" style='min-height:unset;'>\n    <div class=\"badge__content\">\n        <svg width=\"45\" height=\"45\" viewBox=\"0 0 45 45\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <title>Google</title>\n            <path d=\"M42.0046 22.9145C42.0046 21.4661 41.8746 20.0733 41.6332 18.7363H22.395V26.647H33.3882C32.9054 29.191 31.457 31.3451 29.2844 32.7935V37.9373H35.9137C39.7762 34.372 42.0046 29.1353 42.0046 22.9145Z\" fill=\"#4285F4\"/>\n            <path d=\"M22.396 42.8766C27.9112 42.8766 32.535 41.0568 35.9147 37.9371L29.2854 32.7933C27.4655 34.0189 25.1443 34.7617 22.396 34.7617C17.0851 34.7617 12.5727 31.1777 10.9571 26.3496H4.16064V31.6234C7.52175 38.2899 14.4111 42.8766 22.396 42.8766Z\" fill=\"#34A853\"/>\n            <path d=\"M10.9608 26.3308C10.5523 25.1052 10.3109 23.8053 10.3109 22.4498C10.3109 21.0942 10.5523 19.7943 10.9608 18.5687V13.2949H4.16436C2.77164 16.0432 1.97314 19.1444 1.97314 22.4498C1.97314 25.7551 2.77164 28.8563 4.16436 31.6046L9.45671 27.4821L10.9608 26.3308Z\" fill=\"#FBBC05\"/>\n            <path d=\"M22.396 10.155C25.4043 10.155 28.0783 11.1949 30.2138 13.2004L36.0633 7.35097C32.5165 4.04557 27.9112 2.02148 22.396 2.02148C14.4111 2.02148 7.52175 6.60818 4.16064 13.2933L10.9571 18.567C12.5727 13.7389 17.0851 10.155 22.396 10.155Z\" fill=\"#EA4335\"/>\n        </svg>\n        <div class=\"badge__content__rating-container\">\n            <p class=\"h6 badge__content__rating-container__title\">Google Rating</p>\n            <div class=\"badge__content__rating-container__stars\">\n                <div class=\"badge__content__rating-container__stars__number\">\n                    5                </div>\n                <div class=\"badge__content__rating-container__stars__container\">\n                    <div class=\"badge__content__rating-container__stars__container__black\">★★★★★</div>\n                    <div aria-hidden=\"true\" class=\"badge__content__rating-container__stars__container__white\">☆☆☆☆☆</div>\n                </div>\n            </div>\n                    </div>\n    </div>\n    </div></div>\n</div>\n\n</div>\n\t\t\t</div><!-- ./left -->\n\t\t\t<div class=\"section--services-hero__main__row__right\">\n\t\t\t<div class=\"elevated content-fullbleed-mobile box-shadow-lg border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\t\t\t<figure class=\"wp-block-post-featured-image\"><img decoding=\"async\" width=\"2560\" height=\"1707\" src=\"/images/2024/10/NU-HappyHome_Group-Shot-10-scaled.jpg\" class=\"attachment-post-thumbnail size-post-thumbnail wp-post-image\" alt=\"Happy Home team dedicated to providing top quality HVAC, Plumbing, and Indoor Air Quality all across Raleigh-Durham\" style=\"object-fit:cover;\" srcset=\"/images/2024/10/NU-HappyHome_Group-Shot-10-scaled.jpg 2560w, /images/2024/10/NU-HappyHome_Group-Shot-10-300x200.jpg 300w, /images/2024/10/NU-HappyHome_Group-Shot-10-1024x683.jpg 1024w, /images/2024/10/NU-HappyHome_Group-Shot-10-768x512.jpg 768w, /images/2024/10/NU-HappyHome_Group-Shot-10-1536x1024.jpg 1536w, /images/2024/10/NU-HappyHome_Group-Shot-10-2048x1365.jpg 2048w\" sizes=\"(max-width: 1010px) 100vw, (max-width: 1440px) 50vw, 768px\" /></figure>\n\t\t\t</div>\n</div>\t\t\t</div><!-- ./right -->\n\t\t</div><!-- ./row -->\n\n</div>\n\t<div class=\"section--services-hero__main section--services-hero__main--empty has-background has-secondary-background-color\">\n\t</div><!-- ./row -->\n\n</section>\n\n<div class=\"wp-block-group container flow pb-4 has-secondary-inverse-color has-primary-background-color has-text-color has-background\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--60)\">\n<div class=\"wp-block-group wrap-mobile flow pb-4 has-primary-inverse-color has-text-color has-link-color wp-elements-4 is-horizontal is-nowrap is-layout-flex wp-container-core-group-is-layout-cdbf0242 wp-block-group-is-layout-flex\" style=\"margin-top:0;margin-bottom:0;padding-top:0;padding-bottom:0\">\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-db3ccc14 wp-block-columns-is-layout-flex\" style=\"margin-top:0;margin-bottom:0;padding-top:0;padding-bottom:0\">\n<div class=\"wp-block-column flow is-layout-flow wp-block-column-is-layout-flow\">\n<div class=\"wp-block-group has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">Heating and Cooling for a Century of Homes&nbsp;</h2>\n\n<p class=\"wp-block-paragraph\">Piedmont weather asks a lot from equipment in Carrboro: months of humid heat, then a winter that swings between mild weeks and ice storms. Older homes here heat with a wider mix than most towns, including oil in some of the earliest houses.&nbsp;</p>\n\n<p class=\"wp-block-paragraph\"><a href=\"/services/cooling/air-conditioning\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Air Conditioning Services in Carrboro</strong></a>&nbsp;We install, replace, repair, and tune up systems from every major brand, and we give a straight repair-or-replace assessment when an aging unit falters.&nbsp;</p>\n\n<p class=\"wp-block-paragraph\"><a href=\"/services/heating/oil-furnaces\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Oil and Gas Furnace Services</strong></a>&nbsp;Oil furnaces still heat some of Carrboro&#8217;s oldest&nbsp;homes,&nbsp;gas serves many established streets, and heat pumps carry the newer builds. We&nbsp;maintain&nbsp;all three, and a&nbsp;<a href=\"/services/cooling/dual-fuel-hybrid-systems\" target=\"_blank\" rel=\"noreferrer noopener\">dual-fuel hybrid system</a>&nbsp;blends electric and gas heat for efficiency through variable winters.&nbsp;</p>\n\n<p class=\"wp-block-paragraph\"><a href=\"/services/cooling/mini-split\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Ductless Mini-Split Systems</strong></a>&nbsp;Mill houses near the historic district were never built for ductwork. Mini-splits condition those rooms individually without disturbing original walls, which is why they are our most-installed solution in old Carrboro.&nbsp;</p>\n</div>\n\n<div class=\"wp-block-group has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">Indoor Air Quality in the Heart of Pollen Country&nbsp;</h2>\n\n<p class=\"wp-block-paragraph\">A Carrboro spring coats the town in pine pollen, and the summer that follows keeps indoor humidity high. Both problems have mechanical solutions.&nbsp;</p>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"/services/dehumidifiers\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Whole-Home Dehumidifiers</strong></a>: Holding indoor humidity in range protects plaster and wood in older homes and cuts mold risk everywhere.&nbsp;</li>\n</ul>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"/services/indoor-air-quality/air-ducts\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Air Duct Cleaning and Sealing</strong></a>: Where ductwork exists in older Carrboro homes, it often leaks and carries decades of dust. Cleaning and sealing fixes both.&nbsp;</li>\n</ul>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"/services/indoor-air-quality/air-purifiers\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Air Filtration and Purification</strong></a>: High-efficiency filtration reduces the pollen and particle load indoors during the worst weeks of the season.&nbsp;</li>\n</ul>\n</div>\n</div>\n\n<div class=\"wp-block-column flow is-layout-flow wp-block-column-is-layout-flow\">\n<div class=\"wp-block-group has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">Plumbing From Mill Houses to New Builds&nbsp;</h2>\n\n<p class=\"wp-block-paragraph\">Most of&nbsp;Carrboro is served by OWASA, the Orange Water and Sewer Authority, drawing from University Lake, Cane Creek, and the Quarry Reservoir. That water is genuinely soft, around two grains per gallon, so a water softener rarely earns its keep here.&nbsp;The plumbing work Carrboro&nbsp;actually needs&nbsp;concentrates in pipe age and fixtures.&nbsp;</p>\n\n<p class=\"wp-block-paragraph\"><a href=\"/services/plumbing/repiping-services\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Repiping&nbsp;and Pipe Repair</strong></a>&nbsp;Galvanized and cast-iron plumbing hides inside many mill-era walls, corroding slowly until pressure drops and water discolors.&nbsp;Repiping&nbsp;during a renovation settles the issue for good.&nbsp;</p>\n\n<p class=\"wp-block-paragraph\"><a href=\"/services/plumbing/water-heater-installation-replacements\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Water Heater Installation and Replacement</strong></a>&nbsp;Tank or tankless, we size the unit to the household and the fuel available, then install it cleanly.&nbsp;</p>\n\n<p class=\"wp-block-paragraph\"><a href=\"/services/plumbing/frozen-burst-pipe-repair\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Frozen and Burst Pipe Repair</strong></a>&nbsp;Under-insulated lines in older crawl spaces go first when a freeze hits the Triangle. We respond quickly to stop the water and repair the break.&nbsp;</p>\n\n<p class=\"wp-block-paragraph\"><a href=\"/services/plumbing/kitchen-bathroom\" target=\"_blank\" rel=\"noreferrer noopener\"><strong>Kitchen and Bathroom Plumbing</strong></a>&nbsp;Faucets, disposals, toilets, and fixtures, whether the project is a bungalow renovation or a punch list in a newer build. Homes on the town&#8217;s outskirts with private wells can also call us for&nbsp;<a href=\"/services/plumbing/well-pump\" target=\"_blank\" rel=\"noreferrer noopener\">well pump service</a>&nbsp;and&nbsp;<a href=\"/services/plumbing/water-treatment-filtration\" target=\"_blank\" rel=\"noreferrer noopener\">water treatment</a>.&nbsp;</p>\n</div>\n</div>\n</div>\n</div>\n</div>\n\n<div class=\"wp-block-group has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<h2 class=\"wp-block-heading\">The Happy Home Approach in Carrboro&nbsp;</h2>\n\n<p class=\"wp-block-paragraph\">Our trained technicians diagnose first, quote second, and start work only after you approve the price. Difficult problems in difficult houses are our specialty, and honest, upfront pricing with a 100% money-back guarantee stands behind the work. Call, chat, or book online to schedule service anywhere in Carrboro.&nbsp;</p>\n</div>\n\n<div  class=\"accordion\" style=\"--_accordion-separator-color: #076395\">\n            <details class=\"accordion-item\" data-custom-open=\"true\" open>\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Does a Carrboro home need a water softener? </p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p>Usually not. OWASA water runs about two grains per gallon, which counts as soft, so softening adds little here. Filtration for taste, or treatment for an outlying private well, is the more common upgrade.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">How quickly can you get to a Carrboro home after hours? </p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p>We answer 24/7 and dispatch based on urgency, so an active leak or a dead heating system in January moves to the front of the line. </p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Can a mill house get central air without losing its original walls? </p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p>Yes. Ductless mini-splits deliver heating and cooling room by room through small wall-mounted units connected to an outdoor compressor, with no duct runs cut through historic framing.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">How should I get a Carrboro home ready for the humid season? </p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p>Schedule a spring AC tune-up, then consider duct sealing and a whole-home dehumidifier. Together they control moisture, cut allergens during pollen season, and reduce the summer load on the cooling system.</p>\n                </div>\n            </div>\n        </details>            <details class=\"accordion-item\">\n            <summary class=\"accordion-title | paired-icon-text\">\n                <svg class=\"icon accordion-icon accordion-icon--closed | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevrondown\" /></svg>                <svg class=\"icon accordion-icon accordion-icon--open | paired-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronup\" /></svg>                <p class=\"paired-text\">Beyond Carrboro, where else do you work? </p>\n            </summary>\n\n            <div class=\"accordion-content\">\n                <div class=\"accordion-content-inner\">\n                    <p>Chapel Hill, White Cross, and Hillsborough are all in our coverage area. See the Service Areas menu for every town we serve.</p>\n                </div>\n            </div>\n        </details>    </div>\n\n<div class=\"wp-block-group container flow py-5\">\n<h2 class=\"wp-block-heading\">Powered by NearU — We’re here to make your HVAC Service experience the best one yet!</h2>\n\n<figure class=\"wp-block-image size-full is-resized\"><img decoding=\"async\" width=\"430\" height=\"98\" src=\"/images/2024/02/NearU.png\" alt=\"NearU\" class=\"wp-image-36\" style=\"width:220px;height:auto\" srcset=\"/images/2024/02/NearU.png 430w, /images/2024/02/NearU-300x68.png 300w\" sizes=\"(max-width: 430px) 100vw, 430px\" /></figure>\n\n<p class=\"wp-block-paragraph\">NearU is setting up a new standard of HVAC, plumbing, drains, IAQ, and generator services with major improvements to reliability, convenience, and customer care. We equip our companies with better resources, training, and tools, so they can provide you with the best possible service outcome. If you’ve recently learned that your go-to HVAC, plumbing, drains, IAQ, and generator company has joined NearU, then this is something to get excited about! We protect the people and culture that make each company great, while ensuring their customers consistently receive the best possible care.</p>\n</div>\n\t</div>\n\t</article><!-- #post-5561 -->"
}
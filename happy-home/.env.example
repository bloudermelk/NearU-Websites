# Shared across every NearU brand site (same Supabase project). Set these in
# each Vercel project (or once as team-level shared env vars).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   # server-side only, never exposed to the browser

# Shared secret for POST /api/revalidate?secret=...&path=/some-page
REVALIDATE_SECRET=change-me

# Do NOT set SITE_SLUG here or on Vercel: this site's identity (happy-home) is
# fixed by next.config.ts and cannot be overridden - by design, so one brand
# folder can never build another brand's content.

  "html": "<article id=\"post-5759\" class=\"container post-5759 page type-page status-publish has-post-thumbnail hentry type-of-service-financing\">\n\n\t<div class=\"entry-content | container\">\n\t\t<section  class=\"container section--services-hero pt-5 services-hero\">\n\t<div class=\"section--services-hero__main\">\n\t\t<div class=\"section--services-hero__main__row\">\n\t\t\t<div class=\"section--services-hero__main__row__left\">\n                <div class=\"acf-innerblocks-container\">\n\n<div class=\"wp-block-group full-width-mobile is-vertical is-layout-flex wp-container-core-group-is-layout-2c90304e wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group is-nowrap is-layout-flex wp-container-core-group-is-layout-7387b849 wp-block-group-is-layout-flex\">\n<figure class=\"wp-block-image size-full is-resized\"><img title=\"About Us - Russell’s American Mechanical\" decoding=\"async\" src=\"/images/2024/07/Wells-Fargo-Logo.png\" alt=\"Wells Fargo logo\" class=\"wp-image-5130\" style=\"aspect-ratio:1;width:134px;height:auto\"/></figure>\n\n<figure class=\"wp-block-image size-full is-resized\"><img title=\"Furnaces - Russell’s American Mechanical\" decoding=\"async\" src=\"/images/2024/06/Synchrony-Bank-logo.png\" alt=\"Synchrony Bank logo\" class=\"wp-image-5131\" style=\"width:auto;height:55px\"/></figure>\n</div>\n\n<div class=\"wp-block-group h-align is-nowrap is-layout-flex wp-container-core-group-is-layout-7387b849 wp-block-group-is-layout-flex\">    <div class=\"iconblock wp-elements-1 has-background has-secondary-background-color has-text-color has-primary-inverse-color\" data-size=\"sm\" data-padding=\"2\" data-display=\"inline\">\n        <svg class=\"icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-money\" /></svg>    </div>\n\n<h1 class=\"wp-block-heading has-x-large-font-size\">Financing Options</h1>\n</div>\n\n<p class=\"wp-block-paragraph\">*Subject to credit approval. Ask us for details. </p>\n\n<div class=\"wp-block-group my-3 is-layout-flex wp-block-group-is-layout-flex\">\n<p class=\"wp-block-paragraph\">At Russell&#8217;s American Mechanical, we understand that home comfort is essential, which is why we proudly offer financing options through Wells Fargo and Synchrony Bank. These trusted partners provide flexible plans to suit your budget, so you can enjoy the comfort of a well-functioning home today.</p>\n</div>\n\n<div class=\"wp-block-group mb-3 is-content-justification-left is-nowrap is-layout-flex wp-container-core-group-is-layout-a1b15d37 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group full-width-mobile is-vertical is-content-justification-stretch is-layout-flex wp-container-core-group-is-layout-41171c72 wp-block-group-is-layout-flex\">\n<p class=\"horizon-text full-width-mobile has-secondary-font-family wp-block-paragraph\" style=\"text-transform:uppercase\">Speak with an expert</p>\n\n<a href=\"tel:+17575254911\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"icon\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta full-width-mobile\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-phone\" /></svg><span>(757) 525-4911</span>\n</a>\n\n<p class=\"text-center has-primary-color has-text-color has-link-color has-secondary-font-family has-small-font-size wp-elements-2 wp-block-paragraph\" style=\"text-transform:uppercase\"><strong>Same-day appointments available by phone</strong></p>\n</div>\n</div>\n</div>\n\n</div>\n\t\t\t</div><!-- ./left -->\n\t\t\t<div class=\"section--services-hero__main__row__right\">\n\t\t\t<div class=\"elevated content-fullbleed-mobile box-shadow-lg border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\t\t\t<figure class=\"wp-block-post-featured-image\"><img decoding=\"async\" width=\"1917\" height=\"1280\" src=\"/images/2024/06/A-Russells-American-Mechanical-technician-talking-with-a-customer.jpg\" class=\"attachment-post-thumbnail size-post-thumbnail wp-post-image\" alt=\"A Russell’s American Mechanical technician talking with a customer\" style=\"object-fit:cover;\" srcset=\"/images/2024/06/A-Russells-American-Mechanical-technician-talking-with-a-customer.jpg 1917w, /images/2024/06/A-Russells-American-Mechanical-technician-talking-with-a-customer-300x200.jpg 300w, /images/2024/06/A-Russells-American-Mechanical-technician-talking-with-a-customer-1024x684.jpg 1024w, /images/2024/06/A-Russells-American-Mechanical-technician-talking-with-a-customer-768x513.jpg 768w, /images/2024/06/A-Russells-American-Mechanical-technician-talking-with-a-customer-1536x1026.jpg 1536w\" sizes=\"(max-width: 1010px) 100vw, (max-width: 1440px) 50vw, 768px\" title=\"A Russell’s American Mechanical technician talking with a customer - Russell’s American Mechanical\" /></figure>\n\t\t\t</div>\n</div>\t\t\t</div><!-- ./right -->\n\t\t</div><!-- ./row -->\n\n</div>\n\t<div class=\"section--services-hero__main section--services-hero__main--empty has-background has-secondary-background-color\">\n\t</div><!-- ./row -->\n\n</section>\n\n<div class=\"wp-block-group container pb-5 flow has-primary-inverse-color has-secondary-background-color has-text-color has-background has-link-color wp-elements-3\">\n<div style=\"height:1rem\" aria-hidden=\"true\" class=\"wp-block-spacer d-block d-md-none\"></div>\n\n<h2 class=\"wp-block-heading\">Available Plans for Heating, Cooling, and Indoor Air Quality Services</h2>\n\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-7387b849 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-vertically-aligned-stretch is-layout-flow wp-block-column-is-layout-flow\"><div  class=\"card card--page has-white-background-color has-black-color\">\n<a href=\"/financing/heating-services-financing-options\" target=\"_blank\" aria-label=\"\" class=\"link stretch-link\"></a>        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Heating Finance Options\" aria-label=\"Heating Finance Options\">Heating Finance Options</p>\n\n                    <div class=\"card__content__description card__description\"><p>At Russell&#8217;s American Mechanical, we know investing in a new heating system is a big decision. That’s why we offer <strong>flexible financing options</strong> through Wells Fargo and Synchrony Bank to make the process easy and affordable. Whether you’re upgrading to an energy-efficient system or replacing an outdated unit, our plans help you stay warm and comfortable. Contact us to learn more about these financing solutions.</p>\n</div>\n\n            <div class=\"card__content__cta\">\n<a href=\"/financing/heating-services-financing-options\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-heating\" /></svg><span >Heating Finance Options</span>\n\n</a></div>    </div></div>\n</div>\n\n<div class=\"wp-block-column is-vertically-aligned-stretch is-layout-flow wp-block-column-is-layout-flow\"><div  class=\"card card--page has-white-background-color has-black-color\">\n<a href=\"/financing/cooling-services-financing-options\" target=\"_blank\" aria-label=\"\" class=\"link stretch-link\"></a>        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Cooling Finance Options\" aria-label=\"Cooling Finance Options\">Cooling Finance Options</p>\n\n                    <div class=\"card__content__description card__description\"><p>We make upgrading or installing a cooling system stress-free with <strong>financing options</strong> through Synchrony Bank and Wells Fargo. Whether you need a new air conditioner, heat pump, or hybrid system, our plans are designed to fit your budget. Contact Russell&#8217;s American Mechanical to learn more.</p>\n</div>\n\n            <div class=\"card__content__cta\">\n<a href=\"/financing/cooling-services-financing-options\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-cooling\" /></svg><span >Cooling Finance Options</span>\n\n</a></div>    </div></div>\n</div>\n\n<div class=\"wp-block-column is-vertically-aligned-stretch is-layout-flow wp-block-column-is-layout-flow\"><div  class=\"card card--page has-white-background-color has-black-color\">\n<a href=\"/financing/indoor-air-quality-services-financing-options\" target=\"_blank\" aria-label=\"\" class=\"link stretch-link\"></a>        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Indoor Air Quality Finance Options\" aria-label=\"Indoor Air Quality Finance Options\">Indoor Air Quality Finance Options</p>\n\n                    <div class=\"card__content__description card__description\"><p>Your health matters to us. Russell&#8217;s American Mechanical offers <strong>financing options</strong> through Wells Fargo and Synchrony Bank for indoor air quality systems. Whether you need a whole-home purifier, humidifier, or dehumidifier, we make it affordable to breathe cleaner, healthier air. Contact us today.</p>\n</div>\n\n            <div class=\"card__content__cta\">\n<a href=\"/financing/indoor-air-quality-services-financing-options\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-indoor-air-quality\" /></svg><span >Indoor Air Quality Finance Options</span>\n\n</a></div>    </div></div>\n</div>\n</div>\n</div>\n\n        <div  class=\"google-reviews-featured container container py-5 has-background has-gray-light-background-color\">\n    <div class=\"google-reviews-featured__head\">\n        <div class=\"google-reviews-featured__head__logo\">            <svg version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\" viewBox=\"0 0 107.3 35.2\" style=\"enable-background:new 0 0 107.3 35.2;\" xml:space=\"preserve\"><title>Google</title><path fill=\"#4885ED\" d=\"M26.4,12.4H13.9v3.7h8.9c-0.4,5.2-4.8,7.4-8.9,7.4c-5.4,0-9.8-4.3-9.8-9.7c0-0.1,0-0.1,0-0.2 c0-5.6,4.4-10,9.8-10c4.2,0,6.7,2.7,6.7,2.7l2.6-2.7c0,0-3.3-3.7-9.4-3.7C6,0,0,6.5,0,13.6c0,6.9,5.6,13.7,14,13.7 c7.3,0,12.7-5,12.7-12.4C26.6,13.3,26.4,12.4,26.4,12.4L26.4,12.4z\"/><g><path id=\"A\" fill=\"#DB3236\" d=\"M36.6,9.7c-5.1,0-8.8,4-8.8,8.7c0,4.8,3.6,8.8,8.9,8.8c4.8,0,8.7-3.7,8.7-8.7 C45.4,12.7,40.9,9.7,36.6,9.7L36.6,9.7z M36.7,13.2c2.5,0,4.9,2,4.9,5.3c0,3.2-2.4,5.3-4.9,5.3c-2.8,0-5-2.2-5-5.3 C31.7,15.4,33.9,13.2,36.7,13.2L36.7,13.2z\"/></g><g><path id=\"A_00000019641008515513977120000006682861592563020936_\" fill=\"#F4C20D\" d=\"M55.8,9.7c-5.1,0-8.8,4-8.8,8.7 c0,4.8,3.6,8.8,8.9,8.8c4.8,0,8.7-3.7,8.7-8.7C64.6,12.7,60,9.7,55.8,9.7L55.8,9.7z M55.9,13.2c2.5,0,4.9,2,4.9,5.3 c0,3.2-2.4,5.3-4.9,5.3c-2.8,0-5-2.2-5-5.3C50.9,15.4,53,13.2,55.9,13.2L55.9,13.2z\"/></g><path fill=\"#4885ED\" d=\"M74.6,9.7c-4.7,0-8.4,4.1-8.4,8.8c0,5.3,4.3,8.8,8.3,8.8c2.5,0,3.8-1,4.8-2.1v1.7c0,3-1.8,4.8-4.6,4.8 c-2.7,0-4-2-4.5-3.1L66.9,30c1.2,2.5,3.6,5.2,7.9,5.2c4.7,0,8.3-3,8.3-9.1V10.3h-3.7v1.5C78.2,10.5,76.7,9.7,74.6,9.7L74.6,9.7z M75,13.2c2.3,0,4.7,2,4.7,5.3c0,3.4-2.4,5.3-4.7,5.3c-2.5,0-4.9-2-4.9-5.3C70.1,15.2,72.5,13.2,75,13.2L75,13.2z\"/><path fill=\"#DB3236\" d=\"M99.4,9.7c-4.4,0-8.2,3.5-8.2,8.8c0,5.5,4.2,8.8,8.6,8.8c3.7,0,6-2,7.4-3.8l-3-2c-0.8,1.2-2.1,2.4-4.3,2.4 c-2.5,0-3.6-1.3-4.3-2.7l11.8-4.9l-0.6-1.4C105.6,12.1,102.9,9.7,99.4,9.7L99.4,9.7z M99.6,13.1c1.6,0,2.8,0.9,3.2,1.9l-7.9,3.3 C94.6,15.7,97,13.1,99.6,13.1L99.6,13.1z\"/><path fill=\"#3CBA54\" d=\"M85.6,26.8h3.9V0.9h-3.9V26.8z\"/></svg>\n            <div class=\"google-reviews-featured__head__logo__text\">\n                Reviews <span class=\"google-reviews-featured__head__logo__text__stars\">★★★★★</span>\n            </div>\n        </div>\n        <div class=\"google-reviews-featured__head__rating\"><div class=\"google-reviews-featured__head__rating__stars\">\n                <div class=\"google-reviews-featured__head__rating__stars__black\">★★★★★</div>\n                <div class=\"google-reviews-featured__head__rating__stars__white\">☆☆☆☆☆</div>\n            </div>\n            <div class=\"google-reviews-featured__head__rating__score\">\n                5/5\n            </div>\n            <div class=\"google-reviews-featured__head__rating__number-of-reviews\">\n                <span>18 Reviews</span>\n            </div>\n        </div>\n    </div>\n        <!-- reviews body -->\n    <div class=\"google-reviews-featured__body\">\n                                                <!-- review carousel -->\n                <div class=\"nearu-carousel multi-component-container multi-component-container--uniform-height\">                    <div  class=\"card card--google-review has-white-background-color has-black-color\">\n        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"John Sutphln\" aria-label=\"John Sutphln\">John Sutphln</p>\n            <div class=\"card__content__title__stars\">★★★★★</div>\n                    <div class=\"card__content__description card__description\">\n<p>They did a great job and cleaned up after themselves! Great company. They were very responsive when I called to get an estimate for plumbing repair. Very please with the company. Came back to fix the plumbing and everything seems to be working well!</p>\n</div>\n\n                </div></div>\n                            <div  class=\"card card--google-review has-white-background-color has-black-color\">\n        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Janene Harris\" aria-label=\"Janene Harris\">Janene Harris</p>\n            <div class=\"card__content__title__stars\">★★★★★</div>\n                    <div class=\"card__content__description card__description\">\n<p>We&#8217;ve been dealing with a leak for a few years, had different companies come out and no one could properly find or fix the issue. Russell’s-American Mechanical came out and found and fixed the problem in no time. The technician was honest, considerate and informed us on other things as well. Will definitely continue with Russell’s-American Mechanical for all future projects.</p>\n</div>\n\n                </div></div>\n                            <div  class=\"card card--google-review has-white-background-color has-black-color\">\n        <div class=\"card__content\">\n                    <p class=\"card__content__title card__title h3\" title=\"Jackie\" aria-label=\"Jackie\">Jackie</p>\n            <div class=\"card__content__title__stars\">★★★★★</div>\n                    <div class=\"card__content__description card__description\">\n<p>This is a fantastic company. They did excellent work replacing one of our units. The staff is friendly, respectful, knowledgeable, hard-working, and they really went above and beyond to take care of our unit replacement. I would highly recommend this company.</p>\n</div>\n\n                </div></div>\n            </div>\n    <!-- ./ review carousel -->\n    <div class=\"nearu-carousel-controls\">\n\t<div class=\"nearu-carousel-button button-prev\">    <div class=\"iconblock\" data-size=\"lg\" data-padding=\"2\" data-display=\"block\">\n        <svg class=\"icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronleft\" /></svg>    </div>\n    </div>\n\t<div class=\"carousel-dots\"><div role=\"button\" aria-label=\"Go to slide 1 of 3\" data-nearu-carousel-dot-index=\"1\" class=\"carousel-dots__dot selected\"></div><div role=\"button\" aria-label=\"Go to slide 2 of 3\" data-nearu-carousel-dot-index=\"2\" class=\"carousel-dots__dot\"></div><div role=\"button\" aria-label=\"Go to slide 3 of 3\" data-nearu-carousel-dot-index=\"3\" class=\"carousel-dots__dot\"></div></div>\n<div class=\"nearu-carousel-button button-next\">    <div class=\"iconblock\" data-size=\"lg\" data-padding=\"2\" data-display=\"block\">\n        <svg class=\"icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-chevronright\" /></svg>    </div>\n    </div>\n</div></div>\n<!-- ./ reviews body -->\n\n</div>\t</div>\n\t</article><!-- #post-5759 -->"

  "html": "<article id=\"post-6816\" class=\"container post-6816 page type-page status-publish has-post-thumbnail hentry\">\n\n\t<div class=\"entry-content | container\">\n\t\t<section  class=\"container section--services-hero pt-5 services-hero\">\n\t<div class=\"section--services-hero__main\">\n\t\t<div class=\"section--services-hero__main__row\">\n\t\t\t<div class=\"section--services-hero__main__row__left\">\n                <div class=\"acf-innerblocks-container\">\n\n<div class=\"wp-block-group flow has-global-padding is-layout-constrained wp-block-group-is-layout-constrained\">\n<div class=\"wp-block-group h-align is-layout-flex wp-block-group-is-layout-flex\">\n<h1 class=\"wp-block-heading has-secondary-color has-text-color has-link-color has-x-large-font-size wp-elements-1\">Sign up for a maintenance agreement and get $1000 off a future new system installation!*</h1>\n</div>\n\n<div class=\"wp-block-group is-layout-flex wp-block-group-is-layout-flex\">\n<p class=\"wp-block-paragraph\">As summer wraps up, Russell&#8217;s American Mechanical has an unbeatable offer to keep your system running smoothly all year and keep money in your pocket when the time comes for a new heating and cooling system.</p>\n\n<p class=\"wp-block-paragraph\">This limited-time deal ensures your HVAC system stays in top condition year-round while providing your future self with big savings!</p>\n\n<p class=\"wp-block-paragraph\"><em>*No cash value. Does not apply to any maintenance plan that renews or is eligible for renewal between August 1, 2024 and September 15, 2024 (the “Promotional Period”). Does not apply if the maintenance plan purchased during the Promotional Period expires, lapses, or is not renewed at any time prior to the installation of the new heating and cooling system. The $1,000 off may not be used prior to November 1, 2024, and may only be applied towards the installation of 2 stage and above systems and that replaces the heating and cooling system covered by the maintenance plan. Cannot be combined with any other offers. Offer does not apply to commercial agreements.</em></p>\n</div>\n\n<div class=\"wp-block-group mb-3 is-content-justification-left is-nowrap is-layout-flex wp-container-core-group-is-layout-a1b15d37 wp-block-group-is-layout-flex\">\n<div class=\"wp-block-group full-width-mobile is-vertical is-content-justification-stretch is-layout-flex wp-container-core-group-is-layout-41171c72 wp-block-group-is-layout-flex\">\n<p class=\"horizon-text has-secondary-font-family wp-block-paragraph\" style=\"text-transform:uppercase\">Speak with an expert</p>\n\n<a href=\"tel:+17575254911\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"icon\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-phone\" /></svg><span>(757) 525-4911</span>\n</a>\n\n<p class=\"text-center has-primary-color has-text-color has-link-color has-secondary-font-family has-small-font-size wp-elements-2 wp-block-paragraph\" style=\"text-transform:uppercase\"><strong>Same day appointments available by phone</strong></p>\n\n<a href=\"/maintenance\" data-cta-gap=\"md\" data-cta-type=\"solid\" data-cta-content=\"mixed\" data-cta-level=\"primary\" data-cta-minwidth=\"true\" class=\"cta\">\n    <svg class=\"icon cta-icon\" width=\"16\" height=\"16\" aria-hidden=\"true\"><use xlink:href=\"#icon-tools\" /></svg><span >Learn About Our Maintenance Plans</span>\n\n</a></div>\n</div>\n</div>\n\n</div>\n\t\t\t</div><!-- ./left -->\n\t\t\t<div class=\"section--services-hero__main__row__right\">\n\t\t\t<div class=\"elevated content-fullbleed-mobile box-shadow-lg border-radius-lg\" >\n    <div class=\"acf-innerblocks-container\">\n\t\t\t<figure class=\"wp-block-post-featured-image\"><img decoding=\"async\" width=\"907\" height=\"1218\" src=\"/images/2024/07/Russells-AM_August-Promo_Header-Img-Web.jpg\" class=\"attachment-post-thumbnail size-post-thumbnail wp-post-image\" alt=\"Sign up for a maintenance agreement and get $1000 off a future new system installation!*\" style=\"object-fit:cover;\" srcset=\"/images/2024/07/Russells-AM_August-Promo_Header-Img-Web.jpg 907w, /images/2024/07/Russells-AM_August-Promo_Header-Img-Web-223x300.jpg 223w, /images/2024/07/Russells-AM_August-Promo_Header-Img-Web-763x1024.jpg 763w, /images/2024/07/Russells-AM_August-Promo_Header-Img-Web-768x1031.jpg 768w\" sizes=\"(max-width: 1010px) 100vw, (max-width: 1440px) 50vw, 768px\" title=\"Russells-AM_August-Promo_Header-Img-Web - Russell’s American Mechanical\" /></figure>\n\t\t\t</div>\n</div>\t\t\t</div><!-- ./right -->\n\t\t</div><!-- ./row -->\n\n</div>\n\t<div class=\"section--services-hero__main section--services-hero__main--empty has-background has-primary-background-color\">\n\t</div><!-- ./row -->\n\n</section>\n\t</div>\n\t</article><!-- #post-6816 -->"
